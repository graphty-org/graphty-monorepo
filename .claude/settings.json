{
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Read(**/.env.bak)",
            "Read(**/.env.bak.*)",
            "Read(**/.env.backup)",
            "Read(**/.env.backup.*)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/id_rsa*)",
            "Read(**/id_ed25519*)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "matcher": "startup",
                "hooks": [
                    {
                        "type": "command",
                        "command": "f=\"$HOME/.githerd/graphty-monorepo/current/bin/githerd-hook.mjs\"; [ -f \"$f\" ] || exit 0; exec node \"$f\" SessionStart",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}
