{
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Read(**/.env.bak)",
            "Read(**/.env.bak.*)",
            "Read(**/.env.backup)",
            "Read(**/.env.backup.*)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/id_rsa*)",
            "Read(**/id_ed25519*)"
        ]
    }
}
