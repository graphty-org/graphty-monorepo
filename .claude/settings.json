{
    "env": {
        "GIT_CONFIG_GLOBAL": "/home/apowers/.config/git-agent/config",
        "GH_CONFIG_DIR": "/home/apowers/.config/gh-agent",
        "GIT_CONFIG_COUNT": "0",
        "SSH_AUTH_SOCK": ""
    },
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/.env.development)",
            "Read(**/.env.production)",
            "Read(**/.env.test)",
            "Read(**/.env.bak)",
            "Read(**/.env.bak.*)",
            "Read(**/.env.backup)",
            "Read(**/.env.backup.*)",
            "Read(**/*.pem)",
            "Read(**/*.key)",
            "Read(**/id_rsa*)",
            "Read(**/id_ed25519*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-no-foreground-wait.mjs\"",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|mcp__servherd__servherd_start",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-owner-credential-guard.mjs\"",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/tools/claude-area-rules.mjs\""
                    }
                ]
            }
        ]
    }
}
