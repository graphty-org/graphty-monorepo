# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# =============================================================================
# HTTPS Configuration (REQUIRED for WebXR and clipboard functionality)
# =============================================================================
# SSL certificates are required for HTTPS. Generate self-signed certs with:
#   openssl req -x509 -newkey rsa:4096 -keyout server.key -out server.crt -days 365 -nodes
# Used by both Vite dev server and Storybook
HTTPS_CERT_PATH=/path/to/server.crt
HTTPS_KEY_PATH=/path/to/server.key

# =============================================================================
# Server Configuration
# =============================================================================
# Shared by Vite dev server and Storybook
HOST=localhost
PORT=5173

# Unified documentation server port (npm run docs:watch)
DOCS_PORT=9080

# Remote logging server (optional, for XR debugging)
VITE_REMOTE_LOG_URL=https://localhost:9077/log

# =============================================================================
# AI Provider API Keys
# =============================================================================
# For browser testing (Vite dev server) - prefixed with VITE_
VITE_OPENAI_API_KEY=sk-...
VITE_ANTHROPIC_API_KEY=sk-ant-...
VITE_GOOGLE_API_KEY=AIza...

# For Node.js testing (vitest)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# =============================================================================
# Chromatic visual regression
# =============================================================================
# One project token per package that has its own Storybook. These are the SAME
# names as the repository secrets CI reads (.github/workflows/ci.yml, the five
# chromatic-* jobs), so a value here and the secret of the same name are
# interchangeable. Without them `./tools/chromatic.sh <package>` cannot run, and
# visual regressions go uncaught until a push reaches CI.
#
# Get each token from https://www.chromatic.com -> the project -> Manage ->
# Configure -> Project token.
CHROMATIC_PROJECT_TOKEN_ELEMENT=chpt_...
CHROMATIC_PROJECT_TOKEN_APP=chpt_...
CHROMATIC_PROJECT_TOKEN_COMPACT_MANTINE=chpt_...
CHROMATIC_PROJECT_TOKEN_ALGORITHMS=chpt_...
CHROMATIC_PROJECT_TOKEN_LAYOUT=chpt_...

# A personal Chromatic LOGIN, not a project token: the value of the x-chromatic-session-id cookie
# of a browser logged in to https://www.chromatic.com (DevTools -> Application -> Cookies; it is
# HttpOnly, so the console cannot read it). The project tokens above can read a build's totals but
# not which stories changed; tools/chromatic-capture.mjs uses this session to list them and fetch
# their baseline, head and diff images. It only reads. Treat it like a password: it acts as you,
# and it expires when you log out.
CHROMATIC_SESSION_COOKIE=

# =============================================================================
# SonarQube (the pre-push gate's "SonarQube (changed lines)" step)
# =============================================================================
# The owner's SonarQube server, reachable only on the owner's network (see
# design/sonarqube/design.md). Without these the step passes with a warning
# ("SonarQube did NOT check this push"); with the server reachable, a missing
# or wrong token blocks the push. Scripts read these four keys from here and
# never source this file.
SONAR_HOST_URL=http://<server>:9000
SONAR_PROJECT_KEY=graphty-monorepo
# A user token of the NON-admin graphty-scan user (Browse and Execute Analysis
# on graphty-monorepo and graphty-monorepo-local). The gate refuses an
# administrator's token. In SonarQube: log in as graphty-scan, My Account ->
# Security -> Generate token. Never print it or pass it on a command line.
SONAR_TOKEN=squ_...
# The Java 17+ the scanner runs on (the scanner never downloads one).
SONAR_SCANNER_JAVA_EXE_PATH=/path/to/jre/bin/java
