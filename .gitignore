# Dependencies
node_modules/

# Nx cache
.nx/*
!.nx/version-plans/

# Build outputs
dist/
dist-ssr/
build/
*.tsbuildinfo

# Vite/Vitest timestamps
vite.config.*.timestamp*
vitest.config.*.timestamp*

# Storybook
storybook-static/
*storybook.log
build-storybook.log

# Temporary files: the root's and each package's. Anchored, because knip matches these
# patterns against absolute paths too, and an unanchored tmp/ hides every source file of a
# checkout that sits under a directory named tmp (/tmp/clone, say). `?*` rather than `*`
# for the same reason: knip turns `/*/tmp/` into `*/tmp/**`, whose `*` also matches the
# empty name before an absolute path's leading slash, so /tmp/clone/... would still match.
/tmp/
/.tmp/
/?*/tmp/
/?*/.tmp/
.playwright-mcp/

# IDE/Editor files
.idea/
.vscode/
*.swp
*.swo
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log
# webgpu-graph-algorithms review probe logs are committed on purpose (its docs/research/review/probes)
!webgpu-graph-algorithms/docs/research/review/probes/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# SonarQube scanner work directory, for scans run by hand (tools/sonar-gate.mjs and
# tools/sonar-baseline.mjs write theirs under the git common directory instead)
.scannerwork/

# Coverage
coverage/
.nyc_output/
.coverage-shards/
.coverage-packages/
.coverage-parts/

# Environment
.env
.env.local
.env.*.local
*.local
# Backups a script makes before rewriting .env. One of these was sitting untracked and
# unignored in the repository root on 2026-09-22 holding four Chromatic project tokens and
# three LLM API keys, which `git add -A` would have staged.
.env.bak
.env.bak.*
.env.backup
.env.backup.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Test artifacts
.vitest/
test-results/
playwright-report/
# Vitest saves a PNG for every browser-mode failure. Its default place for one is a
# __screenshots__ directory beside the test file, so a failing run leaves them scattered
# through test/ -- never wanted in a commit, and against graphty-element/CLAUDE.md, which
# says a directory under test/ is for files meant to be committed. graphty-element now
# redirects them to its own tmp/ (vitest.config.ts, FAILURE_SCREENSHOT_DIR); this rule
# stays because every other package still writes them where vitest chooses.
**/__screenshots__/
# Vitest 4 copies each failing browser test's screenshot into .vitest-attachments/ beside the
# config, as the attachment its reporters link to. Failure diagnostics, never committed.
**/.vitest-attachments/

# Playwright visual test artifacts
**/playwright/visual/screenshots-diff/
**/playwright/visual/screenshots-actual/
**/playwright/generated/*.visual.spec.ts

# Chromatic
chromatic-diagnostics.json
stories/auto-generated/

# GitHub Pages build output
gh-pages/

# VitePress
**/docs/.vitepress/cache/
**/docs/.vitepress/dist/

# Auto-generated API docs
**/docs/api/generated/

# Copied docs content (generated by tools/copy-docs-content.js)
docs/graphty-element/
docs/algorithms/
docs/layout/
docs/graph-io/
docs/visual-review/

# Layout package specific
layout/examples/layout.js
layout/docs.json
layout/log/*

# Generated TypeScript files in package roots
**/index.js
**/index.d.ts
**/index.d.ts.map

# Jupyter
.ipynb_checkpoints/

# PUPT / pt
.pt-config.json.backup
.pthistory/
.pthistory
.git-prompts

# wtt worktrees. Anchored: a worktree under .worktrees/ must not inherit it (knip reads
# ancestor .gitignore files, see tools/run-knip.sh).
/.worktrees/

# Husky (managed by monorepo root)
*/.husky/

# Claude Code session archive (synced by claude-history-sync.sh; see CLAUDE.md)
.claudehistory/

# Python bytecode caches (tools/uat-contrast.py leaves one beside itself)
__pycache__/

# webgpu-graph-algorithms run output (contract 2.8): benchmark sessions, the browser smoke's JSON report, the adapter report
**/benchmarks/out/
# graphty-element's bench-browser rows, appended on every run by vitest.config.ts: a log of one
# machine's runs, not a result. The design records the numbers it cites.
graphty-element/benchmarks/results/browser-*.jsonl
browser-results.json
gpu-report.json

# The Figma editor UI study (screenshots, HTML and measured styles, about 1.2 GB): kept
# locally as design reference, never committed.
design/ui/figma/
