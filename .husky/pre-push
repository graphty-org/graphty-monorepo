#!/bin/sh
# Pre-push hook: only the checks that take seconds and protect the repository rather than judge the
# code (design/ci/channels-pipeline/merging.md, section 6): the Git LFS upload, the secret scan and the
# committed-images limit. CI's light check judges the code; for an answer before CI, run
# `pnpm run check:quick` (tools/check-quick.sh) in the background.
#
# To skip this hook: git push --no-verify (this skips the Git LFS upload too; after such a push of
# baseline images, run `git lfs push origin <branch>`)

# The scripts are the ones beside this hook; the checkout being pushed is the working directory git
# runs the hook in.
GATE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# git's ref lines: "<local ref> <local sha> <remote ref> <remote sha>", one per ref pushed.
PUSH_REFS=$(cat)

# Git LFS first: upload the baseline images this push points at (tools/lfs-pre-push.sh says why
# it is here and not in git-lfs's own hook).
printf '%s\n' "$PUSH_REFS" | "$GATE_DIR/tools/lfs-pre-push.sh" "$@" || exit 1

# The branch this push merges into (tools/push-base.mjs), asked once for both checks below.
PUSH_BASE_REF=${PUSH_BASE_REF:-$(node "$GATE_DIR/tools/push-base.mjs")} || exit 1
export PUSH_BASE_REF

# Secret scan of every file this branch changes since it left that branch. It runs here as
# well as in pre-commit because a commit made with a temporary core.hooksPath skips pre-commit.
PREPUSH_ROOT="$PWD" "$GATE_DIR/tools/scan-secrets.sh" "$(git merge-base "$PUSH_BASE_REF" HEAD)" HEAD || exit 1

# No pile of images added outside the folders that hold them (tools/check-committed-images.mjs).
node "$GATE_DIR/tools/check-committed-images.mjs" || exit 1
