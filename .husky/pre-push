#!/bin/sh
# Pre-push hook.
#
# Runs tools/prepush.sh for the packages this push affects: build, lint, knip, then the fast tests --
# each package's node-only project, graphty-element's default, mesh and contract
# projects, and graphty's full browser suite. graphty-element's browser,
# interactions and storybook projects are CI-only; tools/prepush.sh says why, with
# the wall clock each one costs.
#
# It also runs "SonarQube (changed lines)" (tools/sonar-gate.mjs, in the background): a new SonarQube
# issue or security hotspot on a line this push adds or changes fails the push. Off the owner's network
# it passes with a warning. For a false positive: `// NOSONAR(<rule>): <reason>` on the line, or a
# reasoned path entry in sonar-project.properties. Emergencies only: a `Sonar-Bypass: <reason>` trailer
# on the HEAD commit (it never covers vulnerabilities or security hotspots).
#
# To skip this hook: git push --no-verify (this skips the Git LFS upload too; after such a push of
# baseline images, run `git lfs push origin <branch>`)
# To run manually: pnpm run prepush:fast

# Git LFS first: upload the baseline images this push points at (tools/lfs-pre-push.sh says why
# it is here and not in git-lfs's own hook). It reads git's ref lines on stdin; nothing below does.
./tools/lfs-pre-push.sh "$@" || exit 1

# Secret scan of every file this branch changes since it left origin/master. It runs here as
# well as in pre-commit because a commit made with a temporary core.hooksPath skips pre-commit.
./tools/scan-secrets.sh "$(git merge-base origin/master HEAD)" HEAD || exit 1

# Run the prepush validation script
pnpm run prepush:fast
