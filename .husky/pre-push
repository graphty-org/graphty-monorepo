#!/bin/sh
# Pre-push hook.
#
# Runs tools/prepush.sh for the packages this push affects: build, lint, knip, then the fast tests --
# each package's node-only project, graphty-element's default, mesh and contract
# projects, and graphty's full browser suite. graphty-element's browser,
# interactions and storybook projects are CI-only; tools/prepush.sh says why, with
# the wall clock each one costs.
#
# To skip this hook: git push --no-verify
# To run manually: pnpm run prepush:fast

# Run the prepush validation script
pnpm run prepush:fast
