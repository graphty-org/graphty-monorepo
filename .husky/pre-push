#!/bin/sh
# Pre-push hook.
#
# Runs tools/prepush.sh for the packages this push affects: build, lint, knip, the test shards the
# pull request's CI runs (with CI's commands, from tools/ci-test-matrix.mjs; graphty-element's long
# browser and storybook shards only when the push changes a file they test), and the screenshots of
# the affected Storybooks on this commit merged into origin/master (tools/visual-preview.sh --head),
# which become the pull request's local preview on the owner's review page.
#
# It also runs "SonarQube (changed lines)" (tools/sonar-gate.mjs, before the build): a new SonarQube
# issue or security hotspot on a line this push adds or changes fails the push. Off the owner's network
# it passes with a warning. For a false positive: `// NOSONAR(<rule>): <reason>` on the line, or a
# reasoned path entry in sonar-project.properties. Emergencies only: a `Sonar-Bypass: <reason>` trailer
# on the HEAD commit (it never covers vulnerabilities or security hotspots).
#
# To skip this hook: git push --no-verify (this skips the Git LFS upload too; after such a push of
# baseline images, run `git lfs push origin <branch>`)
# To run manually: pnpm run prepush:fast

# The gate's scripts are the ones beside this hook; the checkout being pushed is the working
# directory git runs the hook in. They are the same checkout unless the push queue (tools/push-queue.sh)
# pointed core.hooksPath at the gate's live copy, .worktrees/gate-live, so every branch is checked by
# the current gate (CLAUDE.md, "Where a change takes effect").
GATE_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# git's ref lines: "<local ref> <local sha> <remote ref> <remote sha>", one per ref pushed.
PUSH_REFS=$(cat)

# Git LFS first: upload the baseline images this push points at (tools/lfs-pre-push.sh says why
# it is here and not in git-lfs's own hook).
printf '%s\n' "$PUSH_REFS" | "$GATE_DIR/tools/lfs-pre-push.sh" "$@" || exit 1

# What GitHub has now for the branch this push sends HEAD to (all zeros: a new branch), so the
# SonarQube step judges complexity on this push's own changes (tools/sonar-gate.mjs, step 4).
PUSH_REMOTE_SHA=$(printf '%s\n' "$PUSH_REFS" | awk -v head="$(git rev-parse HEAD)" '$2 == head { print $4; exit }')
PUSH_REMOTE_REF=$(printf '%s\n' "$PUSH_REFS" | awk -v head="$(git rev-parse HEAD)" '$2 == head { print $3; exit }')
PUSH_REMOTE="$1"
# tools/prepush.sh checks again, just before git sends the push, that the branch is still at that tip.
export PUSH_REMOTE_SHA PUSH_REMOTE_REF PUSH_REMOTE

# The branch this push merges into (origin/master, or a stacked pull request's parent branch), asked
# once and exported, so every step below measures "this push's changes" from the same base without
# asking again. The push queue has usually asked already.
PUSH_BASE_REF=${PUSH_BASE_REF:-$(node "$GATE_DIR/tools/push-base.mjs")} || exit 1
export PUSH_BASE_REF

# Secret scan of every file this branch changes since it left that branch. It runs here as
# well as in pre-commit because a commit made with a temporary core.hooksPath skips pre-commit.
PREPUSH_ROOT="$PWD" "$GATE_DIR/tools/scan-secrets.sh" "$(git merge-base "$PUSH_BASE_REF" HEAD)" HEAD || exit 1

# Run the prepush validation script
PREPUSH_ROOT="$PWD" "$GATE_DIR/tools/prepush.sh"
