# URL patterns (regular expressions) lychee never checks. Read automatically by lychee; see
# lychee.toml. Every entry says why it can never be a useful check.

# Local servers in examples and dev instructions
^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0)([:/]|$)
^https?://([a-z0-9-]+\.)?example\.(com|org|net)([:/]|$)

# Shell brace expansion written into a URL in research notes ({a,b}.java), not a real address
(\{|%7B)

# A research-plan document quotes Storybook deep links and planned doc pages as placeholders
# (storybook/?path=..., ./docs/<planned page>.md) and a reference image that was never committed
^file://.*/design/testing/storybook
^file://.*/design/code-reviews/docs/
^file://.*/design/tmp/

# TypeDoc output: generated by `npm run docs:api`, not committed. VitePress checks these links when
# it builds the docs (CI "Build docs" step), with dead-link checking on
^file://.*/docs/api/generated(/|$)
