# Dependencies
node_modules/

# Build outputs
dist/
coverage/
storybook-static/
# graph-samples' hosted datasets: written by `npm run datasets:hosted`, ignored by
# graph-samples/.gitignore, which prettier does not read (it reads only the root .gitignore)
graph-samples/public-data/
# pipeline-health's CDK synth output: written by `pnpm run synth`, ignored by tools/pipeline-health/.gitignore
tools/pipeline-health/cdk.out/

# Generated files
# API reports: written by tools/api-report.mjs (api-extractor), compared byte for byte
*/api/*.api.md
# graphty-element's ./jsx entry: written by graphty-element/scripts/generate-jsx-types.ts and
# compared byte for byte by graphty-element/test/packaging/jsx-types.test.ts
graphty-element/jsx.ts
# The style fidelity scorecards' known failures: written by graphty-element/scripts/fidelity-ratchet.ts one line per
# sample and property, which prettier would spread over a line per element id (4 MB instead of 1.5)
graphty-element/test/fidelity/oracle-known-failures.json
graphty-element/test/fidelity/baseline-scores.json
# Graphviz layout fixtures: written by graphty-element/scripts/record-graphviz-fixtures.ts and
# compared number for number by graphty-element/test/layout/graphviz-fidelity.test.ts
graphty-element/test/layout/graphviz-fixtures/
# compact-mantine's Figma fixtures: written by compact-mantine/tests/figma/figma-fixture.mjs (one line per
# captured element), and checked value for value against the Figma study by the same script
compact-mantine/tests/figma/figma-fixture.json
compact-mantine/tests/figma/figma-variables.json
# Vitest file snapshots: written by the tests that compare them byte for byte
**/__snapshots__/
# Changelogs: written by `nx release` (tools/changelog-renderer.cjs) inside the release commit, so
# nothing formats them. Prettier would also rewrite the commit subjects they quote (A* -> A\*,
# __proto__ -> **proto**), and a release commit must never fail CI on its own changelogs.
**/CHANGELOG.md
*.min.js
*.bundle.js

# The design studio's round records (design/ui/studio/rounds/, tier2/rounds/): session logs,
# transcripts and grades its study tool and agents write while a round runs, kept as written.
design/ui/studio/rounds/
design/ui/studio/*/rounds/

# Package manager
pnpm-lock.yaml

# Git
.git/

# Temporary files
tmp/
.worktrees/

# Documentation builds
docs/.vitepress/cache/
docs/.vitepress/dist/

# Visual-review baselines: PNGs and the JSON records written with them, byte-exact
visual-baselines/
# Signed screenshot approvals: their bytes are what the passkey signed, so a formatter must never touch them.
visual-review-approvals/

# Other
gh-pages/

# The root CLAUDE.md is hand-formatted: prettier re-indents its nested lists and folds the
# paragraph after a list into the last item, which changes what the rules say.
/CLAUDE.md

# Conformance fixtures are byte-exact test data; the report is generated
graph-io/test/conformance/fixtures/
graph-io/test/conformance/REPORT.md
graph-io/test/conformance/schemas/

# Network source recordings: live services' answers, one response per line (graph-io/scripts/record-rest.ts)
graph-io/test/sources/*/recordings/

# githerd's replay data: GitHub's recorded answers, one record per line
githerd/test/replay/data/

# githerd's snapshots of the worker files it generates, byte for byte as it writes them
githerd/test/worker-settings/

# Generated benchmark reports
algorithms/benchmark-results/

# The style corpus: real files kept byte for byte, and RESULTS.md, which the style harness compares as written
graph-io/test/corpus/styles/

# Style fidelity references: scenes written by graph-io/test/fidelity/regenerate.sh, and the samples
# they hash byte for byte
graph-io/test/fidelity/scenes/
graph-io/test/fidelity/samples/
# Gephi JSON specimen sheets: Gson's compact output byte for byte (escapes, key order), which the oracles hash
graph-io/test/fidelity/specimens/gephi-json/*.json

# Deliberately malformed input for the importer tests; formatting would repair or reject it
**/corpus/malformed/

# Signed gate records of webgpu-graph-algorithms: history, kept word for word. Prettier rewrites
# some of their text (a `.*` glob becomes `._`, blank signature lines become bold), not just spacing
webgpu-graph-algorithms/docs/decisions/G[0-9]*.md

# Third-party source vendored unchanged
visual-review/trusted/vendor/

# The UI design framework is hand-formatted and checked by its own script
# (design/ui/framework/research/scripts/check-framework.mjs): prettier's rewrite of its tables,
# lists and escapes breaks that check's cross-document pointers. The object-first rounds are
# the frozen design record the framework cites.
design/ui/framework/
design/ui/object-first-ux/

# The githerd design and plan are hand-formatted: prettier breaks inline code that wraps across
# lines out of its list item and folds the paragraph after a list into the last item, which
# changes what the steps say.
design/githerd/

# Prettier's markdown output for these files is not a fixed point: it re-indents fenced code
# inside lists (or flips escapes) on every pass, so `prettier --check` can never pass on them.
/design/rendering/edge-styles-implementation-plan.md
/design/ui/mockups/system/ARTBOARD-CHANGES-1.7.md
/design/ui/mockups/system/ARTBOARD-CHANGES-1.8.md
/design/webgpu/webgpu-acceleration-plan.md
