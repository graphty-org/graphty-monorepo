{
    "name": "babylonjs-models",
    "version": "0.0.0",
    "private": false,
    "description": "Load 3D models into Babylon.js scenes from URLs, files, folders, zips or bytes: glTF and GLB with Draco, meshopt and KTX2, OBJ with MTL, STL, PLY, Gaussian splats and .babylon, every file checked first and nothing fetched from a CDN",
    "author": "Adam Powers <apowers@ato.ms>",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./files": {
            "types": "./dist/files/index.d.ts",
            "import": "./dist/files/index.js",
            "default": "./dist/files/index.js"
        },
        "./detect": {
            "types": "./dist/detect/index.d.ts",
            "import": "./dist/detect/index.js",
            "default": "./dist/detect/index.js"
        },
        "./wasm/*": "./dist/wasm/*"
    },
    "typesVersions": {
        "*": {
            "files": [
                "dist/files/index.d.ts"
            ],
            "detect": [
                "dist/detect/index.d.ts"
            ]
        }
    },
    "sideEffects": [
        "./dist/load/loaders.js",
        "./dist/decoders/draco.js",
        "./dist/decoders/ktx2.js",
        "./dist/decoders/meshopt.js"
    ],
    "files": [
        "dist/",
        "!dist/*.tsbuildinfo",
        "licenses/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/copy-decoders.mjs",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "fixtures": "tsx test/fixtures/variants/generate.ts",
        "ready:commit": "npm run build && npm run lint && npm run test:run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "babylonjs-models"
    },
    "keywords": [
        "babylonjs",
        "babylon.js",
        "3d",
        "model",
        "loader",
        "gltf",
        "glb",
        "obj",
        "stl",
        "ply",
        "gaussian-splat",
        "draco",
        "ktx2"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/babylonjs-models#readme",
    "dependencies": {
        "@babylonjs/ktx2decoder": "8.56.2",
        "fflate": "^0.8.3",
        "meshoptimizer": "^1.3.0"
    },
    "peerDependencies": {
        "@babylonjs/core": "^8.0.0",
        "@babylonjs/loaders": "^8.0.0"
    },
    "peerDependenciesMeta": {
        "@babylonjs/core": {
            "optional": true
        },
        "@babylonjs/loaders": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babylonjs/core": "^8.36.1",
        "@babylonjs/loaders": "8.56.2",
        "@gltf-transform/core": "^4.5.1",
        "@gltf-transform/extensions": "^4.5.1",
        "@types/node": "^20.19.9",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "draco3dgltf": "^1.5.9",
        "eslint": "^9.29.0",
        "three": "^0.182.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "vite": "^8.1.6",
        "vitest": "catalog:"
    }
}
