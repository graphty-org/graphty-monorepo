{
    "name": "@graphty/compact-mantine",
    "version": "0.9.41",
    "description": "Compact size variants for Mantine UI components - optimized for dense UIs",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "!dist/*.tsbuildinfo"
    ],
    "sideEffects": false,
    "dependencies": {
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26"
    },
    "peerDependencies": {
        "@mantine/core": "^8.0.0",
        "@mantine/hooks": "^8.0.0",
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@mantine/core": "^8.3.18",
        "@mantine/hooks": "^8.3.18",
        "@storybook/addon-a11y": "9.1.20",
        "@storybook/addon-docs": "^9.1.21",
        "@storybook/addon-vitest": "^9.1.21",
        "@storybook/react": "^9.1.21",
        "@storybook/react-vite": "^9.1.21",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/browser-playwright": "catalog:",
        "@zag-js/floating-panel": "^1.47.0",
        "@zag-js/react": "^1.47.0",
        "eslint": "^9.39.5",
        "jsdom": "^30.1.3",
        "lucide-react": "^0.525.0",
        "playwright": "1.57.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "remark-gfm": "^4.0.1",
        "storybook": "^9.1.21",
        "typescript": "~5.8.3",
        "vite": "^8.3.8",
        "vite-plugin-dts": "^4.5.4",
        "vitest": "catalog:"
    },
    "scripts": {
        "build": "vite build",
        "test": "vitest",
        "test:run": "vitest run",
        "test:storybook": "vitest run --config vitest.storybook.config.ts",
        "coverage": "vitest run --coverage",
        "storybook": "storybook dev -p ${PORT:?start it through servherd, which sets PORT} --host ${HOST:-localhost} ${HTTPS_CERT_PATH:+--https --ssl-cert $HTTPS_CERT_PATH --ssl-key $HTTPS_KEY_PATH} --no-open",
        "build-storybook": "storybook build",
        "lint": "eslint && tsc -p tsconfig.check.json",
        "lint:fix": "eslint --fix",
        "lint:knip": "cd .. && ./tools/run-knip.sh --workspace compact-mantine"
    },
    "keywords": [
        "mantine",
        "react",
        "ui",
        "theme",
        "compact",
        "sidebar",
        "property-panel"
    ],
    "license": "MIT AND OFL-1.1",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "compact-mantine"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/compact-mantine#readme",
    "author": "Adam Powers <apowers@ato.ms>"
}
