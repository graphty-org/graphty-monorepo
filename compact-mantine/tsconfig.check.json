{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "declaration": true,
        "target": "ES2022",
        "module": "ES2022",
        "paths": { "@graphty/compact-mantine": ["./src/index.ts"] }
    },
    "include": ["src/**/*", "stories/**/*", "tests/**/*", "docs/examples/**/*"],
    "exclude": ["node_modules", "dist"]
}
