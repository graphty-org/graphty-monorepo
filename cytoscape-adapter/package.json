{
    "name": "@graphty/cytoscape",
    "version": "0.0.0",
    "private": true,
    "description": "Graphty layouts and algorithms as Cytoscape.js extensions, over the @graphty/graph-format snapshot",
    "author": "Adam Powers <apowers@ato.ms>",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist/",
        "!dist/*.tsbuildinfo",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.19.0"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "ready:commit": "npm run build && npm run lint && npm run test:run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "cytoscape-adapter"
    },
    "keywords": [
        "graph",
        "layout",
        "cytoscape",
        "cytoscape-extension",
        "forceatlas2",
        "graph-format"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/cytoscape-adapter#readme",
    "peerDependencies": {
        "@graphty/algorithms": "^3.0.0",
        "@graphty/graph-format": "^1.0.0",
        "@graphty/layout": "^2.0.0",
        "@graphty/webgpu-graph-algorithms": ">=0.6.0",
        "cytoscape": "^3.30.0"
    },
    "peerDependenciesMeta": {
        "@graphty/webgpu-graph-algorithms": {
            "optional": true
        }
    },
    "devDependencies": {
        "@graphty/algorithms": "workspace:^",
        "@graphty/graph-format": "workspace:^",
        "@graphty/layout": "workspace:^",
        "@graphty/webgpu-graph-algorithms": "workspace:^",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "cytoscape": "^3.34.3",
        "eslint": "^9.29.0",
        "typescript": "^5.9.3",
        "vitest": "catalog:"
    }
}
