{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "noImplicitOverride": true,
        "lib": ["ES2020", "DOM"],
        "types": ["node", "vitest/globals"]
    },
    "include": ["bundle.ts", "src/**/*.ts", "test/**/*.ts", "stories/**/*.ts", ".storybook/**/*.ts"],
    "exclude": ["node_modules", "dist", "coverage", "tmp", "test/consumer"]
}
