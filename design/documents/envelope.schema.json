{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphty.app/schema/documents/graphty-document/v1.json",
  "title": "graphty document envelope, version 1",
  "description": "Normative for what a conforming writer produces. Each member is checked here only as an object with an integer version and, for version 1, against its own kind's schema; a member of another version is still a valid member. A reader validates members independently (envelope.md); only a failure of the envelope's own top level refuses the document.",
  "type": "object",
  "required": [
    "kind",
    "version",
    "createdAt"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "const": "graphty-document"
    },
    "version": {
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "modifiedAt": {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "generator": {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/generator"
    },
    "fingerprint": {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/fingerprint"
    },
    "data": {
      "$ref": "#/$defs/data"
    },
    "dataSource": {
      "$ref": "#/$defs/dataSource"
    },
    "dataPlan": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "$ref": "https://graphty.app/schema/documents/graphty-data-plan/v1.json"
      }
    },
    "style": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "$ref": "https://graphty.app/schema/documents/graphty-style/v1.json"
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "if": {
          "properties": {
            "version": {
              "const": 1
            }
          }
        },
        "then": {
          "$ref": "https://graphty.app/schema/documents/graphty-recipe/v1.json"
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "$ref": "https://graphty.app/schema/documents/graphty-view/v1.json"
      }
    },
    "annotations": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "if": {
        "properties": {
          "version": {
            "const": 1
          }
        }
      },
      "then": {
        "$ref": "https://graphty.app/schema/documents/graphty-annotations/v1.json"
      }
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "fieldsUsed",
          "counts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
          },
          "fieldsUsed": {
            "type": "object"
          },
          "counts": {
            "type": "object"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/runRecord"
          },
          {
            "$ref": "#/$defs/layoutRecord"
          }
        ]
      }
    },
    "positions": {
      "type": "object",
      "required": [
        "dimension"
      ],
      "oneOf": [
        {
          "required": [
            "inline"
          ]
        },
        {
          "required": [
            "part"
          ]
        }
      ],
      "properties": {
        "layout": {
          "type": "string"
        },
        "dimension": {
          "enum": [
            2,
            3
          ]
        },
        "inline": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/nodeId"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "minItems": 3,
            "maxItems": 4
          }
        },
        "part": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
        }
      }
    },
    "filter": {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/filter"
    },
    "sets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keptSet"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run",
          "part"
        ],
        "properties": {
          "run": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/runId"
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
          },
          "format": {
            "enum": [
              "graph-format",
              "csv"
            ]
          },
          "formatVersion": {
            "type": "string"
          },
          "importedFrom": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/importChain"
          }
        }
      }
    },
    "extensions": {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/extensions"
    }
  },
  "$defs": {
    "data": {
      "type": "object",
      "required": [
        "format"
      ],
      "oneOf": [
        {
          "required": [
            "inline"
          ]
        },
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "part"
          ]
        }
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1,
          "description": "A format id from the element's format catalogue, or graph-format for the binary wire form inside a zip container."
        },
        "inline": {
          "type": "string",
          "description": "The whole data file as text."
        },
        "url": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/dataUrl"
        },
        "part": {
          "type": "string",
          "minLength": 1,
          "description": "A path inside the zip container."
        },
        "digest": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "object",
          "description": "Import options the format declares. Element-owned inputs and size-multiplying options are refused.",
          "propertyNames": {
            "not": {
              "enum": [
                "url",
                "data",
                "file",
                "filename",
                "size",
                "chunkSize",
                "errorLimit",
                "hyperedges",
                "edgeSource",
                "edgeTarget",
                "nodeIdPath",
                "idColumn",
                "sourceColumn",
                "targetColumn"
              ]
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "inline": {
                "type": "string"
              },
              "url": {
                "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/dataUrl"
              },
              "part": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string"
              },
              "digest": {
                "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "oneOf": [
              {
                "required": [
                  "inline"
                ]
              },
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "part"
                ]
              }
            ]
          }
        },
        "provenance": {
          "$ref": "#/$defs/dataSource"
        },
        "formatVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "original": {
          "type": "object",
          "required": [
            "digest",
            "format"
          ],
          "properties": {
            "digest": {
              "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
            },
            "format": {
              "type": "string"
            }
          }
        }
      }
    },
    "runRecord": {
      "type": "object",
      "required": [
        "id",
        "algorithm",
        "params",
        "seed",
        "scope",
        "startedAt",
        "durationMs",
        "engine",
        "outcome",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/runId"
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        },
        "seed": {
          "type": [
            "number",
            "null"
          ]
        },
        "scope": {
          "type": "object",
          "required": [
            "requested",
            "nodes",
            "edges"
          ],
          "properties": {
            "requested": {},
            "nodes": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            },
            "componentScope": {
              "enum": [
                "all",
                "largest"
              ]
            },
            "filter": {
              "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/filter"
            },
            "windowScope": {
              "type": "boolean"
            }
          }
        },
        "startedAt": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "engine": {
          "type": "object",
          "required": [
            "element",
            "algorithms",
            "layout"
          ],
          "properties": {
            "element": {
              "type": "string"
            },
            "algorithms": {
              "type": "string"
            },
            "layout": {
              "type": "string"
            },
            "plugins": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "accelerator": {
              "type": "object",
              "required": [
                "package",
                "version"
              ],
              "properties": {
                "package": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "backend": {
                  "type": "string"
                },
                "adapter": {
                  "type": "string"
                }
              }
            }
          }
        },
        "outcome": {
          "type": "object",
          "required": [
            "exact",
            "precision",
            "direction",
            "partial"
          ],
          "properties": {
            "exact": {
              "type": "boolean"
            },
            "sampleSize": {
              "type": "integer",
              "minimum": 1
            },
            "converged": {
              "type": "boolean"
            },
            "iterations": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "type": "string"
            },
            "precision": {
              "enum": [
                "f32",
                "f64"
              ]
            },
            "partial": {
              "type": "boolean"
            },
            "direction": {
              "type": "string",
              "minLength": 1
            },
            "partialReason": {
              "type": "string"
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "costCap": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "weight": {
          "type": "object",
          "required": [
            "attribute",
            "role",
            "confirmed"
          ],
          "properties": {
            "attribute": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "confirmed": {
              "type": "boolean"
            }
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "recipe": {
          "type": "object",
          "required": [
            "id",
            "digest",
            "step",
            "as",
            "namespace"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "recipeVersion": {
              "type": "string"
            },
            "digest": {
              "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/digest"
            },
            "step": {
              "type": "string"
            },
            "as": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "stale": {
          "type": "object",
          "required": [
            "reason",
            "since"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "since": {
              "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
            }
          }
        },
        "import": {
          "type": "string",
          "minLength": 1
        },
        "graphFields": {
          "type": "object"
        },
        "importedFrom": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/importChain"
        }
      }
    },
    "keptSet": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/nodeId"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/edgeMember"
          }
        },
        "extensions": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/extensions"
        },
        "features": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/features"
        },
        "importedFrom": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/importChain"
        }
      }
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "retrievedAt": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
        },
        "query": {
          "type": "object"
        },
        "citation": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "url": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/httpsUrl"
        }
      }
    },
    "layoutRecord": {
      "type": "object",
      "required": [
        "id",
        "layout",
        "engine",
        "params",
        "seed",
        "dimension",
        "scope",
        "startedAt",
        "durationMs",
        "outcome"
      ],
      "properties": {
        "id": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/runId"
        },
        "layout": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "allOf": [
            {
              "$ref": "#/$defs/runRecord/properties/engine"
            },
            {
              "required": [
                "layoutEngine"
              ],
              "properties": {
                "layoutEngine": {
                  "type": "string"
                },
                "layoutEngineVersion": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "params": {
          "type": "object"
        },
        "seed": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension": {
          "enum": [
            2,
            3
          ]
        },
        "scope": {
          "$ref": "#/$defs/runRecord/properties/scope"
        },
        "startedAt": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/timestamp"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "outcome": {
          "type": "object",
          "required": [
            "partial"
          ],
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 0
            },
            "converged": {
              "type": "boolean"
            },
            "partial": {
              "type": "boolean"
            }
          }
        },
        "recipe": {
          "$ref": "#/$defs/runRecord/properties/recipe"
        },
        "import": {
          "type": "string"
        },
        "importedFrom": {
          "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/importChain"
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/metadata"
    }
  ]
}
