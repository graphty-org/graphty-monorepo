{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphty.app/schema/documents/graphty-recipe/v1.json",
  "title": "graphty recipe, version 1",
  "description": "Normative for structure. Behaviour is specified in recipe.md. Validation is applied per step and per slot: one that fails is reported and skipped; only a failure of the top level refuses the document.",
  "type": "object",
  "required": ["kind", "version", "id", "name", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "graphty-recipe" },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "recipeVersion": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "namespace": { "$ref": "#/$defs/namespace" },
    "source": { "type": "string", "format": "uri" },
    "authors": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "url": { "type": "string" } } }
    },
    "license": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "requires": {
      "type": "object",
      "properties": {
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/attributeSlot" } },
        "arguments": { "type": "array", "items": { "$ref": "#/$defs/argumentSlot" } },
        "extensions": { "type": "array", "items": { "$ref": "#/$defs/extensionRequirement" } }
      }
    },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "overview": {
      "type": "object",
      "required": ["readings"],
      "properties": { "readings": { "type": "array", "items": { "type": "string", "minLength": 1 } } }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$" }
    }
  },
  "$defs": {
    "namespace": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 32 },
    "slotId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "runId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "attributeSlot": {
      "type": "object",
      "required": ["slot", "element", "name"],
      "properties": {
        "slot": { "$ref": "#/$defs/slotId" },
        "element": { "enum": ["node", "edge"] },
        "name": { "type": "string", "minLength": 1 },
        "nameHints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "level": { "enum": ["categorical", "ordinal", "quantitative", "temporal", "identifier"] },
        "role": { "type": "string", "minLength": 1 },
        "weightRole": { "enum": ["distance", "similarity", "capacity"] },
        "signed": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "argumentSlot": {
      "type": "object",
      "required": ["slot", "type"],
      "properties": {
        "slot": { "$ref": "#/$defs/slotId" },
        "type": { "enum": ["node-id", "node-set", "number", "string"] },
        "default": {},
        "description": { "type": "string" }
      }
    },
    "extensionRequirement": {
      "type": "object",
      "required": ["kind", "key"],
      "properties": {
        "kind": { "enum": ["algorithm", "layout", "palette", "camera", "format"] },
        "key": { "type": "string", "minLength": 1 },
        "package": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "command": { "$ref": "#/$defs/command" },
        "extensions": { "type": "object" }
      }
    },
    "command": {
      "type": "object",
      "required": ["op"],
      "properties": { "op": { "type": "string" } },
      "oneOf": [
        { "$ref": "#/$defs/algoRun" },
        { "$ref": "#/$defs/layoutSet" }
      ]
    },
    "scope": {
      "oneOf": [
        { "enum": ["visible", "graph", "selection", "largest-component"] },
        { "type": "object", "required": ["where"], "properties": { "where": { "type": "string" } } },
        { "type": "object", "required": ["define"], "properties": { "define": { "type": "object" } } }
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "object", "required": ["$argument"], "properties": { "$argument": { "$ref": "#/$defs/slotId" } }, "additionalProperties": false },
          { "not": { "type": "object", "required": ["$argument"] } }
        ]
      }
    },
    "algoRun": {
      "type": "object",
      "required": ["op", "algorithm", "as"],
      "properties": {
        "op": { "const": "algo.run" },
        "algorithm": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/params" },
        "scope": { "$ref": "#/$defs/scope" },
        "seed": { "type": "number" },
        "sample": { "type": "integer", "minimum": 1 },
        "exact": { "type": "boolean" },
        "as": { "$ref": "#/$defs/runId" },
        "style": {
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "object",
              "properties": {
                "size": {
                  "oneOf": [
                    { "type": "boolean" },
                    { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "layoutSet": {
      "type": "object",
      "required": ["op", "id"],
      "properties": {
        "op": { "const": "layout.set" },
        "id": { "type": "string", "minLength": 1 },
        "params": { "$ref": "#/$defs/params" },
        "scope": { "$ref": "#/$defs/scope" },
        "seed": { "type": "number" },
        "dimension": { "enum": [2, 3] },
        "start": { "enum": ["current", "fresh", "positions"] }
      }
    }
  }
}
