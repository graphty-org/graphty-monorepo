{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/graphty-recipe/v1.json",
    "title": "graphty recipe member, version 1",
    "description": "A journal of analysis commands, replayed on any graph whose import has the columns it names (recipe.md). Normative for what a writer produces. The members of each known command are closed: a reader skips a command with a member it does not know, and every command after it (recipe.md, 'Replaying'). op is an open list: a command of an op this schema does not list is valid, and a reader stops the replay there.",
    "type": "object",
    "required": ["kind", "version", "id", "commands"],
    "properties": {
        "kind": {
            "const": "graphty-recipe"
        },
        "version": {
            "const": 1
        },
        "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "description": "The recipe's identity across all its versions. A reverse-domain name (org.example.hub-genes) or an https: URL is recommended, so two authors do not collide."
        },
        "recipeVersion": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "description": "One version of the recipe, as a SemVer 2.0.0 version."
        },
        "name": {
            "type": "string",
            "maxLength": 1024
        },
        "description": {
            "type": "string",
            "maxLength": 65536
        },
        "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "not": {
                "pattern": "__|_$"
            },
            "description": "The namespace this recipe's run ids prefer when it is applied (recipe.md, 'Run ids and namespaces'). Letters, digits and single underscores, so a namespaced run id needs no quoting in a path."
        },
        "directed": {
            "type": "boolean",
            "description": "The direction of the graph the recipe was recorded on. A replay on a graph of the other direction is reported (recipe.md, 'Binding to a new graph' rule 5)."
        },
        "commands": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "$ref": "#/$defs/command"
            }
        },
        "extensions": {
            "$ref": "https://graphty.app/schema/documents/graphty-document/v1.json#/$defs/extensions"
        }
    },
    "$defs": {
        "command": {
            "type": "object",
            "required": ["op"],
            "properties": {
                "op": {
                    "type": "string"
                }
            },
            "oneOf": [
                {
                    "$ref": "#/$defs/algoRun"
                },
                {
                    "$ref": "#/$defs/layoutSet"
                },
                {
                    "$ref": "#/$defs/laterCommand"
                }
            ]
        },
        "as": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "not": {
                "pattern": "__"
            },
            "description": "The run's name in this recipe. Unique within the recipe; never contains two underscores in a row, which separate a namespace from a name. Letters, digits and single underscores are RECOMMENDED, so a path naming the run needs no quoting."
        },
        "params": {
            "type": "object",
            "propertyNames": {
                "not": {
                    "const": "__proto__"
                }
            },
            "description": "Option values by the option names graphty-element's catalogue publishes for the algorithm or layout."
        },
        "scope": {
            "oneOf": [
                {
                    "enum": ["graph", "largest-component"]
                },
                {
                    "type": "object",
                    "required": ["where"],
                    "additionalProperties": false,
                    "properties": {
                        "where": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 1024,
                            "description": "A predicate in graphty-element's JMESPath dialect over {data, results} of the table 'on' names: columns as data.<column>, earlier results as results.<as>.<field>."
                        },
                        "on": {
                            "enum": ["nodes", "edges"],
                            "description": "Which table the predicate is evaluated on. nodes (the default): the run sees the matched nodes and the edges between them. edges: the run sees every node and only the matched edges."
                        }
                    }
                }
            ]
        },
        "description": {
            "type": "string",
            "maxLength": 65536,
            "description": "Why this command is in the recipe. Shown to people; never sent to the algorithm."
        },
        "algoRun": {
            "type": "object",
            "required": ["op", "algorithm", "as"],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "algo.run"
                },
                "algorithm": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "An algorithm key from graphty-element's catalogue, or one a plugin registered."
                },
                "as": {
                    "$ref": "#/$defs/as"
                },
                "params": {
                    "$ref": "#/$defs/params"
                },
                "scope": {
                    "$ref": "#/$defs/scope"
                },
                "seed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                },
                "sample": {
                    "type": "integer",
                    "minimum": 1
                },
                "exact": {
                    "type": "boolean"
                },
                "style": {
                    "oneOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "size": {
                                    "oneOf": [
                                        {
                                            "type": "boolean"
                                        },
                                        {
                                            "type": "array",
                                            "items": {
                                                "type": "number",
                                                "minimum": 0
                                            },
                                            "minItems": 2,
                                            "maxItems": 2
                                        }
                                    ]
                                }
                            }
                        }
                    ],
                    "description": "What the run paints when it completes, as graphty-element's run option of the same name: true or absent, the colouring its result suggests; false, nothing."
                },
                "description": {
                    "$ref": "#/$defs/description"
                }
            }
        },
        "layoutSet": {
            "type": "object",
            "required": ["op", "id"],
            "additionalProperties": false,
            "properties": {
                "op": {
                    "const": "layout.set"
                },
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "A layout id from graphty-element's catalogue, or one a plugin registered."
                },
                "engine": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "description": "The engine that draws the layout; the catalogue's default engine for id when absent."
                },
                "options": {
                    "$ref": "#/$defs/params",
                    "description": "The engine's options, by the names the catalogue publishes, the seed among them."
                },
                "description": {
                    "$ref": "#/$defs/description"
                }
            }
        },
        "laterCommand": {
            "type": "object",
            "required": ["op"],
            "properties": {
                "op": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "not": {
                        "enum": ["algo.run", "layout.set"]
                    }
                }
            },
            "description": "A command a later release adds. A version 1 reader skips it and every later command with E_UNKNOWN_COMMAND."
        }
    }
}
