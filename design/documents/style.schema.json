{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/graphty-style/v1.json",
    "title": "graphty style document, version 1",
    "description": "Normative for what a conforming writer produces. A reader applies it per unit and follows style.md for what fails (a failing layer is added disabled; an unknown channel entry is dropped from its layer); only a failure of the top level refuses the document.",
    "type": "object",
    "required": ["version", "layers"],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "kind": {
            "const": "graphty-style",
            "description": "Optional in version 1 because graphty-element 2.x writes the document without it. Writers conforming to this specification MUST write it."
        },
        "version": {
            "const": 1
        },
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "fingerprint": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/fingerprint"
        },
        "generator": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/generator"
        },
        "layers": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/layer"
            }
        },
        "palettes": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/palette"
            }
        },
        "extensions": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/extensions"
        },
        "requires": {
            "type": "object",
            "properties": {
                "attributes": {
                    "type": "array",
                    "items": {
                        "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/attributeSlot"
                    }
                }
            }
        }
    },
    "$defs": {
        "path": {
            "allOf": [
                {
                    "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/expression"
                }
            ],
            "description": "A field path over the expression root {data, results} (README, Paths)."
        },
        "runId": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/runId"
        },
        "nodeId": {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/nodeId"
        },
        "layer": {
            "type": "object",
            "required": ["name", "selector"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string"
                },
                "target": {
                    "enum": ["node", "edge"]
                },
                "kind": {
                    "enum": ["base", "encoding", "highlight", "custom"]
                },
                "selector": {
                    "$ref": "#/$defs/selector"
                },
                "set": {
                    "$ref": "#/$defs/staticStyle"
                },
                "encode": {
                    "$ref": "#/$defs/encoding"
                },
                "source": {
                    "$ref": "#/$defs/layerSource"
                },
                "enabled": {
                    "type": "boolean"
                },
                "userData": {
                    "type": "object"
                },
                "extensions": {
                    "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/extensions"
                },
                "features": {
                    "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/features"
                }
            },
            "anyOf": [
                {
                    "required": ["set"]
                },
                {
                    "required": ["encode"]
                }
            ]
        },
        "selector": {
            "type": "object",
            "required": ["match"],
            "properties": {
                "match": {
                    "type": "string"
                }
            },
            "oneOf": [
                {
                    "properties": {
                        "match": {
                            "const": "expression"
                        },
                        "where": {
                            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/expression"
                        }
                    },
                    "required": ["where"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "has"
                        },
                        "path": {
                            "$ref": "#/$defs/path"
                        }
                    },
                    "required": ["path"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "ids"
                        },
                        "nodes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/nodeId"
                            }
                        },
                        "edges": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/nodeId"
                            },
                            "description": "Version 1 holds what graphty-element 2.x accepts: session edge ids, which a reader disables with E_UNSTABLE_EDGE_ID. Stable EdgeMember references are a style version 2 value (style.md, Selectors)."
                        }
                    }
                },
                {
                    "properties": {
                        "match": {
                            "const": "top"
                        },
                        "path": {
                            "allOf": [
                                {
                                    "$ref": "#/$defs/path"
                                },
                                {
                                    "pattern": "^results\\."
                                }
                            ]
                        },
                        "n": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "required": ["path", "n"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "everything"
                        }
                    }
                },
                {
                    "properties": {
                        "match": {
                            "const": "member"
                        },
                        "of": {
                            "$ref": "#/$defs/scope"
                        }
                    },
                    "required": ["of"]
                }
            ]
        },
        "scope": {
            "oneOf": [
                {
                    "enum": ["visible", "graph", "selection", "largest-component"]
                },
                {
                    "type": "object",
                    "required": ["set"],
                    "properties": {
                        "set": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["where"],
                    "properties": {
                        "where": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["nodes"],
                    "properties": {
                        "nodes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/nodeId"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["define"],
                    "properties": {
                        "define": {
                            "type": "object"
                        }
                    }
                }
            ]
        },
        "layerSource": {
            "type": "object",
            "required": ["by"],
            "oneOf": [
                {
                    "properties": {
                        "by": {
                            "const": "run"
                        },
                        "runId": {
                            "$ref": "#/$defs/runId"
                        },
                        "algorithm": {
                            "type": "string"
                        },
                        "params": {
                            "type": "object"
                        }
                    },
                    "required": ["runId", "algorithm", "params"]
                },
                {
                    "properties": {
                        "by": {
                            "const": "user"
                        }
                    }
                },
                {
                    "properties": {
                        "by": {
                            "const": "template"
                        },
                        "templateId": {
                            "type": "string"
                        }
                    },
                    "required": ["templateId"]
                },
                {
                    "properties": {
                        "by": {
                            "const": "plugin"
                        },
                        "name": {
                            "type": "string"
                        }
                    },
                    "required": ["name"]
                }
            ]
        },
        "rgba": {
            "type": "object",
            "required": ["r", "g", "b", "a"],
            "properties": {
                "r": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "g": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "b": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "a": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "color": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "#/$defs/rgba"
                }
            ]
        },
        "labelStyle": {
            "type": "object",
            "properties": {
                "sizePx": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 512
                },
                "padding": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                },
                "borderWidth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                },
                "shadowBlur": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                }
            }
        },
        "unit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "nonNegative": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
        },
        "staticStyle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "node.color": {
                    "$ref": "#/$defs/color"
                },
                "node.size": {
                    "$ref": "#/$defs/nonNegative"
                },
                "node.shape": {
                    "enum": [
                        "box",
                        "sphere",
                        "cylinder",
                        "cone",
                        "capsule",
                        "torus",
                        "torus-knot",
                        "tetrahedron",
                        "octahedron",
                        "dodecahedron",
                        "icosahedron",
                        "rhombicuboctahedron",
                        "triangular_prism",
                        "pentagonal_prism",
                        "hexagonal_prism",
                        "square_pyramid",
                        "pentagonal_pyramid",
                        "triangular_dipyramid",
                        "pentagonal_dipyramid",
                        "elongated_square_dipyramid",
                        "elongated_pentagonal_dipyramid",
                        "elongated_pentagonal_cupola",
                        "goldberg",
                        "icosphere",
                        "geodesic"
                    ]
                },
                "node.label": {
                    "type": "string",
                    "maxLength": 1024
                },
                "node.labelStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "node.tooltip": {
                    "type": "string",
                    "maxLength": 1024
                },
                "node.tooltipStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "node.opacity": {
                    "$ref": "#/$defs/unit"
                },
                "node.outline": {
                    "$ref": "#/$defs/color"
                },
                "node.glow": {
                    "$ref": "#/$defs/color"
                },
                "node.glowStrength": {
                    "$ref": "#/$defs/nonNegative"
                },
                "node.wireframe": {
                    "type": "boolean"
                },
                "node.flat": {
                    "type": "boolean"
                },
                "edge.color": {
                    "$ref": "#/$defs/color"
                },
                "edge.width": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.opacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.style": {
                    "enum": ["solid", "dot", "star", "box", "dash", "diamond", "dash-dot", "sinewave", "zigzag"]
                },
                "edge.patternCount": {
                    "type": "integer",
                    "minimum": 2
                },
                "edge.curvature": {
                    "type": "boolean"
                },
                "edge.arrowHead": {
                    "enum": [
                        "normal",
                        "inverted",
                        "dot",
                        "sphere-dot",
                        "open-dot",
                        "none",
                        "tee",
                        "open-normal",
                        "diamond",
                        "open-diamond",
                        "crow",
                        "box",
                        "half-open",
                        "vee"
                    ]
                },
                "edge.arrowHeadSize": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.arrowHeadColor": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowHeadOpacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.arrowHeadText": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.arrowHeadTextStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "edge.arrowTail": {
                    "enum": [
                        "normal",
                        "inverted",
                        "dot",
                        "sphere-dot",
                        "open-dot",
                        "none",
                        "tee",
                        "open-normal",
                        "diamond",
                        "open-diamond",
                        "crow",
                        "box",
                        "half-open",
                        "vee"
                    ]
                },
                "edge.arrowTailSize": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.arrowTailColor": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowTailOpacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.arrowTailText": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.arrowTailTextStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "edge.animationSpeed": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.label": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.labelStyle": {
                    "$ref": "#/$defs/labelStyle"
                }
            }
        },
        "binding": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["value"],
                    "properties": {
                        "value": {}
                    }
                },
                {
                    "type": "object",
                    "required": ["by"],
                    "properties": {
                        "by": {
                            "$ref": "#/$defs/path"
                        },
                        "scale": {
                            "type": "string"
                        },
                        "palette": {
                            "type": "string"
                        },
                        "domain": {
                            "oneOf": [
                                {
                                    "const": "auto"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                }
                            ]
                        },
                        "clamp": {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "Two percentiles of the values present, lower first."
                        },
                        "range": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "map": {
                            "type": "object",
                            "additionalProperties": {
                                "type": ["string", "number"]
                            }
                        },
                        "other": {
                            "type": "object",
                            "required": ["threshold", "value"],
                            "properties": {
                                "threshold": {
                                    "type": "number"
                                },
                                "value": {
                                    "type": ["string", "number"]
                                }
                            }
                        },
                        "overflow": {
                            "enum": ["other", "shape", "extend"]
                        },
                        "missing": {
                            "oneOf": [
                                {
                                    "const": "skip"
                                },
                                {
                                    "type": "object",
                                    "required": ["value"],
                                    "properties": {
                                        "value": {
                                            "type": ["string", "number"]
                                        }
                                    }
                                }
                            ]
                        },
                        "reverse": {
                            "type": "boolean"
                        },
                        "midpoint": {
                            "type": "number"
                        },
                        "bins": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "exponent": {
                            "type": "number"
                        },
                        "legend": {
                            "type": "object",
                            "properties": {
                                "title": {
                                    "type": "string"
                                },
                                "units": {
                                    "type": "string"
                                },
                                "missingLabel": {
                                    "type": "string"
                                },
                                "hidden": {
                                    "type": "boolean"
                                },
                                "labels": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "type": "string",
                                        "maxLength": 1024
                                    },
                                    "description": "Display text per category value, keyed by the value as text. Never changes what is painted."
                                }
                            }
                        }
                    },
                    "not": {
                        "required": ["domain", "clamp"],
                        "properties": {
                            "domain": {
                                "type": "array"
                            }
                        }
                    }
                }
            ]
        },
        "encoding": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/$defs/channelName"
            },
            "additionalProperties": {
                "$ref": "#/$defs/binding"
            }
        },
        "channelName": {
            "enum": [
                "node.color",
                "node.size",
                "node.shape",
                "node.label",
                "node.labelStyle",
                "node.tooltip",
                "node.tooltipStyle",
                "node.opacity",
                "node.outline",
                "node.glow",
                "node.glowStrength",
                "node.wireframe",
                "node.flat",
                "edge.color",
                "edge.width",
                "edge.opacity",
                "edge.style",
                "edge.patternCount",
                "edge.curvature",
                "edge.arrowHead",
                "edge.arrowHeadSize",
                "edge.arrowHeadColor",
                "edge.arrowHeadOpacity",
                "edge.arrowHeadText",
                "edge.arrowHeadTextStyle",
                "edge.arrowTail",
                "edge.arrowTailSize",
                "edge.arrowTailColor",
                "edge.arrowTailOpacity",
                "edge.arrowTailText",
                "edge.arrowTailTextStyle",
                "edge.animationSpeed",
                "edge.label",
                "edge.labelStyle"
            ]
        },
        "palette": {
            "type": "object",
            "required": ["id", "plainName", "kind", "colors", "capacity", "colorblindSafe"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "plainName": {
                    "type": "string"
                },
                "kind": {
                    "enum": ["sequential", "diverging", "categorical"]
                },
                "colors": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                        "type": "string"
                    }
                },
                "capacity": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "colorblindSafe": {
                    "type": "array",
                    "items": {
                        "enum": ["deuteranopia", "protanopia", "tritanopia"]
                    }
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "https://graphty.app/schema/documents/common/v1.json#/$defs/metadata"
        }
    ]
}
