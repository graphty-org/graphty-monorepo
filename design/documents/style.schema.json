{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/graphty-style/v1.json",
    "title": "graphty style member, version 1",
    "description": "A portable stack of style layers (style.md). Normative for what a writer produces. A reader applies it per layer: a layer that fails is added disabled with its reason, and only a failure of the member's own top level refuses the member. Every style document graphty-element 2.x writes is a valid version 1 style once kind is added, except a layer selecting edges by session edge id (style.md, 'Selectors'). The value lists of this schema (channel names, node shapes, line patterns, arrows, selector kinds) grow within version 1 when graphty-element adds a value; a reader that does not know a value fails that layer or channel alone (container.md, 'Versions' rule 2).",
    "type": "object",
    "required": ["kind", "version", "layers"],
    "properties": {
        "kind": {
            "const": "graphty-style",
            "description": "Required in a document. A file holding only a 2.x style with no kind is read as a style of version 1 (container.md, 'Reading a file')."
        },
        "version": {
            "const": 1
        },
        "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
            "description": "The style's identity across saves: a reverse-domain name (org.example-lab.expression-overlay) is recommended. It is the template id of its layers, so opening a style whose id is already applied from the same place replaces the earlier layers by default (style.md, 'Reading and applying' rule 9). Ids starting graphty. or graphty:, and ids holding graphty.app followed by /, :, . or the end, in any case, are reserved.",
            "not": {
                "pattern": "^[Gg][Rr][Aa][Pp][Hh][Tt][Yy][.:]|[Gg][Rr][Aa][Pp][Hh][Tt][Yy][.][Aa][Pp][Pp]([/:.]|$)"
            }
        },
        "styleVersion": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
            "description": "A SemVer 2.0.0 version of this look. Informational: shown in reports and kept on save; it never decides what an opening replaces."
        },
        "name": {
            "type": "string",
            "maxLength": 1024
        },
        "description": {
            "type": "string",
            "maxLength": 65536
        },
        "layers": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "$ref": "#/$defs/layer"
            }
        },
        "palettes": {
            "type": "array",
            "maxItems": 100,
            "items": {
                "$ref": "#/$defs/palette"
            }
        },
        "extensions": {
            "$ref": "https://graphty.app/schema/documents/graphty-document/v1.json#/$defs/extensions"
        }
    },
    "$defs": {
        "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "A path over {data, results}: data.<column> or results.<run id>.<field>. A path with neither prefix is read as data.<path>, as graphty-element 2.x reads it; a writer writes the prefix. On a node, data.id reads the node's id when the node has no column id; on an edge, data.source and data.target read its ends when it has no such column (style.md, 'Paths')."
        },
        "runId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 128
        },
        "nodeId": {
            "type": ["string", "number"]
        },
        "layer": {
            "type": "object",
            "required": ["name", "selector"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$",
                    "description": "An authored key for the layer, unique within the member and stable across saves. graphty-element stores it on the layer and writes it back."
                },
                "name": {
                    "type": "string",
                    "maxLength": 1024
                },
                "target": {
                    "enum": ["node", "edge"]
                },
                "kind": {
                    "enum": ["base", "encoding", "highlight", "custom"]
                },
                "selector": {
                    "$ref": "#/$defs/selector"
                },
                "set": {
                    "$ref": "#/$defs/staticStyle"
                },
                "encode": {
                    "$ref": "#/$defs/encoding"
                },
                "source": {
                    "$ref": "#/$defs/layerSource"
                },
                "enabled": {
                    "type": "boolean"
                },
                "userData": {
                    "type": "object"
                }
            },
            "anyOf": [
                {
                    "required": ["set"]
                },
                {
                    "required": ["encode"]
                }
            ]
        },
        "selector": {
            "type": "object",
            "required": ["match"],
            "properties": {
                "match": {
                    "type": "string"
                }
            },
            "oneOf": [
                {
                    "properties": {
                        "match": {
                            "const": "expression"
                        },
                        "where": {
                            "$ref": "#/$defs/expression"
                        }
                    },
                    "required": ["where"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "has"
                        },
                        "path": {
                            "$ref": "#/$defs/path"
                        }
                    },
                    "required": ["path"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "ids"
                        },
                        "nodes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/nodeId"
                            },
                            "maxItems": 100000
                        }
                    },
                    "not": {
                        "required": ["edges"]
                    },
                    "description": "Particular nodes, by id. Edges are not selected by id in version 1: the edge ids graphty-element 2.x writes are session counters that name a different edge after a reload."
                },
                {
                    "properties": {
                        "match": {
                            "const": "top"
                        },
                        "path": {
                            "allOf": [
                                {
                                    "$ref": "#/$defs/path"
                                },
                                {
                                    "type": "string",
                                    "pattern": "^results\\."
                                }
                            ]
                        },
                        "n": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "required": ["path", "n"]
                },
                {
                    "properties": {
                        "match": {
                            "const": "everything"
                        }
                    }
                },
                {
                    "properties": {
                        "match": {
                            "const": "member"
                        },
                        "of": {
                            "$ref": "#/$defs/scope"
                        }
                    },
                    "required": ["of"]
                }
            ],
            "unevaluatedProperties": false,
            "description": "Closed: a validator refuses a member no selector kind has, which a reader only warns about (container.md, 'Unknown object members')."
        },
        "scope": {
            "oneOf": [
                {
                    "enum": ["visible", "graph", "selection", "largest-component"]
                },
                {
                    "type": "object",
                    "required": ["set"],
                    "properties": {
                        "set": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["where"],
                    "properties": {
                        "where": {
                            "type": "string"
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["nodes"],
                    "properties": {
                        "nodes": {
                            "type": "array",
                            "items": {
                                "$ref": "#/$defs/nodeId"
                            }
                        }
                    }
                },
                {
                    "type": "object",
                    "required": ["define"],
                    "properties": {
                        "define": {
                            "type": "object"
                        }
                    }
                }
            ]
        },
        "layerSource": {
            "type": "object",
            "required": ["by"],
            "oneOf": [
                {
                    "properties": {
                        "by": {
                            "const": "run"
                        },
                        "runId": {
                            "$ref": "#/$defs/runId"
                        },
                        "algorithm": {
                            "type": "string",
                            "maxLength": 256
                        },
                        "params": {
                            "type": "object"
                        }
                    },
                    "required": ["runId", "algorithm", "params"]
                },
                {
                    "properties": {
                        "by": {
                            "const": "user"
                        }
                    }
                },
                {
                    "properties": {
                        "by": {
                            "const": "template"
                        },
                        "templateId": {
                            "type": "string"
                        }
                    },
                    "required": ["templateId"]
                },
                {
                    "properties": {
                        "by": {
                            "const": "plugin"
                        },
                        "name": {
                            "type": "string"
                        }
                    },
                    "required": ["name"]
                }
            ]
        },
        "rgba": {
            "type": "object",
            "required": ["r", "g", "b", "a"],
            "properties": {
                "r": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "g": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "b": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "a": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            }
        },
        "color": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "#/$defs/rgba"
                }
            ]
        },
        "labelStyle": {
            "type": "object",
            "properties": {
                "sizePx": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 512
                },
                "padding": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                },
                "borderWidth": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                },
                "shadowBlur": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 64
                }
            }
        },
        "unit": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
        },
        "nonNegative": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
        },
        "staticStyle": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "node.color": {
                    "$ref": "#/$defs/color"
                },
                "node.size": {
                    "$ref": "#/$defs/nonNegative"
                },
                "node.shape": {
                    "enum": [
                        "box",
                        "sphere",
                        "cylinder",
                        "cone",
                        "capsule",
                        "torus",
                        "torus-knot",
                        "tetrahedron",
                        "octahedron",
                        "dodecahedron",
                        "icosahedron",
                        "rhombicuboctahedron",
                        "triangular_prism",
                        "pentagonal_prism",
                        "hexagonal_prism",
                        "square_pyramid",
                        "pentagonal_pyramid",
                        "triangular_dipyramid",
                        "pentagonal_dipyramid",
                        "elongated_square_dipyramid",
                        "elongated_pentagonal_dipyramid",
                        "elongated_pentagonal_cupola",
                        "goldberg",
                        "icosphere",
                        "geodesic"
                    ]
                },
                "node.label": {
                    "type": "string",
                    "maxLength": 1024
                },
                "node.labelStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "node.tooltip": {
                    "type": "string",
                    "maxLength": 1024
                },
                "node.tooltipStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "node.opacity": {
                    "$ref": "#/$defs/unit"
                },
                "node.outline": {
                    "$ref": "#/$defs/color"
                },
                "node.glow": {
                    "$ref": "#/$defs/color"
                },
                "node.glowStrength": {
                    "$ref": "#/$defs/nonNegative"
                },
                "node.wireframe": {
                    "type": "boolean"
                },
                "node.flat": {
                    "type": "boolean"
                },
                "edge.color": {
                    "$ref": "#/$defs/color"
                },
                "edge.width": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.opacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.style": {
                    "enum": ["solid", "dot", "star", "box", "dash", "diamond", "dash-dot", "sinewave", "zigzag"]
                },
                "edge.patternCount": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 1000
                },
                "edge.curvature": {
                    "type": "boolean"
                },
                "edge.arrowHead": {
                    "enum": [
                        "normal",
                        "inverted",
                        "dot",
                        "sphere-dot",
                        "open-dot",
                        "none",
                        "tee",
                        "open-normal",
                        "diamond",
                        "open-diamond",
                        "crow",
                        "box",
                        "half-open",
                        "vee"
                    ]
                },
                "edge.arrowHeadSize": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.arrowHeadColor": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowHeadOpacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.arrowHeadText": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.arrowHeadTextStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "edge.arrowTail": {
                    "enum": [
                        "normal",
                        "inverted",
                        "dot",
                        "sphere-dot",
                        "open-dot",
                        "none",
                        "tee",
                        "open-normal",
                        "diamond",
                        "open-diamond",
                        "crow",
                        "box",
                        "half-open",
                        "vee"
                    ]
                },
                "edge.arrowTailSize": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.arrowTailColor": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowTailOpacity": {
                    "$ref": "#/$defs/unit"
                },
                "edge.arrowTailText": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.arrowTailTextStyle": {
                    "$ref": "#/$defs/labelStyle"
                },
                "edge.animationSpeed": {
                    "$ref": "#/$defs/nonNegative"
                },
                "edge.label": {
                    "type": "string",
                    "maxLength": 1024
                },
                "edge.labelStyle": {
                    "$ref": "#/$defs/labelStyle"
                }
            }
        },
        "binding": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["value"],
                    "properties": {
                        "value": {}
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["by"],
                    "properties": {
                        "by": {
                            "$ref": "#/$defs/path"
                        },
                        "scale": {
                            "type": "string"
                        },
                        "palette": {
                            "type": "string"
                        },
                        "domain": {
                            "oneOf": [
                                {
                                    "const": "auto"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                }
                            ]
                        },
                        "clamp": {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "minItems": 2,
                            "maxItems": 2,
                            "description": "Two percentiles of the values present, lower first."
                        },
                        "range": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "map": {
                            "type": "object",
                            "additionalProperties": {
                                "type": ["string", "number"]
                            },
                            "maxProperties": 1000
                        },
                        "other": {
                            "type": "object",
                            "required": ["threshold", "value"],
                            "properties": {
                                "threshold": {
                                    "type": "number"
                                },
                                "value": {
                                    "type": ["string", "number"]
                                }
                            },
                            "additionalProperties": false
                        },
                        "overflow": {
                            "enum": ["other", "shape", "extend"]
                        },
                        "missing": {
                            "oneOf": [
                                {
                                    "const": "skip"
                                },
                                {
                                    "type": "object",
                                    "required": ["value"],
                                    "properties": {
                                        "value": {
                                            "type": ["string", "number"]
                                        }
                                    }
                                }
                            ]
                        },
                        "reverse": {
                            "type": "boolean"
                        },
                        "midpoint": {
                            "type": "number"
                        },
                        "bins": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 256
                        },
                        "exponent": {
                            "type": "number"
                        }
                    },
                    "not": {
                        "required": ["domain", "clamp"],
                        "properties": {
                            "domain": {
                                "type": "array"
                            }
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "encoding": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/$defs/channelName"
            },
            "additionalProperties": {
                "$ref": "#/$defs/binding"
            }
        },
        "channelName": {
            "enum": [
                "node.color",
                "node.size",
                "node.shape",
                "node.label",
                "node.labelStyle",
                "node.tooltip",
                "node.tooltipStyle",
                "node.opacity",
                "node.outline",
                "node.glow",
                "node.glowStrength",
                "node.wireframe",
                "node.flat",
                "edge.color",
                "edge.width",
                "edge.opacity",
                "edge.style",
                "edge.patternCount",
                "edge.curvature",
                "edge.arrowHead",
                "edge.arrowHeadSize",
                "edge.arrowHeadColor",
                "edge.arrowHeadOpacity",
                "edge.arrowHeadText",
                "edge.arrowHeadTextStyle",
                "edge.arrowTail",
                "edge.arrowTailSize",
                "edge.arrowTailColor",
                "edge.arrowTailOpacity",
                "edge.arrowTailText",
                "edge.arrowTailTextStyle",
                "edge.animationSpeed",
                "edge.label",
                "edge.labelStyle"
            ]
        },
        "palette": {
            "type": "object",
            "required": ["id", "plainName", "kind", "colors", "capacity", "colorblindSafe"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "plainName": {
                    "type": "string",
                    "maxLength": 1024
                },
                "kind": {
                    "enum": ["sequential", "diverging", "categorical"]
                },
                "colors": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 256,
                    "items": {
                        "type": "string",
                        "maxLength": 64
                    }
                },
                "capacity": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "colorblindSafe": {
                    "type": "array",
                    "items": {
                        "enum": ["deuteranopia", "protanopia", "tritanopia"]
                    },
                    "description": "The colour-vision deficiencies the palette stays distinct under. [] means untested, not unsafe."
                }
            },
            "additionalProperties": false
        },
        "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "A predicate in graphty-element's expression language, a subset of JMESPath with no functions (style.md, 'Expressions'), over {data, results} (style.md, 'Paths'); at most 1024 characters and 32 levels of nesting."
        }
    }
}
