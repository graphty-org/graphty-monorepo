{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphty.app/schemas/extensions/descriptors-1.json",
  "title": "graphty-element extension descriptors",
  "description": "Serialised form of every catalogue descriptor an extension contributes. Normative for what may be published or persisted; see design/extensions/README.md section 1. Objects are open: a reader MUST ignore unknown members, a writer MUST NOT add members this version does not define.",
  "$defs": {
    "OptionBound": {
      "type": "object",
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string",
          "description": "graph.nodeCount, graph.edgeCount, graph.maxDegree, graph.maxCore, graph.componentCount; open union"
        }
      }
    },
    "OptionChoice": {
      "type": "object",
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "OptionDescriptor": {
      "type": "object",
      "required": [
        "name",
        "plainName",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "technicalName": {
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "enum",
            "seed",
            "node-id",
            "node-set",
            "attribute",
            "partition",
            "ordering",
            "unknown"
          ]
        },
        "default": {},
        "min": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/OptionBound"
            }
          ]
        },
        "max": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/OptionBound"
            }
          ]
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OptionChoice"
          }
        },
        "attributeType": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "time",
            "category",
            "mixed"
          ]
        },
        "group": {
          "type": "string"
        },
        "advanced": {
          "type": "boolean"
        },
        "internal": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "unsupportedReason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ],
            "properties": {
              "values": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "required": [
              "unsupportedReason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "unsupportedReason"
              ]
            }
          }
        }
      ]
    },
    "Options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OptionDescriptor"
      }
    },
    "PaletteDescriptor": {
      "type": "object",
      "required": [
        "id",
        "plainName",
        "kind",
        "colors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "sequential",
            "diverging",
            "categorical"
          ]
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "As authored: any CSS colour. As published: six-digit hex; registered palettes are normalised to upper case, built-in palettes use both cases today. Compare case-insensitively."
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Derived: colors.length for categorical, null otherwise. A written value that disagrees is refused."
        },
        "colorblindSafe": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "deuteranopia",
              "protanopia",
              "tritanopia"
            ]
          }
        },
        "requires": {
          "type": "string",
          "description": "PROPOSED, open decision 3"
        },
        "version": {
          "type": "string",
          "description": "PROPOSED, open decision 3"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "categorical"
              }
            }
          },
          "then": {
            "properties": {
              "capacity": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "capacity": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "PublishedPaletteDescriptor": {
      "allOf": [
        {
          "$ref": "#/$defs/PaletteDescriptor"
        },
        {
          "required": [
            "capacity",
            "colorblindSafe"
          ],
          "properties": {
            "colors": {
              "items": {
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      ]
    },
    "FormatDescriptor": {
      "type": "object",
      "required": [
        "id",
        "plainName",
        "extensions",
        "mimeTypes",
        "canImport",
        "canExport",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[^A-Z]+$"
          }
        },
        "mimeTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
          }
        },
        "canImport": {
          "type": "boolean"
        },
        "canExport": {
          "type": "boolean"
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "requires": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "CameraDescriptor": {
      "type": "object",
      "required": [
        "id",
        "plainName",
        "description",
        "modes",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "2d",
              "3d"
            ]
          }
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "requires": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "LayoutDescriptor": {
      "type": "object",
      "required": [
        "honoursWeights",
        "scoped"
      ],
      "properties": {
        "honoursWeights": {
          "type": "boolean",
          "description": "Derived from the class's static honoursWeights."
        },
        "scoped": {
          "type": "boolean",
          "description": "Derived from the class's static scoped."
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/LayoutDescriptorBase"
        }
      ]
    },
    "AuthoredLayoutDescriptor": {
      "description": "What a layout class writes: LayoutDescriptor without honoursWeights and scoped, which register derives from the class statics.",
      "allOf": [
        {
          "$ref": "#/$defs/LayoutDescriptorBase"
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "honoursWeights"
            ]
          },
          {
            "required": [
              "scoped"
            ]
          }
        ]
      }
    },
    "FieldDescriptor": {
      "type": "object",
      "required": [
        "name",
        "plainName",
        "technicalName",
        "kind",
        "type",
        "path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string"
        },
        "technicalName": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "node",
            "edge",
            "graph"
          ]
        },
        "type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "table"
          ]
        },
        "unit": {
          "type": "string"
        },
        "normalization": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AlgorithmDescriptor": {
      "type": "object",
      "required": [
        "key",
        "plainName",
        "technicalName",
        "description",
        "category",
        "shape",
        "fields",
        "options",
        "costClass",
        "complexity"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "technicalName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "description": "centrality, community, path, flow, structure, prediction; open union"
        },
        "shape": {
          "type": "string",
          "description": "node-metric, edge-metric, community, layered-grouping, category-table, path, node-set, edge-set, pair-list, temporal, fact; open union for readers"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldDescriptor"
          }
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "costClass": {
          "enum": [
            "instant",
            "iterative",
            "heavy",
            "cubic",
            "unbounded"
          ]
        },
        "complexity": {
          "type": "string"
        },
        "approximable": {
          "type": "object",
          "required": [
            "method",
            "plainName",
            "defaultSample",
            "seeded"
          ],
          "properties": {
            "method": {
              "type": "string"
            },
            "plainName": {
              "type": "string"
            },
            "defaultSample": {
              "type": "number"
            },
            "seeded": {
              "type": "boolean"
            }
          }
        },
        "requires": {
          "type": "object",
          "properties": {
            "directed": {
              "type": "boolean"
            },
            "weighted": {
              "type": "boolean"
            },
            "accelerator": {
              "type": "boolean"
            },
            "connected": {
              "type": "boolean"
            }
          },
          "description": "Preconditions of the algorithm. NOT the proposed host-compatibility range, which for algorithms is the class static requiresApi (open decision 3)."
        },
        "scopeInput": {
          "type": "string",
          "description": "Derived from the class's static scopeInput: none or subgraph; open union (mask reserved), unknown reads as none."
        }
      },
      "not": {
        "required": [
          "cost"
        ]
      }
    },
    "LogSinkDescriptor": {
      "type": "object",
      "required": [
        "id",
        "plainName",
        "description",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "PROPOSED, open decision 13: origins the destination may send records to."
        },
        "requires": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "forwardsData": {
          "type": "boolean",
          "description": "PROPOSED, open decision 13: whether LogRecord.data leaves the page."
        }
      }
    },
    "LayoutDescriptorBase": {
      "description": "The members every layout descriptor has.",
      "type": "object",
      "required": [
        "id",
        "plainName",
        "technicalName",
        "description",
        "family",
        "kind",
        "maxDimensions",
        "sizeRating",
        "structuralInputs",
        "options",
        "engine"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "plainName": {
          "type": "string",
          "minLength": 1
        },
        "technicalName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "live",
            "batch"
          ]
        },
        "maxDimensions": {
          "enum": [
            2,
            3
          ]
        },
        "sizeRating": {
          "enum": [
            "any",
            10000,
            2000,
            500
          ]
        },
        "structuralInputs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "node",
              "partition",
              "ordering"
            ]
          }
        },
        "options": {
          "$ref": "#/$defs/Options"
        },
        "engine": {
          "type": "string"
        },
        "requires": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
