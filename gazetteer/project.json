{
    "name": "gazetteer",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "gazetteer/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/dist"],
            "inputs": [
                "buildSources",
                "^buildSources",
                { "runtime": "node --version" },
                "{workspaceRoot}/tools/build-bundle.mjs"
            ],
            "options": {
                "command": "npm run build:all",
                "cwd": "gazetteer"
            },
            "dependsOn": ["^build"]
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run test:run",
                "cwd": "gazetteer"
            }
        },
        "coverage": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run coverage",
                "cwd": "gazetteer"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run lint",
                "cwd": "gazetteer"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run typecheck",
                "cwd": "gazetteer"
            }
        }
    }
}
