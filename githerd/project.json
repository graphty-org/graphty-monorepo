{
    "name": "githerd",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "githerd/lib",
    "tags": [],
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run test:run",
                "cwd": "githerd"
            }
        },
        "coverage": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run coverage",
                "cwd": "githerd"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run lint",
                "cwd": "githerd"
            }
        }
    }
}
