{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "target": "ES2023",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["bin/**/*.mjs", "lib/**/*.mjs"]
}
