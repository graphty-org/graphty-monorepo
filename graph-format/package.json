{
    "name": "@graphty/graph-format",
    "version": "1.5.2",
    "description": "Frozen CSR graph data format over typed arrays, shared by CPU and WebGPU graph algorithms",
    "author": "Adam Powers <apowers@ato.ms>",
    "type": "module",
    "main": "dist/graph-format.js",
    "types": "dist/graph-format.d.ts",
    "exports": {
        ".": {
            "types": "./dist/graph-format.d.ts",
            "import": "./dist/graph-format.js",
            "default": "./dist/graph-format.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist/",
        "!dist/*.tsbuildinfo",
        "!dist/src/**/*.js",
        "!dist/src/**/*.js.map",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
        "build:bundle": "node scripts/build-bundle.js",
        "build:all": "npm run build && npm run build:bundle",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "typecheck:strict-consumer": "node ../tools/require-built.mjs tsconfig.strict-consumer.json && tsc -p tsconfig.strict-consumer.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "benchmark": "tsx benchmarks/run.ts",
        "ready:commit": "npm run build:all && npm run lint && npm run typecheck:strict-consumer && npm run test:run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "graph-format"
    },
    "keywords": [
        "graph",
        "csr",
        "compressed-sparse-row",
        "typed-array",
        "webgpu",
        "graph-format"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/graph-format#readme",
    "devDependencies": {
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "@webgpu/types": "^0.1.74",
        "eslint": "^9.39.5",
        "fast-check": "^4.10.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "vite": "^8.3.8",
        "vitest": "catalog:",
        "webgpu": "^0.6.2"
    }
}
