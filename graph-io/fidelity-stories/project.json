{
    "name": "graph-io-fidelity",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "application",
    "sourceRoot": "graph-io/fidelity-stories/stories",
    "tags": [],
    "targets": {
        "build-storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run build-storybook",
                "cwd": "graph-io/fidelity-stories"
            },
            "dependsOn": ["^build"]
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run lint",
                "cwd": "graph-io/fidelity-stories"
            },
            "dependsOn": ["^build"]
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run typecheck",
                "cwd": "graph-io/fidelity-stories"
            },
            "dependsOn": ["^build"]
        }
    }
}
