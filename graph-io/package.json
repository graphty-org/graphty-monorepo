{
    "name": "@graphty/graph-io",
    "version": "0.3.20",
    "description": "Read and write graph files (GraphML, GEXF, CSV, JSON, GML, DOT, Pajek, Neo4j CSV, XGMML, CX, CX2, OBO, Cytoscape sessions) as @graphty/graph-format snapshots",
    "author": "Adam Powers <apowers@ato.ms>",
    "type": "module",
    "main": "dist/graph-io.js",
    "types": "dist/graph-io.d.ts",
    "exports": {
        ".": {
            "types": "./dist/graph-io.d.ts",
            "import": "./dist/graph-io.js",
            "default": "./dist/graph-io.js"
        },
        "./gexf": {
            "types": "./dist/gexf.d.ts",
            "import": "./dist/gexf.js",
            "default": "./dist/gexf.js"
        },
        "./graphml": {
            "types": "./dist/graphml.d.ts",
            "import": "./dist/graphml.js",
            "default": "./dist/graphml.js"
        },
        "./gml": {
            "types": "./dist/gml.d.ts",
            "import": "./dist/gml.js",
            "default": "./dist/gml.js"
        },
        "./dot": {
            "types": "./dist/dot.d.ts",
            "import": "./dist/dot.js",
            "default": "./dist/dot.js"
        },
        "./pajek": {
            "types": "./dist/pajek.d.ts",
            "import": "./dist/pajek.js",
            "default": "./dist/pajek.js"
        },
        "./csv": {
            "types": "./dist/csv.d.ts",
            "import": "./dist/csv.js",
            "default": "./dist/csv.js"
        },
        "./json": {
            "types": "./dist/json.d.ts",
            "import": "./dist/json.js",
            "default": "./dist/json.js"
        },
        "./neo4j": {
            "types": "./dist/neo4j.d.ts",
            "import": "./dist/neo4j.js",
            "default": "./dist/neo4j.js"
        },
        "./xgmml": {
            "types": "./dist/xgmml.d.ts",
            "import": "./dist/xgmml.js",
            "default": "./dist/xgmml.js"
        },
        "./cx2": {
            "types": "./dist/cx2.d.ts",
            "import": "./dist/cx2.js",
            "default": "./dist/cx2.js"
        },
        "./cx": {
            "types": "./dist/cx.d.ts",
            "import": "./dist/cx.js",
            "default": "./dist/cx.js"
        },
        "./obo": {
            "types": "./dist/obo.d.ts",
            "import": "./dist/obo.js",
            "default": "./dist/obo.js"
        },
        "./cys": {
            "types": "./dist/cys.d.ts",
            "import": "./dist/cys.js",
            "default": "./dist/cys.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist/",
        "!dist/*.tsbuildinfo",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
        "build:bundle": "node scripts/build-bundle.js",
        "build:all": "npm run build && npm run build:bundle",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "typecheck:strict-consumer": "tsc -p tsconfig.strict-consumer.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "benchmark": "tsx benchmarks/run.ts",
        "docs:reference": "tsx scripts/docs-reference.ts",
        "docs:api": "tsx scripts/docs-reference.ts --check && typedoc && node ../tools/sanitize-api-docs.js docs/api/generated",
        "ready:commit": "npm run build:all && npm run lint && npm run typecheck:strict-consumer && npm run test:run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "graph-io"
    },
    "keywords": [
        "graph",
        "gexf",
        "graphml",
        "gml",
        "dot",
        "graphviz",
        "pajek",
        "csv",
        "json",
        "neo4j",
        "xgmml",
        "cys",
        "cytoscape",
        "graph-format"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://graphty.app/docs/graph-io/",
    "dependencies": {
        "@graphty/graph-format": "workspace:^"
    },
    "peerDependencies": {
        "@graphty/graph-format": "^1.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "eslint": "^9.29.0",
        "fast-check": "^4.2.0",
        "fast-xml-parser": "^5.11.1",
        "prettier": "^3.4.2",
        "tsx": "^4.20.3",
        "typedoc": "^0.28.15",
        "typescript": "^5.9.3",
        "vite": "^7.0.5",
        "vitest": "catalog:"
    }
}
