{
    "name": "graph-io",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "graph-io/src",
    "projectType": "library",
    "tags": [],
    "implicitDependencies": ["!graphty-element"],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/dist"],
            "inputs": [
                "buildSources",
                "^buildSources",
                { "runtime": "node --version" },
                "{workspaceRoot}/tools/build-bundle.mjs"
            ],
            "options": {
                "command": "npm run build:all",
                "cwd": "graph-io"
            },
            "dependsOn": ["^build"]
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run test:run",
                "cwd": "graph-io"
            }
        },
        "test:ui": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest --ui",
                "cwd": "graph-io"
            }
        },
        "coverage": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run coverage",
                "cwd": "graph-io"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run lint",
                "cwd": "graph-io"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run typecheck",
                "cwd": "graph-io"
            }
        },
        "build-storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run build-storybook",
                "cwd": "graph-io"
            },
            "dependsOn": ["build", { "projects": ["graphty-element"], "target": "build" }],
            "outputs": ["{projectRoot}/fidelity-stories/storybook-static"]
        },
        "storybook": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run storybook",
                "cwd": "graph-io"
            }
        },
        "benchmark": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run benchmark",
                "cwd": "graph-io"
            }
        }
    }
}
