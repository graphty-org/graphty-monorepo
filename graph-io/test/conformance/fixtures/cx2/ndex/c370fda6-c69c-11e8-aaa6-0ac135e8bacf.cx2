vp":2.0},{"v":"0.97","vp":5.0},{"v":"1.00","vp":8.0},{"v":"0.98","vp":6.0},{"v":"0.95","vp":3.0},{"v":"0.96","vp":4.0}],"attribute":"Belief score"}},"EDGE_SOURCE_ARROW_SHAPE":{"type":"DISCRETE","definition":{"map":[{"v":"Complex","vp":"circle"}],"attribute":"type"}},"EDGE_LINE_COLOR":{"type":"DISCRETE","definition":{"map":[{"v":"Modification","vp":"#000000"},{"v":"IncreaseAmount","vp":"#009900"},{"v":"Gap","vp":"#CC0033"},{"v":"Gef","vp":"#000000"},{"v":"Activation","vp":"#009900"},{"v":"Inhibition","vp":"#CC0033"},{"v":"Complex","vp":"#6699FF"},{"v":"DecreaseAmount","vp":"#CC0033"}],"attribute":"type"}},"EDGE_SOURCE_ARROW_COLOR":{"type":"DISCRETE","definition":{"map":[{"v":"Modification","vp":"#000000"},{"v":"IncreaseAmount","vp":"#009900"},{"v":"Gap","vp":"#CC0033"},{"v":"Gef","vp":"#000000"},{"v":"Activation","vp":"#009900"},{"v":"Inhibition","vp":"#CC0033"},{"v":"Complex","vp":"#6699FF"},{"v":"DecreaseAmount","vp":"#CC0033"}],"attribute":"type"}},"EDGE_LINE_STYLE":{"type":"DISCRETE","definition":{"map":[{"v":"IncreaseAmount","vp":"dashed"},{"v":"DecreaseAmount","vp":"dashed"}],"attribute":"type"}},"EDGE_TARGET_ARROW_COLOR":{"type":"DISCRETE","definition":{"map":[{"v":"Modification","vp":"#000000"},{"v":"IncreaseAmount","vp":"#009900"},{"v":"Gap","vp":"#CC0033"},{"v":"Gef","vp":"#000000"},{"v":"Activation","vp":"#009900"},{"v":"Inhibition","vp":"#CC0033"},{"v":"Complex","vp":"#6699FF"},{"v":"DecreaseAmount","vp":"#CC0033"}],"attribute":"type"}}},"nodeMapping":{"NODE_LABEL":{"type":"PASSTHROUGH","definition":{"attribute":"name"}},"NODE_SHAPE":{"type":"DISCRETE","definition":{"map":[{"v":"other","vp":"hexagon"},{"v":"chemical","vp":"ellipse"},{"v":"protein","vp":"round-rectangle"},{"v":"proteinfamily","vp":"round-rectangle"},{"v":"bioprocess","vp":"diamond"}],"attribute":"type"}}}}]},
