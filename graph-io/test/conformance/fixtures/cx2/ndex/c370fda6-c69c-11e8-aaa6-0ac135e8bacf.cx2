":691,"x":-273.20744926452636,"y":76.4807904434204,"v":{"n":"Cyclin","type":"proteinfamily","FPLX":"http://identifiers.org/fplx/Cyclin"}},{"id":696,"x":131.56354301452637,"y":87.69603092193603,"v":{"n":"GDF15","UniProt":"http://identifiers.org/uniprot/Q99988","type":"protein","HGNC":"http://identifiers.org/hgnc/HGNC:30142"}},{"id":701,"x":-380.34526664733886,"y":396.097153968811,"v":{"n":"HDAC_I","InterPro":"http://identifiers.org/interpro/IPR003084","type":"proteinfamily","FPLX":"http://identifiers.org/fplx/HDAC_I"}},{"id":702,"x":-291.1877349090576,"y":458.1300824356079,"v":{"n":"BRCA","type":"proteinfamily","FPLX":"http://identifiers.org/fplx/BRCA"}},{"id":706,"x":-208.2355864715576,"y":526.9553998184203,"v":{"n":"PARP1","UniProt":"http://identifiers.org/uniprot/P09874","type":"protein","HGNC":"http://identifiers.org/hgnc/HGNC:270"}},{"id":711,"x":-317.56850273132324,"y":135.19207889556884,"v":{"n":"Proteasome","type":"proteinfamily","FPLX":"http://identifiers.org/fplx/Proteasome"}},{"id":734,"x":234.56723945617676,"y":-171.29414241790772,"v":{"n":"RAD52","UniProt":"http://identifiers.org/uniprot/P43351","type":"protein","HGNC":"http://identifiers.org/hgnc/HGNC:9824"}},{"id":741,"x":-194.12386161804199,"y":168.4955609512329,"v":{"n":"SH","Pfam":"http://identifiers.org/pfam/PF01445","type":"proteinfamily"}}]},
{"edges":[{"id":635,"s":634,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"oxaliplatin\", \"db_refs\": {\"TEXT\": \"oxaliplatin\", \"CHEBI\": \"CHEBI:31941\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"Vorinostat enhances the anticancer effect of oxaliplatin on HCC cells by suppressing the expression of BRCA1 that is induced by oxaliplatin.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"In this study, we showed that BRCA1 expression was upregulated by oxaliplatin exposure alone, whereas vorinostat downregulated BRCA1 expression in the presence or absence of oxaliplatin in HCC cells.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"b7b44375-fdf3-4a39-9fbd-eed0d6b4f063\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Vorinostat enhances the anticancer effect of oxaliplatin on HCC cells by suppressing the expression of BRCA1 that is induced by oxaliplatin.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(oxaliplatin(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":492,"s":490,"t":491,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"ERCC4\", \"db_refs\": {\"UP\": \"Q92889\", \"HGNC\": \"3436\", \"TEXT\": \"XPF\"}}, {\"name\": \"ERCC1\", \"db_refs\": {\"UP\": \"P07992\", \"HGNC\": \"3433\", \"TEXT\": \"ERCC1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29325523\", \"text\": \"Fractionation studies of 3104 fibroblasts showed that residual full-length XPF/ERCC4/FANCQ protein was detectable in the nucleus, while in cells from XP-F or XFE patients the mutant XPF/ERCC4/FANCQ appears to be mislocated and not to be part of the XPF and ERCC1 complex, presumably as a consequence of XPF protein misfolding [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29568775\", \"text\": \"ERCC1 and ERCC4 heterodimer is responsible for the 5 ' site excision while the incision of impaired DNA at the 3 ' site is performed by ERCC5 [XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"956d5816-1e0a-4a95-ad31-20668d80c1f9\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Fractionation studies of 3104 fibroblasts showed that residual full-length XPF/ERCC4/FANCQ protein was detectable in the nucleus, while in cells from XP-F or XFE patients the mutant XPF/ERCC4/FANCQ appears to be mislocated and not to be part of the XPF and ERCC1 complex, presumably as a consequence of XPF protein misfolding [XREF_BIBR].","type":"Complex","INDRA statement":"Complex(ERCC4(), ERCC1())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":742,"s":741,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"SH\", \"db_refs\": {\"PF\": \"PF01445\", \"TEXT\": \"SH\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29393484\", \"text\": \"SH upregulates Bax and downregulates Bcl-2, cyclin B1, CDK1, Ku-70, Ku-86, and Rad51 in ESCC cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30226618\", \"text\": \"We then investigated the molecular mechanisms underlying the SH mediated cellular sensitization to IR and found that SH inhibited the expression of DNA damage response (DDR) factors Ku80 and Rad51 at the transcription level.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"d804c1b0-7865-43c1-a324-903501ad2c93\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"SH upregulates Bax and downregulates Bcl-2, cyclin B1, CDK1, Ku-70, Ku-86, and Rad51 in ESCC cells.","type":"Inhibition","INDRA statement":"Inhibition(SH(), RAD51())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":614,"s":613,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"SERTAD1\", \"db_refs\": {\"UP\": \"Q9UHV2\", \"HGNC\": \"17932\", \"TEXT\": \"Sei-1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29497033\", \"text\": \"Apart from this, it was shown for the first time that Sei-1 could directly regulate the expression of BRCA1.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29497033\", \"text\": \"This also indicates that Sei-1 can also directly regulate the expression of BRCA1.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ad3bef7d-f82b-498c-ad1f-7d9e5097c9ec\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Apart from this, it was shown for the first time that Sei-1 could directly regulate the expression of BRCA1.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(SERTAD1(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":486,"s":485,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"CCND1\", \"db_refs\": {\"TEXT\": \"CCND1\", \"UP\": \"P24385\", \"HGNC\": \"1582\"}}, {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29416789\", \"text\": \"On the other hand, Marampon et al. also found that, in prostate cancer, CCND1 would bind to RAD51 after the radiation treatment [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416789\", \"text\": \"Previous studies demonstrated that CCND1 bound to BRCA2 and RAD51 after radiation exposure to perform homologous recombination (HR).\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"39fb4a80-f77e-429b-b4a3-3ca85dbe6515\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"On the other hand, Marampon et al. also found that, in prostate cancer, CCND1 would bind to RAD51 after the radiation treatment [XREF_BIBR].","type":"Complex","INDRA statement":"Complex(CCND1(), RAD51())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":236,"s":227,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"RAD51C\", \"db_refs\": {\"UP\": \"O43502\", \"HGNC\": \"9820\", \"TEXT\": \"RAD51C\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Suppression of RAD51C inhibited RAD51 independent (SSA mediated) HR in BAC cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"We also found that suppression of RAD51C in RS2 cells inhibits RAD51 independent HR by> 70% of control cells (XREF_FIG, panel I).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"7c172863-2a3f-49dc-9c07-948454b7b117\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Suppression of RAD51C inhibited RAD51 independent (SSA mediated) HR in BAC cells.","type":"Activation","INDRA statement":"Activation(RAD51C(), RAD51())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":228,"s":227,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"RAD51C\", \"db_refs\": {\"UP\": \"O43502\", \"HGNC\": \"9820\", \"TEXT\": \"RAD51C\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"We also found that suppression of RAD51C in RS2 cells inhibits RAD51 independent HR by> 70% of control cells (XREF_FIG, panel I).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Suppression of RAD51C inhibited RAD51 independent (SSA mediated) HR in BAC cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29729110\", \"text\": \"Importantly, RAD51C serves as a fulcrum for the local recruitment of its partners (XRCC3 for SDSA and RAD51B for SSA), and is positively modulated by PI3K like kinases, to facilitate both the SDSA and SSA pathways in RAD51 paralog dependent somatic HR.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Moreover, suppression of RAD51C in RS2 cells, in which RAD51 is strongly suppressed, also inhibits the elevated HR activity as evident by our HR assay using the substrate plasmid FG1.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"These data show that RAD51C contributes to both HR and SSA in BAC cells and in absence of RAD51, RAD51C shifts the balance of HR towards SSA pathway.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_7_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"c7512007-27f5-4782-8cfd-0f3968ff1834\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We also found that suppression of RAD51C in RS2 cells inhibits RAD51 independent HR by> 70% of control cells (XREF_FIG, panel I).","type":"Activation","INDRA statement":"Activation(RAD51C(), HR())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":735,"s":734,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"RAD52\", \"db_refs\": {\"UP\": \"P43351\", \"HGNC\": \"9824\", \"TEXT\": \"RAD52\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"mutations\": [{\"position\": null, \"residue_from\": null, \"residue_to\": null}], \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29145865\", \"text\": \"Specifically we show that depletion of EEPD1 rescues the synthetic lethality of RAD52 depleted, BRCA1 mutant breast cancer cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29145865\", \"text\": \"EEPD1 depletion restores genome stability in RAD52 depleted BRCA1 mutant breast cancer cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29145865\", \"text\": \"The endonuclease EEPD1 mediates synthetic lethality in RAD52 depleted BRCA1 mutant breast cancer cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29145865\", \"text\": \"Our data show that depletion of EEPD1 suppresses synthetic lethality, genome instability, mitotic catastrophe, and hypersensitivity to stress of replication of RAD52 depleted, BRCA1 mutant breast cancer cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ea69f944-2d43-4b0f-9725-53f77b0e7c91\", \"supported_by\": [\"aa6fbf48-cfab-4bcf-bb34-0fcb643f9e8e\", \"63963920-4d4b-4474-b675-3a8b458ac1d5\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Specifically we show that depletion of EEPD1 rescues the synthetic lethality of RAD52 depleted, BRCA1 mutant breast cancer cells.","type":"Inhibition","INDRA statement":"Inhibition(RAD52(), BRCA1(muts: (None, None, None)))","Belief score":"0.94","polarity":"negative","i":"Inhibition"}},{"id":223,"s":222,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"PDS5A\", \"db_refs\": {\"UP\": \"Q29RF7\", \"HGNC\": \"29088\", \"TEXT\": \"Pds5\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"In RNA-seq experiments described in more detail in a later section, Pds5 depletion increases Brca2 gene transcripts 1.4-fold (XREF_SUPPLEMENTARY, panel I) although Pds5 and cohesin do not bind the Brca2 gene, indicating an indirect effect.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"The modest increase in Brca2 transcripts indicates that the partial decrease in Brca2 protein caused by Pds5 depletion likely represents destabilization of Brca2 protein in the absence of Pds5.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"c0d66f6d-ca47-43cf-8f88-01b356518969\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In RNA-seq experiments described in more detail in a later section, Pds5 depletion increases Brca2 gene transcripts 1.4-fold (XREF_SUPPLEMENTARY, panel I) although Pds5 and cohesin do not bind the Brca2 gene, indicating an indirect effect.","type":"Activation","INDRA statement":"Activation(PDS5A(), BRCA2())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":459,"s":222,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"PDS5A\", \"db_refs\": {\"UP\": \"Q29RF7\", \"HGNC\": \"29088\", \"TEXT\": \"Pds5\"}}, {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"The discovery that Pds5 interacts with Brca2 in a complex that lacks Wapl [XREF_BIBR - XREF_BIBR] raised the question of whether or not Brca2 plays a role in sister chromatid cohesion.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"The potential roles of the Pds5 and Brca2 complex in cohesin dynamics, sister chromatid cohesin and gene transcription have not been explored.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"The Pds5 and Brca2 complex occurs in multiple types of Drosophila and mammalian cells, and Drosophila Brca2 also interacts with mammalian PDS5B and PDS5A [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"Pds5 and Brca2 chromosome binding patterns differ from cohesin and Wapl.\", \"annotations\": {\"found_by\": \"binding5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"We compared the Pds5, Wapl and Brca2 binding patterns to the Rad21 cohesin subunit, and prior ChIP-seq data [XREF_BIBR] for the SA cohesin subunit and Nipped-B.\", \"annotations\": {\"found_by\": \"binding5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"Thus, although Pds5 and Brca2 binding overlap as discussed above, there is a substantial difference in their enrichment at PREs. There are few PREs relative to promoters and enhancers, and it is possible that proteins at PREs recruit Brca2 that is not bound to Pds5.\", \"annotations\": {\"found_by\": \"binding7a\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"The Pds5 and Brca2 complex is important for mitotic DNA repair and homologous recombination during meiosis, corresponding with the known role of Brca2 in DNA repair [XREF_BIBR - XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"491a4aff-9bff-4b30-a647-aacd0ff4f18f\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The discovery that Pds5 interacts with Brca2 in a complex that lacks Wapl [XREF_BIBR - XREF_BIBR] raised the question of whether or not Brca2 plays a role in sister chromatid cohesion.","type":"Complex","INDRA statement":"Complex(PDS5A(), BRCA2())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":217,"s":215,"t":216,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"PALB2\", \"db_refs\": {\"UP\": \"Q86YC2\", \"HGNC\": \"26144\", \"TEXT\": \"PALB2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"invasion\", \"db_refs\": {\"TEXT\": \"invasion\", \"MESH\": \"D009361\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29321957\", \"text\": \"In vitro studies suggested that overexpression of PALB2 promotes the migration and invasion of MDA-MB-231 cells through transcriptional suppression of E-cadherin.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29321957\", \"text\": \"In vitro studies found that PALB2 may promote the migration and invasion of MDA-MB-231 cells through E-cadherin suppression and NF-kappaB activation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29321957\", \"text\": \"PALB2 promoted MDA-MB-231 cell migration and invasion.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3664efea-d7cf-4706-82d5-7471af45d321\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In vitro studies suggested that overexpression of PALB2 promotes the migration and invasion of MDA-MB-231 cells through transcriptional suppression of E-cadherin.","type":"Activation","INDRA statement":"Activation(PALB2(), invasion())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":388,"s":215,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"PALB2\", \"db_refs\": {\"UP\": \"Q86YC2\", \"HGNC\": \"26144\", \"TEXT\": \"PALB2\"}}, {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"These findings emphasise the critical role of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability and prevention of cancer and provide evidence that heterozygosity for rare missense variants of PALB2 may influence cancer risk.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"Conversely, many missense mutations remain as variants of uncertain significance (VUSs), even though the likely impact of PALB2 missense VUSs hindering BRCA2 or BRCA1 interaction is foreseeable based on the importance of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability XREF_BIBR - XREF_BIBR, XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"dbd47552-8842-4c41-b80d-e91cd6dd065d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.","type":"Complex","INDRA statement":"Complex(BRCA1(), PALB2(), BRCA2())","Belief score":"0.94","polarity":"none","i":"Complex"}},{"id":758,"s":207,"t":155,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Ubiquitination\", \"enz\": {\"name\": \"MMC\", \"db_refs\": {\"TEXT\": \"MMC\", \"PUBCHEM\": \"5746\", \"CHEBI\": \"CHEBI:27504\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000460\"}, \"sub\": {\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"FANCD2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000015\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"EDC4 depletion rendered HeLa cells hypersensitive to ICL drugs in terms of cell survival, MMC induced G2/M cell cycle arrest, and DEB induced chromosome fragility, especially chromatid-type aberrations and chromatid-type exchanges, whereas FANCD2 monoubiquitination in response to MMC induced stalled replication forks was not affected.\", \"annotations\": {\"found_by\": \"Ubiquitination_syntax_4_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29231814\", \"text\": \"Transiently genetically complemented cells recovered a significant resistance to MMC (XREF_FIG) as well as an improved monoubiquitination of FANCD2 in response to MMC (XREF_FIG).\", \"annotations\": {\"found_by\": \"Ubiquitination_syntax_1a_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"467b4a5f-4f51-4e7d-a9ea-289b5daff4c1\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000224\"}","Text":"EDC4 depletion rendered HeLa cells hypersensitive to ICL drugs in terms of cell survival, MMC induced G2/M cell cycle arrest, and DEB induced chromosome fragility, especially chromatid-type aberrations and chromatid-type exchanges, whereas FANCD2 monoubiquitination in response to MMC induced stalled replication forks was not affected.","type":"Modification","INDRA statement":"Ubiquitination(MMC(), FANCD2())","Belief score":"0.86","polarity":"positive","i":"Ubiquitination"}},{"id":208,"s":207,"t":155,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"MMC\", \"db_refs\": {\"TEXT\": \"MMC\", \"PUBCHEM\": \"5746\", \"CHEBI\": \"CHEBI:27504\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"FANCD2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29193904\", \"text\": \"FANCD2 foci formation assay also showed the absence of detectable MMC induced FANCD2 foci.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29394375\", \"text\": \"Since MMC induced FANCD2 foci formation is also affected by RNaseHI expression, similar mechanisms likely operate during ICL repair.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29463306\", \"text\": \"Given that MMC induced nuclear foci contain the mono-ubiquitinated form of FANCD2, we tested whether HES1 mono-ubiquitination is required for localization to MMC induced foci.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ce565f6f-bdcd-40c6-a0b6-1ce8d98817b7\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"FANCD2 foci formation assay also showed the absence of detectable MMC induced FANCD2 foci.","type":"Activation","INDRA statement":"Activation(MMC(), FANCD2())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":592,"s":587,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"Curcumin\", \"db_refs\": {\"TEXT\": \"Curcumin\", \"CHEBI\": \"CHEBI:3962\", \"PUBCHEM\": \"969516\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Curcumin increased the expression of BRCA1, BRCA2 and ERCC1 in a concentration dependent manner.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Curcumin activated NER and homologous recombination by up-regulating BRCA1, BRCA2 and ERCC1 expression, thereby improving carboplatin induced myelosuppression to extend the life span of mice.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"99e44a6c-e8da-4394-a171-4c0dcfdf0eec\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Curcumin increased the expression of BRCA1, BRCA2 and ERCC1 in a concentration dependent manner.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(Curcumin(), BRCA2())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":588,"s":587,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"Curcumin\", \"db_refs\": {\"TEXT\": \"Curcumin\", \"CHEBI\": \"CHEBI:3962\", \"PUBCHEM\": \"969516\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Curcumin increased the expression of BRCA1, BRCA2 and ERCC1 in a concentration dependent manner.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Curcumin activated NER and homologous recombination by up-regulating BRCA1, BRCA2 and ERCC1 expression, thereby improving carboplatin induced myelosuppression to extend the life span of mice.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"49b1eac1-b7a3-4788-9abc-d0a9effe6e82\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Curcumin increased the expression of BRCA1, BRCA2 and ERCC1 in a concentration dependent manner.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(Curcumin(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":203,"s":202,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"IRF8\", \"db_refs\": {\"UP\": \"Q02556\", \"HGNC\": \"5358\", \"TEXT\": \"Icsbp\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We previously found that activation of the FANCC promoter by Icsbp was enhanced by tyrosine phosphorylation of this protein during emergency granulopoiesis, identifying roles for enhanced expression and posttranslational modification in this process.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"e39b54ff-dff5-4aae-b8cc-ac44f8874dbe\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.","type":"Activation","INDRA statement":"Activation(IRF8(), FANCC())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":609,"s":202,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"IRF8\", \"db_refs\": {\"UP\": \"Q02556\", \"HGNC\": \"5358\", \"TEXT\": \"Icsbp\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In prior studies, we found that Icsbp activated FANCC and FANCF gene transcription during emergency granulopoiesis (encoding Fanconi C and F, respectively (FancC and FancF)).\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"f3e8f951-1279-4793-83f2-a3885ab1776c\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"In prior studies, we found that Icsbp activated FANCC and FANCF gene transcription during emergency granulopoiesis (encoding Fanconi C and F, respectively (FancC and FancF)).","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(IRF8(), FANCC())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":712,"s":711,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"Proteasome\", \"db_refs\": {\"TEXT\": \"proteasome\", \"FPLX\": \"Proteasome\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"Cyclin A2 mediates MRE11 abundance through its MRE11 mRNA binding property and RAD51 abundance through inhibition of proteasome degradation of RAD51.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_3_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"To assess if proteasome degradation of RAD51 was responsible for its reduction by cyclin A2 depletion, we treated control and cyclin A2 siRNA transfected cells with proteosome inhibitor MG132.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_3_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"c0f919b2-23ad-47b6-9b3a-4296bc2926c1\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Cyclin A2 mediates MRE11 abundance through its MRE11 mRNA binding property and RAD51 abundance through inhibition of proteasome degradation of RAD51.","type":"Inhibition","INDRA statement":"Inhibition(Proteasome(), RAD51())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":707,"s":706,"t":702,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"PARP1\", \"db_refs\": {\"UP\": \"P09874\", \"HGNC\": \"270\", \"TEXT\": \"PARP1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA\", \"db_refs\": {\"TEXT\": \"BRCA\", \"FPLX\": \"BRCA\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29898385\", \"text\": \"Simultaneous Targeting of PARP1 and RAD52 Triggers Dual Synthetic Lethality in BRCA Deficient Tumor Cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29898385\", \"text\": \"Simultaneous targeting of PARP1 and RAD52 with inhibitors or dominant negative mutants caused synergistic accumulation of DSBs and eradication of BRCA deficient but not BRCA-proficient tumor cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3c447c77-fb70-48c4-9de3-7ad9bc67b708\", \"supported_by\": [\"fb7cd81c-d79a-46e8-b080-3d91c1261ef8\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Simultaneous Targeting of PARP1 and RAD52 Triggers Dual Synthetic Lethality in BRCA Deficient Tumor Cells.","type":"Inhibition","INDRA statement":"Inhibition(PARP1(), BRCA())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":703,"s":701,"t":702,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"HDAC_I\", \"db_refs\": {\"FPLX\": \"HDAC_I\", \"IP\": \"IPR003084\", \"TEXT\": \"histone deacetylase\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA\", \"db_refs\": {\"TEXT\": \"BRCA\", \"FPLX\": \"BRCA\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29902865\", \"text\": \"Co-targeting poly (ADP-ribose) polymerase (PARP) and histone deacetylase (HDAC) in triple negative breast cancer : Higher synergism in BRCA mutated cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_7_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4e52276c-0865-4f4c-8aa0-84f4edc8fa9c\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Co-targeting poly (ADP-ribose) polymerase (PARP) and histone deacetylase (HDAC) in triple negative breast cancer : Higher synergism in BRCA mutated cells.","type":"Inhibition","INDRA statement":"Inhibition(HDAC_I(), BRCA())","Belief score":"0.96","polarity":"negative","i":"Inhibition"}},{"id":578,"s":572,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"BRD4\", \"db_refs\": {\"UP\": \"O60885\", \"HGNC\": \"13575\", \"TEXT\": \"BRD4\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30259975\", \"text\": \"Moreover, BRD4 pharmacological inhibition using two BET inhibitors (JQ1 and GSK525762A) induced a dose dependent reduction in BRCA1 and RAD51 levels and is able to hinder homologous recombination mediated DNA damage repair, generating a BRCAness phenotype in TNBC cells.\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29567272\", \"text\": \"In cultured cells, inhibition of BRD4 by siRNA or INCB054329 reduced expression and function of BRCA1 and RAD51, reduced HR reporter activity, and sensitized the cells to olaparib induced growth inhibition, DNA damage induction and apoptosis.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"2548cfeb-1b0f-4583-94e0-9ca5608202c2\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Moreover, BRD4 pharmacological inhibition using two BET inhibitors (JQ1 and GSK525762A) induced a dose dependent reduction in BRCA1 and RAD51 levels and is able to hinder homologous recombination mediated DNA damage repair, generating a BRCAness phenotype in TNBC cells.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(BRD4(), RAD51())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":573,"s":572,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"BRD4\", \"db_refs\": {\"UP\": \"O60885\", \"HGNC\": \"13575\", \"TEXT\": \"BRD4\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30259975\", \"text\": \"Moreover, BRD4 pharmacological inhibition using two BET inhibitors (JQ1 and GSK525762A) induced a dose dependent reduction in BRCA1 and RAD51 levels and is able to hinder homologous recombination mediated DNA damage repair, generating a BRCAness phenotype in TNBC cells.\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29567272\", \"text\": \"In cultured cells, inhibition of BRD4 by siRNA or INCB054329 reduced expression and function of BRCA1 and RAD51, reduced HR reporter activity, and sensitized the cells to olaparib induced growth inhibition, DNA damage induction and apoptosis.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"a4fbecff-b1fb-4b7f-92b7-64203ec26aaa\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Moreover, BRD4 pharmacological inhibition using two BET inhibitors (JQ1 and GSK525762A) induced a dose dependent reduction in BRCA1 and RAD51 levels and is able to hinder homologous recombination mediated DNA damage repair, generating a BRCAness phenotype in TNBC cells.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(BRD4(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":361,"s":315,"t":172,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":357,"s":315,"t":142,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":697,"s":696,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"GDF15\", \"db_refs\": {\"UP\": \"Q99988\", \"HGNC\": \"30142\", \"TEXT\": \"PlaB\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"Their finding that PlaB treatment causes a reduction in both BRCA1 and 53BP1 foci [XREF_BIBR], which we confirmed here, is consistent with their model, because RNF8 promotes focal accumulation of these factors [XREF_BIBR - XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"The finding that PlaB causes a reduction in both BRCA1 and 53BP1 foci was also observed in a recent report [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"e8af3cb5-89fc-4532-b732-667ce53d20e5\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Their finding that PlaB treatment causes a reduction in both BRCA1 and 53BP1 foci [XREF_BIBR], which we confirmed here, is consistent with their model, because RNF8 promotes focal accumulation of these factors [XREF_BIBR - XREF_BIBR].","type":"Inhibition","INDRA statement":"Inhibition(GDF15(), BRCA1())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":192,"s":184,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"INSR\", \"db_refs\": {\"TEXT\": \"IR\", \"UP\": \"P06213\", \"HGNC\": \"6091\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29179156\", \"text\": \"In inhibited cells, IR induced RAD51 foci then persisted at peak levels until 6h (no significant decrease in foci between 3 and 6h in inhibited cells compared with a 25% decrease in control cells; p < 0.01), after which they were resolved and basal levels were restored by 12h post-IR (XREF_FIG C).\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29590107\", \"text\": \"This is supported by the fact that a knockdown of BRCA2 in human cells decreases the efficiency of IR induced RAD51 foci formation.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"These CDC25A overexpressing Brca2 KO/KO cells (Brca2 KO/KO; MSCV-Cdc25A) showed defects in IR induced RAD51 foci formation, increased chromosomal instability, and increased sensitivity to DNA damaging agents indicating the impairment of Brca2 DSB repair function.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29179156\", \"text\": \"3.3 PARG but not PARP1/2/3 inhibition promotes rapid activation of IR induced DNA-PKcs, while both PARP and PARG delay resolution of IR induced RAD51 foci.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29179156\", \"text\": \"In the presence of olaparib or PDD00017273, the appearance of IR induced RAD51 foci was delayed compared with control cells but peaked at a similar 3h post-IR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"We found that Brca2 KO/KO; MSCV-BRE ES cells are defective in both IR induced RAD51 foci formation as well as protection of stalled replication forks.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"737bf6f2-1648-428d-8324-e007de90f0ec\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In inhibited cells, IR induced RAD51 foci then persisted at peak levels until 6h (no significant decrease in foci between 3 and 6h in inhibited cells compared with a 25% decrease in control cells; p < 0.01), after which they were resolved and basal levels were restored by 12h post-IR (XREF_FIG C).","type":"Activation","INDRA statement":"Activation(INSR(), RAD51())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":185,"s":184,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"INSR\", \"db_refs\": {\"TEXT\": \"IR\", \"UP\": \"P06213\", \"HGNC\": \"6091\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"IR induced BRCA1 and RAD51 foci formation was compromised in CSB null cells complemented with Myc-CSB-S10A but not in CSB null cells complemented with Myc-CSB-S10D.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"When stably introduced into hTERT-RPE CSB KO cells, Myc-CSB-S158A failed to suppress IR induced RIF1 foci formation in cyclin A positive cells, failed to rescue IR induced BRCA1 and RAD51 foci formation and failed to support cell survival in response to olaparib treatment.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"On the other hand, Myc-CSB-S158D was fully competent in suppressing IR induced RIF1 foci formation in cyclin A positive CSB null cells and facilitating efficient HR as evidenced by a complete rescue in IR induced BRCA1 and RAD51 foci formation, HR mediated repair as well as cell survival of CSB null cells in response to olaparib treatment.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29592899\", \"text\": \"In breast and glioma cells with proficient HR-repair, IR induced BRCA1 cytoplasmic sequestration, HR-repair inhibition, and subsequent PARPi sensitization in vitro and in vivo was dependent upon functional p53.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"1736eb3f-5121-4448-a57c-afddf18e2ce3\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"IR induced BRCA1 and RAD51 foci formation was compromised in CSB null cells complemented with Myc-CSB-S10A but not in CSB null cells complemented with Myc-CSB-S10D.","type":"Activation","INDRA statement":"Activation(INSR(), BRCA1())","Belief score":"0.94","polarity":"positive","i":"Activation"}},{"id":447,"s":437,"t":442,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"ZNF350\", \"db_refs\": {\"UP\": \"Q9GZX5\", \"HGNC\": \"16656\", \"TEXT\": \"ZNF350\"}}, {\"name\": \"RBBP8\", \"db_refs\": {\"TEXT\": \"CtIP\", \"UP\": \"Q99708\", \"HGNC\": \"9891\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"ddd4551a-dd8d-4ec8-934f-7033d492b415\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.","type":"Complex","INDRA statement":"Complex(BRCA1(), ZNF350(), RBBP8())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":309,"s":308,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"ATP\", \"db_refs\": {\"TEXT\": \"ATP\", \"HMDB\": \"HMDB00538\", \"PUBCHEM\": \"5957\", \"CHEBI\": \"CHEBI:15422\"}}, {\"name\": \"RAD51\", \"db_refs\": {\"UP\": \"Q06609\", \"HGNC\": \"9817\", \"TEXT\": \"hRAD51\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29507080\", \"text\": \"In this study, converging evidence from single-molecule and structural experiments shows that ATP bound hRAD51 NPF exists in two distinct forms that differ in pitch and protomer interface.\", \"annotations\": {\"found_by\": \"binding_token_3\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29507080\", \"text\": \"In the crystal, ATP bound hRAD51 forms a continuous right handed filament with seven subunits per helical turn (Fig XREF_FIG A and B).\", \"annotations\": {\"found_by\": \"binding_token_3\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29507080\", \"text\": \"We show that ATP bound hRAD51 filaments can exist in two different states with different contour lengths and with a free-energy difference of ~ 4 k B T per hRAD51 monomer.\", \"annotations\": {\"found_by\": \"binding_token_3\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29507080\", \"text\": \"Our combined evidence from single-molecule and structural experiments reveals that the ATP bound hRAD51 NPF is a highly flexible entity.\", \"annotations\": {\"found_by\": \"binding_token_3\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"2a8ab0e2-9859-4f1d-9c17-d0b3a8c2e323\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In this study, converging evidence from single-molecule and structural experiments shows that ATP bound hRAD51 NPF exists in two distinct forms that differ in pitch and protomer interface.","type":"Complex","INDRA statement":"Complex(ATP(), RAD51())","Belief score":"0.94","polarity":"none","i":"Complex"}},{"id":692,"s":691,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"Cyclin\", \"db_refs\": {\"TEXT\": \"Cyclin\", \"FPLX\": \"Cyclin\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"Cyclin A2 insufficiency perturbs RAD51 protein stability and causes reduced abundance of RAD51 protein.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"Cyclin A2 insufficiency perturbs RAD51 protein stability and causes reduced abundance of RAD51 protein.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"16c1f155-63d4-4214-9f2c-f5dac2475121\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Cyclin A2 insufficiency perturbs RAD51 protein stability and causes reduced abundance of RAD51 protein.","type":"Inhibition","INDRA statement":"Inhibition(Cyclin(), RAD51())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":646,"s":562,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"AKT\", \"db_refs\": {\"TEXT\": \"AKT\", \"FPLX\": \"AKT\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29996906\", \"text\": \"Estrogen activated the AKT pathway in BRCA1 deficient tumor cells independent of ER, and pharmaceutical inhibition of AKT activity suppressed EMT and cell proliferation preventing BRCA1 deficient tumor progression.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29497033\", \"text\": \"Previous studies demonstrated that BRCA1 is negatively regulated by the Akt signaling pathway XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"c805a3a0-0483-4ca4-8853-dd6f7e96a675\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Estrogen activated the AKT pathway in BRCA1 deficient tumor cells independent of ER, and pharmaceutical inhibition of AKT activity suppressed EMT and cell proliferation preventing BRCA1 deficient tumor progression.","type":"Inhibition","INDRA statement":"Inhibition(AKT(), BRCA1())","Belief score":"0.95","polarity":"negative","i":"Inhibition"}},{"id":563,"s":562,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"AKT\", \"db_refs\": {\"TEXT\": \"Akt\", \"FPLX\": \"AKT\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Conversely, Akt has been shown to stimulate Rad51 protein expression in several NSCLC cell lines including A549 cells [XREF_BIBR, XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"In contrast, earlier reports suggest that Akt increases Rad51 protein level by stimulating Rad51 mRNA and protein stability via reduction of Rad51 ubiquitination and proteasomal degradation [XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"39f223b8-71fc-4048-bf17-bda232237d69\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Conversely, Akt has been shown to stimulate Rad51 protein expression in several NSCLC cell lines including A549 cells [XREF_BIBR, XREF_BIBR, XREF_BIBR].","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(AKT(), RAD51())","Belief score":"0.95","polarity":"positive","i":"IncreaseAmount"}},{"id":179,"s":178,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"IL1B\", \"db_refs\": {\"UP\": \"P01584\", \"HGNC\": \"5992\", \"TEXT\": \"IL1beta\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We also found that Stat3, C/ebpbeta, and Icsbp are non redundant for activation of the FANCC promoter and that IL1beta increases FANCC promoter activity and enhances the effects of these transcription factors.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that IL1beta increased the activity of the FANCC cis element with or without Stat3 overexpression, consistent with the effect of increased endogenous Stat3 in IL1beta treated cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that IL1beta significantly increased FANCC promoter activity with or without overexpression of Stat3 or C/ebpbeta-Lap (p < 0.0001, n = 6) (XREF_FIG C).\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"7feed149-e699-4e86-b027-9cceea6a99b6\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We also found that Stat3, C/ebpbeta, and Icsbp are non redundant for activation of the FANCC promoter and that IL1beta increases FANCC promoter activity and enhances the effects of these transcription factors.","type":"Activation","INDRA statement":"Activation(IL1B(), FANCC())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":687,"s":685,"t":686,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"CO\", \"db_refs\": {\"TEXT\": \"CO\", \"CHEBI\": \"CHEBI:17245\", \"PUBCHEM\": \"281\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"FANCM\", \"db_refs\": {\"UP\": \"Q8IYD8\", \"HGNC\": \"23168\", \"TEXT\": \"FANCM\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29628933\", \"text\": \"The systematic correspondence observed between double (A/C) fancm mutants and increased CO frequencies across all F1s and all allohaploids rather suggests that FANCM limits CO formation between homoeologous chromosomes in B. napus.\", \"annotations\": {\"found_by\": \"Negative_activation_token_1_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29628933\", \"text\": \"These results lend support to the hypothesis that FANCM limits CO formation in B. napus too.\", \"annotations\": {\"found_by\": \"Negative_activation_token_1_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"26fbc86b-49d5-4b29-8606-2cd324577aba\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"The systematic correspondence observed between double (A/C) fancm mutants and increased CO frequencies across all F1s and all allohaploids rather suggests that FANCM limits CO formation between homoeologous chromosomes in B. napus.","type":"Inhibition","INDRA statement":"Inhibition(CO(), FANCM())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":557,"s":556,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"DecreaseAmount\", \"subj\": {\"name\": \"vorinostat\", \"db_refs\": {\"TEXT\": \"vorinostat\", \"PUBCHEM\": \"5311\", \"CHEBI\": \"CHEBI:45716\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000010\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"Western blotting showed that vorinostat downregulated the protein expression of BRCA1 in a dose dependent manner.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"In this study, we showed that BRCA1 expression was upregulated by oxaliplatin exposure alone, whereas vorinostat downregulated BRCA1 expression in the presence or absence of oxaliplatin in HCC cells.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"The mRNA level of BRCA1 was also decreased by vorinostat using quantitative PCR (qPCR).\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"150c5d4a-f820-491c-8d8e-06ec97c4ce07\", \"supported_by\": [\"4a44c262-2173-46e9-9f4e-bf4802cf81fa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000179\"}","Text":"Western blotting showed that vorinostat downregulated the protein expression of BRCA1 in a dose dependent manner.","type":"DecreaseAmount","INDRA statement":"DecreaseAmount(vorinostat(), BRCA1())","Belief score":"0.92","polarity":"negative","i":"DecreaseAmount"}},{"id":173,"s":172,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"CstF-50 and p97 activate BRCA1 and BARD1 Ub ligase in vitro.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Addition of p97 alone did not activate BRCA1 and BARD1 activity.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Next, we tested whether CstF-50 and p97 can activate BRCA1 and BARD1 in trans-ubiquitination reactions using known BRCA1 and BARD1 substrates, such as RNAP II, H 2 A, and H 2 B.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"216a17dd-2729-436b-bb3e-eae33429afeb\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"CstF-50 and p97 activate BRCA1 and BARD1 Ub ligase in vitro.","type":"Activation","INDRA statement":"Activation(GEMIN4(), BRCA1())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":420,"s":172,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"CstF-50 and p97 formed complexes with BRCA1 and BARD1, Ub, and some BRCA1 and BARD1 substrates, such as RNA polymerase (RNAP) II and histones.\", \"annotations\": {\"found_by\": \"binding1forms\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Work from different groups has shown that the mRNA processing factor CstF-50 and the Ub escort factor p97 can interact with BRCA1 and BARD1.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"After DNA damage, BRCA1 and BARD1, as part of the RNAP II holoenzyme, associates with the escort factor p97 and senses sites of DNA damage and repair, and the inhibitory interaction with CstF-50 ensures that nascent RNAs are not erroneously polyadenylated at such sites, avoiding the expression of deleterious proteins.\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"7ea651f2-efb5-465d-abd1-df204c385f79\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"CstF-50 and p97 formed complexes with BRCA1 and BARD1, Ub, and some BRCA1 and BARD1 substrates, such as RNA polymerase (RNAP) II and histones.","type":"Complex","INDRA statement":"Complex(GEMIN4(), BRCA1())","Belief score":"0.92","polarity":"none","i":"Complex"}},{"id":302,"s":296,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"olaparib\", \"db_refs\": {\"PUBCHEM\": \"23725625\", \"TEXT\": \"olaparib\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29467415\", \"text\": \"Importantly, depletion of Fbh1, an anti-recombination helicase that destabilises Rad51 nucleofilaments XREF_BIBR, XREF_BIBR, XREF_BIBR, can restore MMS and HU induced Rad51 foci in parp1/2Delta cells or U2OS cells treated with olaparib.\", \"annotations\": {\"found_by\": \"Positive_activation_surface_treated_with\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29340034\", \"text\": \"Prexasertib, with little direct effect on Rad51 focus formation by itself, abrogated olaparib induced Rad51 focus formation, resulting in greater DNA damage that was measured by several means.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29467415\", \"text\": \"Strikingly, this increase in Rad51 foci is compromised in parp1/2Delta cells, or U2OS cells treated with olaparib.\", \"annotations\": {\"found_by\": \"Positive_activation_surface_treated_with\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"edd691f8-c487-4474-ac3d-42ca42ba4e44\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Importantly, depletion of Fbh1, an anti-recombination helicase that destabilises Rad51 nucleofilaments XREF_BIBR, XREF_BIBR, XREF_BIBR, can restore MMS and HU induced Rad51 foci in parp1/2Delta cells or U2OS cells treated with olaparib.","type":"Activation","INDRA statement":"Activation(olaparib(), RAD51())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":297,"s":296,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"olaparib\", \"db_refs\": {\"PUBCHEM\": \"23725625\", \"TEXT\": \"olaparib\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29355244\", \"text\": \"Indeed, Mijic et al. observed a mild increase in chromatid breaks and gaps after forks stalling in BRCA2 depleted cells treated with olaparib [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_surface_treated_with\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30271179\", \"text\": \"The clinical record of a patient with BRCA2 mutated refractory advanced ICC treated with olaparib was analyzed.\", \"annotations\": {\"found_by\": \"Positive_activation_surface_treated_with\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"cce01cc5-82f1-475c-b4c6-fd650f8722f0\", \"supported_by\": [\"10715a2d-61f5-4c90-b5d0-de89f06411b4\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Indeed, Mijic et al. observed a mild increase in chromatid breaks and gaps after forks stalling in BRCA2 depleted cells treated with olaparib [XREF_BIBR].","type":"Activation","INDRA statement":"Activation(olaparib(), BRCA2())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":628,"s":551,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"curcumin\", \"db_refs\": {\"TEXT\": \"curcumin\", \"CHEBI\": \"CHEBI:3962\", \"PUBCHEM\": \"969516\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Western blot analysis revealed that curcumin up-regulated BRCA1, BRCA2 and ERCC1 expression in bone marrow.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Consistently, 5muM curcumin increased the expression of BRCA1 and BRCA2 significantly in carboplatin treated bone marrow cells, and up-regulated ERCC1 expression to some extent.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Results from qPCR and western blot analyses demonstrated that curcumin did not increase the expression of BRCA1, BRCA2 and ERCC1 in T241 cells or carboplatin treated T241 cells, indicating that curcumin does not activate the DNA repair pathway in T241 cells.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Our results showed that curcumin significantly increased the expression of BRCA1, BRCA2 and ERCC1, which indicates that curcumin improves myelosuppression by activating NER and homologous recombination.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"e2d86a4c-297a-4aec-9e2f-5452fc4f0394\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Western blot analysis revealed that curcumin up-regulated BRCA1, BRCA2 and ERCC1 expression in bone marrow.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(curcumin(), BRCA2())","Belief score":"0.94","polarity":"positive","i":"IncreaseAmount"}},{"id":622,"s":551,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"curcumin\", \"db_refs\": {\"TEXT\": \"curcumin\", \"CHEBI\": \"CHEBI:3962\", \"PUBCHEM\": \"969516\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Our results showed that curcumin significantly increased the expression of BRCA1, BRCA2 and ERCC1, which indicates that curcumin improves myelosuppression by activating NER and homologous recombination.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Western blot analysis revealed that curcumin up-regulated BRCA1, BRCA2 and ERCC1 expression in bone marrow.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Consistently, 5muM curcumin increased the expression of BRCA1 and BRCA2 significantly in carboplatin treated bone marrow cells, and up-regulated ERCC1 expression to some extent.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Results from qPCR and western blot analyses demonstrated that curcumin did not increase the expression of BRCA1, BRCA2 and ERCC1 in T241 cells or carboplatin treated T241 cells, indicating that curcumin does not activate the DNA repair pathway in T241 cells.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3486a2e5-cff4-4942-9942-48d881977fb8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Our results showed that curcumin significantly increased the expression of BRCA1, BRCA2 and ERCC1, which indicates that curcumin improves myelosuppression by activating NER and homologous recombination.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(curcumin(), BRCA1())","Belief score":"0.94","polarity":"positive","i":"IncreaseAmount"}},{"id":552,"s":551,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"DecreaseAmount\", \"subj\": {\"name\": \"curcumin\", \"db_refs\": {\"TEXT\": \"curcumin\", \"CHEBI\": \"CHEBI:3962\", \"PUBCHEM\": \"969516\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000010\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"In addition, some reports have shown that curcumin inhibits BRCA1 expression to suppress DNA repair pathway, so as to inhibit cell viability and increase sensitivity against cisplatin.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"For example, Ting et al. reported that curcumin triggered DNA damage and reduced BRCA1 expression to suppress DNA repair pathway in human lung cancer cells, thereby inhibiting cell viability 50.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ac3b1fa9-a031-473d-98ac-60a9af1902ad\", \"supported_by\": [\"4a44c262-2173-46e9-9f4e-bf4802cf81fa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000179\"}","Text":"In addition, some reports have shown that curcumin inhibits BRCA1 expression to suppress DNA repair pathway, so as to inhibit cell viability and increase sensitivity against cisplatin.","type":"DecreaseAmount","INDRA statement":"DecreaseAmount(curcumin(), BRCA1())","Belief score":"0.86","polarity":"negative","i":"DecreaseAmount"}},{"id":168,"s":167,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"FBXO18\", \"db_refs\": {\"UP\": \"Q8NFZ0\", \"TEXT\": \"Fbh1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29467415\", \"text\": \"Importantly, depletion of Fbh1, an anti-recombination helicase that destabilises Rad51 nucleofilaments XREF_BIBR, XREF_BIBR, XREF_BIBR, can restore MMS and HU induced Rad51 foci in parp1/2Delta cells or U2OS cells treated with olaparib.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29467415\", \"text\": \"Whereas this observation could reflect a shift in the equilibrium between Rad51 loading and removal from nucleofilaments, depletion of Fbh1 can not restore Rad51 foci in BRCA2 defective cells, arguing against a role for PARP1 and PARP2 in BRCA2 dependent loading of Rad51 at damaged replication forks 55.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"9c84bcc1-0d0c-4afc-b227-316a73361523\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Importantly, depletion of Fbh1, an anti-recombination helicase that destabilises Rad51 nucleofilaments XREF_BIBR, XREF_BIBR, XREF_BIBR, can restore MMS and HU induced Rad51 foci in parp1/2Delta cells or U2OS cells treated with olaparib.","type":"Activation","INDRA statement":"Activation(FBXO18(), RAD51())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":754,"s":291,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"USP48\", \"db_refs\": {\"UP\": \"Q86UV5\", \"HGNC\": \"18533\", \"TEXT\": \"USP48\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29335415\", \"text\": \"In cells we reveal that USP48 antagonizes BRCA1 E3 ligase function and in BRCA1-proficient cells loss of USP48 results in positioning 53BP1 further from the break site and in extended resection lengths.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29335415\", \"text\": \"Moreover, both the increased GC and SSA repair seen in USP48 depleted cells required BRCA1, as well as CtIP.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"697571fc-e97b-4e3e-a9d7-eb89be42ca3b\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In cells we reveal that USP48 antagonizes BRCA1 E3 ligase function and in BRCA1-proficient cells loss of USP48 results in positioning 53BP1 further from the break site and in extended resection lengths.","type":"Inhibition","INDRA statement":"Inhibition(USP48(), BRCA1())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":292,"s":291,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"USP48\", \"db_refs\": {\"UP\": \"Q86UV5\", \"HGNC\": \"18533\", \"TEXT\": \"USP48\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29335415\", \"text\": \"We propose that USP48 promotes genome stability by antagonizing BRCA1 E3 ligase function.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29335415\", \"text\": \"Thus, high levels or activity of USP48 would be expected to decrease resection lengths and thus reduce GC, and phenocopy aspects of BRCA1 loss.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"af1503bf-f0bc-4267-8184-7e458e88ca5d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We propose that USP48 promotes genome stability by antagonizing BRCA1 E3 ligase function.","type":"Activation","INDRA statement":"Activation(USP48(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":546,"s":545,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"DecreaseAmount\", \"subj\": {\"name\": \"Vorinostat\", \"db_refs\": {\"PUBCHEM\": \"5311\", \"TEXT\": \"Vorinostat\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000010\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"Vorinostat suppressed the expression of BRCA1 induced by oxaliplatin.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"Vorinostat suppresses the expression of BRCA1 in HCC cells.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29239146\", \"text\": \"Vorinostat enhances the anticancer effect of oxaliplatin on HCC cells by suppressing the expression of BRCA1 that is induced by oxaliplatin.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4ef22429-f174-4309-a1e1-2265019d68f1\", \"supported_by\": [\"4a44c262-2173-46e9-9f4e-bf4802cf81fa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000179\"}","Text":"Vorinostat suppressed the expression of BRCA1 induced by oxaliplatin.","type":"DecreaseAmount","INDRA statement":"DecreaseAmount(Vorinostat(), BRCA1())","Belief score":"0.92","polarity":"negative","i":"DecreaseAmount"}},{"id":164,"s":159,"t":163,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"FANC\", \"db_refs\": {\"TEXT\": \"FANC\", \"FPLX\": \"FANC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCI\", \"db_refs\": {\"UP\": \"Q9NVI1\", \"HGNC\": \"25568\", \"TEXT\": \"FANCI\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29361695\", \"text\": \"In response to ICL formation, the protein products of eight FA genes assemble to form the nuclear \\\" FA core complex \\\" at the lesion, trigger the monoubiquitination of Fanconi Anemia Complementation Group (FANC) D2 (FANCD2) and FANCI, and then activate the FANCD2 and FANCI dimer that orchestrates the coordinated recruitment of downstream proteins to repair the lesion.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"cf022b77-5df0-4595-9bbc-46823ae53140\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In response to ICL formation, the protein products of eight FA genes assemble to form the nuclear \" FA core complex \" at the lesion, trigger the monoubiquitination of Fanconi Anemia Complementation Group (FANC) D2 (FANCD2) and FANCI, and then activate the FANCD2 and FANCI dimer that orchestrates the coordinated recruitment of downstream proteins to repair the lesion.","type":"Activation","INDRA statement":"Activation(FANC(), FANCI())","Belief score":"0.88","polarity":"positive","i":"Activation"}},{"id":160,"s":159,"t":155,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"FANC\", \"db_refs\": {\"TEXT\": \"FANC\", \"FPLX\": \"FANC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"FANCD2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29361695\", \"text\": \"In response to ICL formation, the protein products of eight FA genes assemble to form the nuclear \\\" FA core complex \\\" at the lesion, trigger the monoubiquitination of Fanconi Anemia Complementation Group (FANC) D2 (FANCD2) and FANCI, and then activate the FANCD2 and FANCI dimer that orchestrates the coordinated recruitment of downstream proteins to repair the lesion.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"957d473d-5f6e-4466-9f84-317ab978f8fa\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In response to ICL formation, the protein products of eight FA genes assemble to form the nuclear \" FA core complex \" at the lesion, trigger the monoubiquitination of Fanconi Anemia Complementation Group (FANC) D2 (FANCD2) and FANCI, and then activate the FANCD2 and FANCI dimer that orchestrates the coordinated recruitment of downstream proteins to repair the lesion.","type":"Activation","INDRA statement":"Activation(FANC(), FANCD2())","Belief score":"0.88","polarity":"positive","i":"Activation"}},{"id":414,"s":413,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"EDC4\", \"db_refs\": {\"UP\": \"Q6P2E9\", \"HGNC\": \"17157\", \"TEXT\": \"EDC4\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Given that EDC4 interacts with BRCA1, it is probably a member of at least one of the multiple BRCA1 containing protein complexes : BRCA1-A, BRCA1-B, BRCA1-C, BRCA1/PALB2/BRCA2, and the BRCA1 and BARD1 heterodimer 34.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Since EDC4 interacts with BRCA1, and BRCA1 mediates DNA end resection at DSB, promoting error-free HR mediated repair 18, we investigated whether EDC4 also regulates this process.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"EDC4 interacts with TOPBP1 and associates with BRCA1.\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Here we observe that EDC4, besides its known role in processing-bodies (P-bodies), interacts with BRCA1 and is involved in HR mediated DNA repair by regulating its end-resection step and that germline mutations in EDC4 may confer increased risk of breast cancer.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"e2b0ba2f-5a35-459a-89cf-92a9df6c4caa\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Given that EDC4 interacts with BRCA1, it is probably a member of at least one of the multiple BRCA1 containing protein complexes : BRCA1-A, BRCA1-B, BRCA1-C, BRCA1/PALB2/BRCA2, and the BRCA1 and BARD1 heterodimer 34.","type":"Complex","INDRA statement":"Complex(EDC4(), BRCA1())","Belief score":"0.94","polarity":"none","i":"Complex"}},{"id":747,"s":285,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"TP53BP1\", \"db_refs\": {\"TEXT\": \"53BP1\", \"UP\": \"Q12888\", \"HGNC\": \"11999\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29190394\", \"text\": \"In this study, we provide evidence that CBP mediated K1626/1628 acetylation of 53BP1 represses 53BP1 foci formation and abolishes PARPi sensitivity in BRCA1 deficient cells.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30254264\", \"text\": \"53BP1 with its downstream proteins, RIF1, PTIP and REV7, antagonizes BRCA1 dependent homologous recombination (HR) and promotes non homologous end joining (NHEJ) in an unclear manner.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"53BP1 blocks BRCA1 and promotes NHEJ in G1 through its downstream effector RIF1 XREF_BIBR - XREF_BIBR.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"bd1ad24b-1eb5-4e45-9f0a-66238025172c\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"In this study, we provide evidence that CBP mediated K1626/1628 acetylation of 53BP1 represses 53BP1 foci formation and abolishes PARPi sensitivity in BRCA1 deficient cells.","type":"Inhibition","INDRA statement":"Inhibition(TP53BP1(), BRCA1())","Belief score":"0.97","polarity":"negative","i":"Inhibition"}},{"id":451,"s":285,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"TP53BP1\", \"db_refs\": {\"TEXT\": \"53BP1\", \"UP\": \"Q12888\", \"HGNC\": \"11999\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"We further demonstrate that G9a catalytic activity is required for the early H2AX independent recruitment of 53BP1 and BRCA1 but dispensable for late recruitment of these proteins.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"Thus, Inhibition of G9a activity leads to loss of early recruitment of 53BP1 and BRCA1 to both UV-laser induced breaks and IRIF, but 53BP1 has faster dynamics of loss and recovery than BRCA1.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"Loss of G9a or catalytic inhibition of G9a activity does abolish the early recruitment of RNF168, 53BP1 and BRCA1 to induced DNA breaks.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"Likewise, another demethylase LSD1, which has been shown to regulate H3K4 demethylation, is also recruited to sites of DNA breaks, where it interacts with RNF168 and is required for efficient recruitment of 53BP1 and BRCA1 40.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"In H2AX-/- MEFS early recruitment of 53BP1 and BRCA1 to laser scissors induce micro-irradiation and to IRIF is intact, although later accumulation of these proteins is abolished XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29192276\", \"text\": \"In other words, G9a activity is critical for early recruitment of 53BP1 and BRCA1 to DNA breaks, while H2AX phosphorylation is critical for their late recruitment.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"59d25958-8655-4732-ac9a-bf021c7e786d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"We further demonstrate that G9a catalytic activity is required for the early H2AX independent recruitment of 53BP1 and BRCA1 but dispensable for late recruitment of these proteins.","type":"Complex","INDRA statement":"Complex(TP53BP1(), BRCA1())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":286,"s":285,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"TP53BP1\", \"db_refs\": {\"TEXT\": \"53BP1\", \"UP\": \"Q12888\", \"HGNC\": \"11999\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29190394\", \"text\": \"P53 binding protein 1 (53BP1) plays critical roles in DNA double strand break (DSB) repair by promoting non homologous end joining (NHEJ), and loss of 53BP1 abolishes PARPi sensitivity in BRCA1 deficient cells by restoring homologous recombination (HR).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30257212\", \"text\": \"Here, we found that 53bp1 KO rescued the embryonic viability of a Brca1\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"bc4f3789-e1cb-41c2-bad3-9cddd9fde1f5\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"P53 binding protein 1 (53BP1) plays critical roles in DNA double strand break (DSB) repair by promoting non homologous end joining (NHEJ), and loss of 53BP1 abolishes PARPi sensitivity in BRCA1 deficient cells by restoring homologous recombination (HR).","type":"Activation","INDRA statement":"Activation(TP53BP1(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":540,"s":539,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"DecreaseAmount\", \"subj\": {\"name\": \"RES\", \"db_refs\": {\"TEXT\": \"RES\", \"PUBCHEM\": \"5281611\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000010\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29681946\", \"text\": \"We previously determined that the expression of RAD51 is decreased by RES.\", \"annotations\": {\"found_by\": \"transcription_1b\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29620223\", \"text\": \"A total of 100microM RES decreased the relative transcript levels of homologous recombination (HR) initiation complex components and the Rad51 protein level in MCF-7 and MCF-7R cells.\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"493b8afe-6284-452f-b8eb-195f0eb5d28b\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000179\"}","Text":"We previously determined that the expression of RAD51 is decreased by RES.","type":"DecreaseAmount","INDRA statement":"DecreaseAmount(RES(), RAD51())","Belief score":"0.86","polarity":"negative","i":"DecreaseAmount"}},{"id":503,"s":155,"t":163,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"FANCD2\"}}, {\"name\": \"FANCI\", \"db_refs\": {\"UP\": \"Q9NVI1\", \"HGNC\": \"25568\", \"TEXT\": \"FANCI\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29423082\", \"text\": \"FA core complex proteins FANCA, FANCB, FANCC, FANCE, FANCF, FANCG together with the E2 ubiquitin conjugating enzyme FANCT and UBE2T and the E3 ubiquitin ligase FANCL are necessary for the monoubiquitination of the FANCD2 and FANCI complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29423082\", \"text\": \"The proteins of the FA pathway can be divided into three functional groups : the FA core complex, the FANCD2 and FANCI complex and the downstream effectors.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30022024\", \"text\": \"We uncovered a novel function of Fanconi anemia (FA) protein FANCM in the protection of CFSs that is independent of the FA core complex and the FANCI and FANCD2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29376519\", \"text\": \"Carcinogenesis resulting from a dysregulated FA pathway is multifaceted, as FA proteins monitor multiple complementary genome-surveillance checkpoints throughout interphase, where monoubiquitylation of the FANCD2 and FANCI heterodimer by the FA core complex promotes recruitment of DNA repair effectors to chromatin lesions to resolve DNA damage and mitosis.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29376519\", \"text\": \"Carcinogenesis resulting from a dysregulated FA pathway is multifaceted, as FA proteins monitor multiple complementary genome-surveillance checkpoints throughout interphase, where monoubiquitylation of the FANCD2 and FANCI heterodimer by the FA core complex promotes recruitment of DNA repair effectors to chromatin lesions to resolve DNA damage and mitosis.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29361695\", \"text\": \"Once the repair is completed, the deubiquitination of the FANCD2 and FANCI complex by ubiquitin specific peptidase 1 USP1 and USP1- associated factor (USP1-UAF1) leads to complex release from chromatin and to pathway reset.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29231814\", \"text\": \"This monoubiquitination allows the FANCD2 and FANCI heterodimer to coordinate the DNA repair and replication rescue activities of the third group of FANC proteins, which includes nucleases and proteins involved in homologous recombination.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29193904\", \"text\": \"FANCB, along with FANCL and FAAP100, is absolutely required for monoubiquitination of the FANCD2 and FANCI complex (Huang etal., 2014; Rajendra etal., 2014), a key step that results in the recognition and initiation of DNA damage repair caused by DNA crosslinks.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"70b1fe09-fd93-4fbb-a83e-af03d288bb63\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"FA core complex proteins FANCA, FANCB, FANCC, FANCE, FANCF, FANCG together with the E2 ubiquitin conjugating enzyme FANCT and UBE2T and the E3 ubiquitin ligase FANCL are necessary for the monoubiquitination of the FANCD2 and FANCI complex.","type":"Complex","INDRA statement":"Complex(FANCD2(), FANCI())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":156,"s":155,"t":42,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"FANCD2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DNA_repair\", \"db_refs\": {\"TEXT\": \"DNA repair\", \"GO\": \"GO:0006281\", \"MESH\": \"D004260\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29376519\", \"text\": \"Carcinogenesis resulting from a dysregulated FA pathway is multifaceted, as FA proteins monitor multiple complementary genome-surveillance checkpoints throughout interphase, where monoubiquitylation of the FANCD2 and FANCI heterodimer by the FA core complex promotes recruitment of DNA repair effectors to chromatin lesions to resolve DNA damage and mitosis.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"972cb145-ba2d-4c2f-b87c-be67763cc27c\", \"supported_by\": [\"bca920fd-a626-4d62-9914-b63336fa34aa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Carcinogenesis resulting from a dysregulated FA pathway is multifaceted, as FA proteins monitor multiple complementary genome-surveillance checkpoints throughout interphase, where monoubiquitylation of the FANCD2 and FANCI heterodimer by the FA core complex promotes recruitment of DNA repair effectors to chromatin lesions to resolve DNA damage and mitosis.","type":"Activation","INDRA statement":"Activation(FANCD2(), DNA_repair())","Belief score":"0.88","polarity":"positive","i":"Activation"}},{"id":535,"s":534,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"DecreaseAmount\", \"subj\": {\"name\": \"IH\", \"db_refs\": {\"PUBCHEM\": \"7019081\", \"TEXT\": \"IH\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000010\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29551903\", \"text\": \"These results suggested that IH inhibited RAD51 expression not only through modulating RAD51 gene transcription but also promoting RAD51 protein degradation.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29551903\", \"text\": \"This study not only evaluated the therapeutic efficacy of this combination in vitro but also clarified the potential underlying mechanism that IH could suppress EGFR signaling activation and attenuate RAD51 expression and nuclear foci formation induced by irradiation or cisplatin, therefore suggesting a potential clinical application for CC.\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"2d675d17-f21a-4265-90d2-f100ae398ce8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000179\"}","Text":"These results suggested that IH inhibited RAD51 expression not only through modulating RAD51 gene transcription but also promoting RAD51 protein degradation.","type":"DecreaseAmount","INDRA statement":"DecreaseAmount(IH(), RAD51())","Belief score":"0.86","polarity":"negative","i":"DecreaseAmount"}},{"id":618,"s":275,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"STAT3\", \"db_refs\": {\"TEXT\": \"Stat3\", \"UP\": \"P40763\", \"HGNC\": \"11364\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"281c4743-0ade-4faf-bbcc-7d2fba00a701\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(STAT3(), FANCC())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":276,"s":275,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"STAT3\", \"db_refs\": {\"TEXT\": \"Stat3\", \"UP\": \"P40763\", \"HGNC\": \"11364\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In this study, we found that neither tyrosine nor serine phosphorylation of Stat3 enhances FANCC promoter activation, suggesting that protein expression is driving function.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that Stat3 significantly increased the activity of the -438 to -474 bp FANCC and minimal promoter construct (p < 0.0001, n = 6) (XREF_FIG A).\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We also found that this FANCC cis element was equivalently activated by tyrosine mutant, serine mutant, or WT Stat3 (p> = 0.2, n = 6) (XREF_FIG B).\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3 or C/ebpbeta rescues DNA repair in a FancC dependent manner.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3 and C/ebpbeta activate separate FANCC promoter cis elements.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We also found that knockdown of either Stat3 or C/ebpbeta significantly decreased FANCC promoter activity (p < 0.0001, n = 6), but only in IL1beta treated transfectants.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"0a50111e-1280-47da-bf1c-5565c5535541\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.","type":"Activation","INDRA statement":"Activation(STAT3(), FANCC())","Belief score":"0.98","polarity":"positive","i":"Activation"}},{"id":148,"s":147,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"ERCC6\", \"db_refs\": {\"UP\": \"Q03468\", \"HGNC\": \"3438\", \"TEXT\": \"Myc-CSB\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"Introduction of Myc-CSB into U2OS-265 CSB knockout cells not only suppressed RIF1 but also restored BRCA1 accumulation at FokI induced DSBs.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"CSB inhibits RIF1 but promotes BRCA1 in S/G2.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"At DSBs, CSB remodels chromatin by evicting histones, which limits RIF1 and its effector MAD2L2 but promotes BRCA1 accumulation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"These results reveal that CSB inhibits RIF1 but promotes BRCA1 in S/G2.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"Earlier, we have shown that loss of CSB impairs BRCA1 accumulation at FokI induced DSBs.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"60a18679-e72d-43dc-8acd-0eccc438a072\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Introduction of Myc-CSB into U2OS-265 CSB knockout cells not only suppressed RIF1 but also restored BRCA1 accumulation at FokI induced DSBs.","type":"Activation","INDRA statement":"Activation(ERCC6(), BRCA1())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":443,"s":18,"t":442,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"ZNF350\", \"db_refs\": {\"UP\": \"Q9GZX5\", \"HGNC\": \"16656\", \"TEXT\": \"ZNF350\"}}, {\"name\": \"RBBP8\", \"db_refs\": {\"TEXT\": \"CtIP\", \"UP\": \"Q99708\", \"HGNC\": \"9891\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"ddd4551a-dd8d-4ec8-934f-7033d492b415\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.","type":"Complex","INDRA statement":"Complex(BRCA1(), ZNF350(), RBBP8())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":438,"s":18,"t":437,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"ZNF350\", \"db_refs\": {\"UP\": \"Q9GZX5\", \"HGNC\": \"16656\", \"TEXT\": \"ZNF350\"}}, {\"name\": \"RBBP8\", \"db_refs\": {\"TEXT\": \"CtIP\", \"UP\": \"Q99708\", \"HGNC\": \"9891\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30137214\", \"text\": \"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"ddd4551a-dd8d-4ec8-934f-7033d492b415\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In normal tissues, the BRCA1, ZNF350, and CtIP complex binds to the HMGA2 promoter to prevent transcription.","type":"Complex","INDRA statement":"Complex(BRCA1(), ZNF350(), RBBP8())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":426,"s":18,"t":425,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"UP\": \"P38398\", \"HGNC\": \"1100\", \"TEXT\": \"Brca1\"}}, {\"name\": \"NELFB\", \"db_refs\": {\"UP\": \"Q8WX92\", \"HGNC\": \"24324\", \"TEXT\": \"Cobra1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"Here we address this important question by examining genetic interactions between Brca1 and Cobra1 in mice bearing separation-of-function mutations in either the RING (I26A) or BRCT domains (S1598F) of Brca1 35, or a conditional null mutation of the Palb2 gene 38.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"We recently identified a genetic interaction between mouse Brca1 and Cobra1 that antagonistically regulates mammary gland development.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"The distinct phenotype of Cobra1 and Palb2 (CKO-PKO) versus Cobra1 and Brca1 (CKO-E11 -) mice, which is difficult to predict based on our current knowledge of PALB2 and BRCA1 function in DSB repair, highlights the gene specific genetic interaction between Cobra1 and Brca1, as well as the power of mouse genetics.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"To address the generality of the genetic interaction between Brca1 and Cobra1, we asked whether other tumor suppressors in the Brca1 pathway would also display a similar genetic relationship with Cobra1.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"In aggregate, these findings underscore the specificity of the genetic interaction between Cobra1 and Brca1 in mammary epithelium.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"c7a0decc-39a3-48d0-b6b2-4194e550f5f5\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Here we address this important question by examining genetic interactions between Brca1 and Cobra1 in mice bearing separation-of-function mutations in either the RING (I26A) or BRCT domains (S1598F) of Brca1 35, or a conditional null mutation of the Palb2 gene 38.","type":"Complex","INDRA statement":"Complex(BRCA1(), NELFB())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":404,"s":18,"t":399,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"TOPBP1\", \"db_refs\": {\"UP\": \"Q92547\", \"HGNC\": \"17008\", \"TEXT\": \"TOPBP1\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BRIP1\", \"db_refs\": {\"UP\": \"Q9BX63\", \"HGNC\": \"20473\", \"TEXT\": \"BRIP1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Here, we identify EDC4, a known component of processing-bodies and regulator of mRNA decapping, as a member of the BRCA1, BRIP1, and TOPBP1 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"77dfcb0f-8be6-46c5-a27a-3c36161079c8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.","type":"Complex","INDRA statement":"Complex(TOPBP1(), BRCA1(), BRIP1())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":656,"s":18,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Control cells with intact HR repair pathway exhibited efficient functional GFP expression, while, as expected, BRCA1 and BRCA2 depletion by RNAi strongly abolished HR mediated repair.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30070702\", \"text\": \"Therefore, we suppressed HR activity by silencing BRCA1, the key player in the HR pathway.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_3_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29567272\", \"text\": \"In cultured cells, inhibition of BRD4 by siRNA or INCB054329 reduced expression and function of BRCA1 and RAD51, reduced HR reporter activity, and sensitized the cells to olaparib induced growth inhibition, DNA damage induction and apoptosis.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"Nevertheless, we suggest that the changes to chromatin and transcription unit function caused by RNA splicing inhibition contribute to the defects in BRCA1 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29464354\", \"text\": \"A deficiency in BRCA1 or BRCA2 within a cell is believed to impair HR repair, termed homologous recombination deficiency (HRD), and place a greater reliance upon alternative DNA repair pathways to repair DSBs, such as non homologous end joining (NHEJ) and microhomology mediated end joining (MMEJ) [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4e06f7fb-bb65-41e0-90a9-1476405107ea\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Control cells with intact HR repair pathway exhibited efficient functional GFP expression, while, as expected, BRCA1 and BRCA2 depletion by RNAi strongly abolished HR mediated repair.","type":"Inhibition","INDRA statement":"Inhibition(BRCA1(), HR())","Belief score":"0.95","polarity":"negative","i":"Inhibition"}},{"id":651,"s":18,"t":42,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"DNA_repair\", \"db_refs\": {\"TEXT\": \"DNA repair\", \"GO\": \"GO:0006281\", \"MESH\": \"D004260\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30105462\", \"text\": \"BRCA1 c. 5309G> T p. (Gly1770Val) has been shown to abrogate BRCA1 protein homologous DNA repair; however, multiple sequence alignment demonstrates a lack of sequence conservation at this position, suggesting that glycine at position 1770 may not be essential for cellular maintenance in humans.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30006610\", \"text\": \"CTSS interacted with the BRCT domain of BRCA1 and facilitated ubiquitin mediated proteolytic degradation of BRCA1, which was tightly associated with decreased BRCA1 mediated DNA repair activity.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3189cf8e-5258-4519-b64f-25cc60087d09\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"BRCA1 c. 5309G> T p. (Gly1770Val) has been shown to abrogate BRCA1 protein homologous DNA repair; however, multiple sequence alignment demonstrates a lack of sequence conservation at this position, suggesting that glycine at position 1770 may not be essential for cellular maintenance in humans.","type":"Inhibition","INDRA statement":"Inhibition(BRCA1(), DNA_repair())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":382,"s":18,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"PALB2\", \"db_refs\": {\"UP\": \"Q86YC2\", \"HGNC\": \"26144\", \"TEXT\": \"PALB2\"}}, {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"These findings emphasise the critical role of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability and prevention of cancer and provide evidence that heterozygosity for rare missense variants of PALB2 may influence cancer risk.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"Conversely, many missense mutations remain as variants of uncertain significance (VUSs), even though the likely impact of PALB2 missense VUSs hindering BRCA2 or BRCA1 interaction is foreseeable based on the importance of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability XREF_BIBR - XREF_BIBR, XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"dbd47552-8842-4c41-b80d-e91cd6dd065d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.","type":"Complex","INDRA statement":"Complex(BRCA1(), PALB2(), BRCA2())","Belief score":"0.94","polarity":"none","i":"Complex"}},{"id":376,"s":18,"t":215,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"PALB2\", \"db_refs\": {\"UP\": \"Q86YC2\", \"HGNC\": \"26144\", \"TEXT\": \"PALB2\"}}, {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"These findings emphasise the critical role of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability and prevention of cancer and provide evidence that heterozygosity for rare missense variants of PALB2 may influence cancer risk.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"Conversely, many missense mutations remain as variants of uncertain significance (VUSs), even though the likely impact of PALB2 missense VUSs hindering BRCA2 or BRCA1 interaction is foreseeable based on the importance of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability XREF_BIBR - XREF_BIBR, XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"dbd47552-8842-4c41-b80d-e91cd6dd065d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"In line with this observation, when exogenously expressed in U2OS cells, this hypomorphic in-frame exclusion variant of PALB2 retained BRCA2 interaction and supported RAD51 accumulation at damage induced nuclear foci, a crucial step of DSB and ICL repair mediated by the BRCA1, PALB2, and BRCA2 complex.","type":"Complex","INDRA statement":"Complex(BRCA1(), PALB2(), BRCA2())","Belief score":"0.94","polarity":"none","i":"Complex"}},{"id":369,"s":18,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29459887\", \"text\": \"Some of the proteins that bind to this region of BRCA1 are retinoblastoma protein (RB), the transcription factor c-Myc, DNA repair proteins RAD50, RAD51, and PALB2 that forms a scaffold for BRCA1 and BRCA2 interaction.\", \"annotations\": {\"found_by\": \"binding7a\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29387807\", \"text\": \"Conversely, many missense mutations remain as variants of uncertain significance (VUSs), even though the likely impact of PALB2 missense VUSs hindering BRCA2 or BRCA1 interaction is foreseeable based on the importance of the BRCA1, PALB2, and BRCA2 complex in the maintenance of genome stability XREF_BIBR - XREF_BIBR, XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding7a\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29860059\", \"text\": \"Present study investigated association between TP53 gene (rs1042522G/C), BRCA1 (rs71361504 -/GTT, rs3092986T/C) and BRCA2 (rs206118A/G) and, SNPs and PCOS risk.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"b0c60429-bd56-4746-8ca7-34af3dad2aac\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Some of the proteins that bind to this region of BRCA1 are retinoblastoma protein (RB), the transcription factor c-Myc, DNA repair proteins RAD50, RAD51, and PALB2 that forms a scaffold for BRCA1 and BRCA2 interaction.","type":"Complex","INDRA statement":"Complex(BRCA1(), BRCA2())","Belief score":"0.92","polarity":"none","i":"Complex"}},{"id":102,"s":18,"t":101,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"UP\": \"P38398\", \"HGNC\": \"1100\", \"TEXT\": \"Brca1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"transcription\", \"db_refs\": {\"TEXT\": \"transcription\", \"GO\": \"GO:0006351\", \"MESH\": \"D014158\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29426838\", \"text\": \"Furthermore, our published transcriptomic study clearly indicates that Brca1 exon 11 deletion partially restores the developmentally related transcription program that is impaired in CKO mammary epithelium 37.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29386125\", \"text\": \"By contrast, BRCA1 or SETX depletion causes R-loop accumulation at 3 ' transcription termination sites, distinguishing the mechanism mediated by BRCA2.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"7c712eba-221c-418c-9918-11c583c97dad\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Furthermore, our published transcriptomic study clearly indicates that Brca1 exon 11 deletion partially restores the developmentally related transcription program that is impaired in CKO mammary epithelium 37.","type":"Activation","INDRA statement":"Activation(BRCA1(), transcription())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":353,"s":18,"t":172,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":97,"s":18,"t":96,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"UP\": \"P38398\", \"HGNC\": \"1100\", \"TEXT\": \"Brca1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"genomic_stability\", \"db_refs\": {\"MESH\": \"D042822\", \"TEXT\": \"genomic stability\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29673145\", \"text\": \"Moreover, the upregulation of Brca1 by both 5-Aza-CdR and transgenic Brca1 promoted genomic stability and improved cell viability following exposure to ionizing radiation (IR).\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29673145\", \"text\": \"Moreover, the upregulation of Brca1 by both 5-Aza-CdR and transgenic Brca1 promoted genomic stability and improved cell viability following exposure to ionizing radiation (IR).\", \"annotations\": {\"found_by\": \"Positive_activation_token_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"72437a71-3491-400a-b621-e5c6d35824c2\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Moreover, the upregulation of Brca1 by both 5-Aza-CdR and transgenic Brca1 promoted genomic stability and improved cell viability following exposure to ionizing radiation (IR).","type":"Activation","INDRA statement":"Activation(BRCA1(), genomic_stability())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":349,"s":18,"t":142,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":91,"s":18,"t":90,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"cisplatin\", \"db_refs\": {\"TEXT\": \"cisplatin\", \"CHEBI\": \"CHEBI:27899\", \"PUBCHEM\": \"441203\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"BRCA1 and BRCA2 mediate homologous recombination in DNA repair and inhibition of the BRCA pathway can enhance cisplatin sensitivity in cancer cell lines 46.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29686231\", \"text\": \"Silencing BARD1 or BRCA1 expression or inhibition of BRCA1 phosphorylation by Dinaciclib restores the sensitivity to cisplatin in tamoxifen resistant cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_7_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"1bbad4a0-d417-4177-85cc-a85422d8645b\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"BRCA1 and BRCA2 mediate homologous recombination in DNA repair and inhibition of the BRCA pathway can enhance cisplatin sensitivity in cancer cell lines 46.","type":"Activation","INDRA statement":"Activation(BRCA1(), cisplatin())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":345,"s":18,"t":315,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":83,"s":18,"t":82,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"apoptosis\", \"db_refs\": {\"TEXT\": \"apoptosis\", \"GO\": \"GO:0006915\", \"MESH\": \"D017209\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29187880\", \"text\": \"The PARP-1 inhibitor Olaparib suppresses BRCA1 protein levels, increases apoptosis and causes radiation hypersensitivity in BRCA1 +/- lymphoblastoid cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29718910\", \"text\": \"Brca1 deficient craniofacial skeletogenic precursors displayed increased DNA damage and enhanced cell apoptosis.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29286157\", \"text\": \"We showed that BRCA1 downregulation by miR-212 can be replaced by siRNA, as knockdown of BRCA1 attenuated radiation induced apoptosis.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"9bfb437a-9d20-49e9-9c57-a0a4396b98bf\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"The PARP-1 inhibitor Olaparib suppresses BRCA1 protein levels, increases apoptosis and causes radiation hypersensitivity in BRCA1 +/- lymphoblastoid cells.","type":"Activation","INDRA statement":"Activation(BRCA1(), apoptosis())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":78,"s":18,"t":77,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"LRIF1\", \"db_refs\": {\"UP\": \"Q5T3J3\", \"HGNC\": \"30299\", \"TEXT\": \"RIF1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29427345\", \"text\": \"By contrast, BRCA1 modulates DSB repair pathway with its antagonistic relationship to 53BP1 and RIF1.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_7_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29427345\", \"text\": \"It could also help maintain genomic stability by preventing error-prone repair of accidentally generated seDSB.37 Conversely, loss of BRCA1 induced 53BP1-RIF1 signaling restoration directs the repair pathway to NHEJ and causes RIF1 dependent partial suppression of end resection.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3eec2ce4-eedc-4142-9c17-5a0b77cc039f\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"By contrast, BRCA1 modulates DSB repair pathway with its antagonistic relationship to 53BP1 and RIF1.","type":"Activation","INDRA statement":"Activation(BRCA1(), LRIF1())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":316,"s":18,"t":315,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Given that EDC4 interacts with BRCA1, it is probably a member of at least one of the multiple BRCA1 containing protein complexes : BRCA1-A, BRCA1-B, BRCA1-C, BRCA1/PALB2/BRCA2, and the BRCA1 and BARD1 heterodimer 34.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"Specific functions of BARD1 and BRCA1 heterodimer will not be dealt with in this paragraph.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"In mitosis FL BARD1 stability is increased due to phosphorylation by cell-cycle dependent kinase complexes (cyclin A/E-CDK 2 and cyclin B-CDK2) within regions required for ubiquitin ligase activity of BARD1 and BRCA1 heterodimer [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"We can speculate that the concomitant expression of BARD1 and BRCA1 in S-phase support the function of BARD1 and BRCA1 heterodimer and FL BARD1 expression in mitosis supports additional BRCA1 independent functions.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"Emerging evidences report the interaction of BARD1 BRCT domain to poly (ADP-ribose) (PAR) and consequent recruitment of BARD1 and BRCA1 complex to DNA repair after damage [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"Emerging evidences report the interaction of BARD1 BRCT domain to poly (ADP-ribose) (PAR) and consequent recruitment of BARD1 and BRCA1 complex to DNA repair after damage [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"Recently, Maxim Pilyugin et al. described BARD1delta antagonizes chromosome and telomere protection function of BARD1 and BRCA1 heterodimer by binding molecules that confer chromosome integrity [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"Protein PARylation functions as a signal to recruit DNA damage repair proteins like the BARD1 and BRCA1 complex to repair Double Strand Breaks (DSBs).\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"PARP inhibition directly suppresses the fast recruitment of the BARD1 and BRCA1 heterodimer to DNA damage sites and impairs DNA repair.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"PARP inhibition directly suppresses the fast recruitment of the BARD1 and BRCA1 heterodimer to DNA damage sites and impairs DNA repair.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29371919\", \"text\": \"As EWS-FLI1 is reported to interact with BARD1, which associates with BRCA1, the HRR status of the ES cells was evaluated.\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"BRE and BRCC36 interaction is also important for E3 ligase activity of BRCA1 and BARD1 heterodimer and K-63 deubiquitylase activity of BRCC36 XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29355525\", \"text\": \"We also found that high levels of TACC3 inhibited the interaction between BRCA1 and BARD1, thus subsequently allowing the BARD1 uncoupled BRCA1 to be destabilized by ubiquitin mediated proteosomal pathway.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The BRCA1 and BARD1 complex plays a role in the UV induced inhibition of mRNA 3 ' processing, resulting in the transient decrease of the cellular levels of polyadenylated transcripts.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"mRNA 3 ' processing can be repressed after DNA damage as a result of the interaction of BRCA1 and BARD1 with cleavage stimulation factor 50 (CstF-50) and the proteasome mediated degradation of RNA polymerase (RNAP) II, which is an activator of the cleavage step of the polyadenylation reaction.\", \"annotations\": {\"found_by\": \"binding9\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180619\", \"text\": \"Overall, our results indicate that RNF4 primarily targets SUMO E3 ligases and the SUMO E2, to balance SUMO-ubiquitin signaling, affecting downstream proteins including the BRCA1 and BARD1 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180619\", \"text\": \"The BRCA1 and BARD1 heterodimer functions as a key tumor suppressor.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Therefore, this result suggests that most likely the BRCA1 and BARD1 complex and the polycomb RING1B complex have redundant roles in the UV mediated monoubiquitination of H 2 A. Together, our data indicate that the RNAP II, Ub-H 2 A, and Ub-H 2 B content in genome-wide chromatin changes after DNA damage and that BRCA1 and BARD1, p97, and CstF-50 play roles in those dynamic changes.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Interestingly, the BRCA1 and BARD1 complex interacts with RNAP IIO at sites of DNA damage, preferentially on active genes.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"However, the mechanism underlying the sensitivity of the tumor cells bearing BRCA1 mutations that abolish the interaction between BRCA1 and BARD1 to PARPi is not clear [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29292755\", \"text\": \"The BARD1 and BRCA1 heterodimer has ubiquitin ligase activity that targets proteins involved in cell-cycle regulation, DNA repair, hormone signaling and modulating chromatin structure [XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"9d2ab2d2-1488-4d6d-bf47-7eea18c0d469\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Given that EDC4 interacts with BRCA1, it is probably a member of at least one of the multiple BRCA1 containing protein complexes : BRCA1-A, BRCA1-B, BRCA1-C, BRCA1/PALB2/BRCA2, and the BRCA1 and BARD1 heterodimer 34.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":58,"s":18,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"Our data suggest that CSB phosphorylations on S10 by ATM and on S158 by cyclin A-Cdk2 serve as molecular signals governing its chromatin remodeling activity at DSBs, which inhibits RIF1 but promotes BRCA1 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"In contrast to these models, PRPF8 and other RNA splicing factors could also have a direct role in repair at sites of DNA damage, or conversely could function largely through shaping the transcriptome in such a manner as to specifically disrupt BRCA1 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"Furthermore, transcriptome studies of cells depleted of PRPF8 and XAB2 have not revealed obvious gene expression changes that could explain defects in BRCA1 mediated HR [XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"Subsequently the chromatin remodeling activity of CSB at DSBs evicts histones and disassembles nucleosomes, limiting RIF1 accumulation but paving the way for BRCA1 mediated HR activity in S/G2.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"Furthermore, PRPF8 depletion and PlaB treatment cause reduced end resection detected as chromatin bound RPA, BRCA1 foci in response to damage, and histone acetylation marks that are associated with BRCA1 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"These findings indicate that PRPF8 is important for BRCA1 mediated HR, whereas PlaB also has a more general effect on the DNA damage response and nuclear organization.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29146938\", \"text\": \"The score is negatively correlated with the deficient HR pathway activity caused by BRCA1 or BRCA2 mutation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"Subsequent nucleosome disassembly by CSB at DSBs inhibits RIF1 and paves the way for BRCA1 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29203878\", \"text\": \"These results suggest that the chromatin remodeling activity of CSB is necessary to suppress RIF1 but promote BRCA1 mediated HR in S/G2.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"The mechanism by which inhibition of splicing factors causes defects in BRCA1 mediated HR appears multifaceted, but importantly RNA splicing has significant effects on the chromatin states that facilitate HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29212152\", \"text\": \"Indeed, similar to loss of 53BP1, loss of RNF8 can partially rescue the HR defects caused by BRCA1 depletion [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29533782\", \"text\": \"Poly (ADP-ribose) polymerase inhibitors (PARPi) are selectively active in cells with homologous recombination (HR) deficiency (HRD) caused by mutations in BRCA1, BRCA2, and other pathway members.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29427345\", \"text\": \"Therefore, impaired BRCA1 facilitates NHEJ and suppresses HR leading to genome instability.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"5b36de6c-513c-4ca6-a8fb-29860616f9c8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Our data suggest that CSB phosphorylations on S10 by ATM and on S158 by cyclin A-Cdk2 serve as molecular signals governing its chromatin remodeling activity at DSBs, which inhibits RIF1 but promotes BRCA1 mediated HR.","type":"Activation","INDRA statement":"Activation(BRCA1(), HR())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":54,"s":18,"t":53,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DSB\", \"db_refs\": {\"TEXT\": \"DSB\", \"MESH\": \"D053903\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29427345\", \"text\": \"By contrast, BRCA1 modulates DSB repair pathway with its antagonistic relationship to 53BP1 and RIF1.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"fb7bd539-d423-4401-9615-78aa8eb07e81\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"By contrast, BRCA1 modulates DSB repair pathway with its antagonistic relationship to 53BP1 and RIF1.","type":"Activation","INDRA statement":"Activation(BRCA1(), DSB())","Belief score":"0.88","polarity":"positive","i":"Activation"}},{"id":43,"s":18,"t":42,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DNA_repair\", \"db_refs\": {\"TEXT\": \"DNA repair\", \"GO\": \"GO:0006281\", \"MESH\": \"D004260\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"CHEK2 operates in a complex network of proteins to elicit DNA repair, cell cycle arrest or apoptosis in response to DNA damage 42, and BRCA1 controls homology directed DNA repair 43.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"In addition, some reports have shown that curcumin inhibits BRCA1 expression to suppress DNA repair pathway, so as to inhibit cell viability and increase sensitivity against cisplatin.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"For example, Ting et al. reported that curcumin triggered DNA damage and reduced BRCA1 expression to suppress DNA repair pathway in human lung cancer cells, thereby inhibiting cell viability 50.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29255221\", \"text\": \"Particularly, curcumin involves DNA repair pathway mediated by BRCA1 and BRCA2.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29308536\", \"text\": \"Furthermore, Rabd-B suppressed ATM and ATR phosphorylation, thereby inhibiting BRCA1 mediated DNA repair, which resulted in mitotic catastrophe and induced cell apoptosis.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30014904\", \"text\": \"The breast cancer susceptibility protein 1 (BRCA1), a tumor suppressor, can modulate cellular antioxidant response and DNA repair.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"da8c067d-42a9-4fc2-becd-d24f32e502b9\", \"supported_by\": [\"bca920fd-a626-4d62-9914-b63336fa34aa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"CHEK2 operates in a complex network of proteins to elicit DNA repair, cell cycle arrest or apoptosis in response to DNA damage 42, and BRCA1 controls homology directed DNA repair 43.","type":"Activation","INDRA statement":"Activation(BRCA1(), DNA_repair())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":37,"s":18,"t":36,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DNA_damage_response\", \"db_refs\": {\"GO\": \"GO:0000077\", \"TEXT\": \"DNA damage response\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29335415\", \"text\": \"We wanted to investigate whether DUBs that act on H2A-ubiquitin substrates show site specificity and whether known H2A DUBs would counteract the BRCA1 induced DNA damage response.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29492227\", \"text\": \"BRCA1 deficiency can lead to defects in the S phase, G2/M phase, and spindle checkpoints, causing genetic instability and thus triggering DNA damage response, further increasing the risk of tumor formation [XREF_BIBR - XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"5148cb1f-3439-4611-b69f-ee7b19af6316\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We wanted to investigate whether DUBs that act on H2A-ubiquitin substrates show site specificity and whether known H2A DUBs would counteract the BRCA1 induced DNA damage response.","type":"Activation","INDRA statement":"Activation(BRCA1(), DNA_damage_response())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":27,"s":18,"t":26,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DNA_damage\", \"db_refs\": {\"MESH\": \"D004249\", \"TEXT\": \"DNA damage\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29249653\", \"text\": \"MacroH2A1.2, in turn, facilitates the accumulation of the tumor suppressor and HR effector BRCA1 at replication forks to protect from RS induced DNA damage.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29718910\", \"text\": \"Importantly, the craniofacial skeletal defects were sufficiently rescued by superimposing p53 null alleles in a neural crest specific manner in vivo, indicating that BRCA1 deficiency induced DNA damage, cell apoptosis, and that the pathogenesis of craniofacial bone defects can be compensated by inactivation of p53.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29285471\", \"text\": \"BRCA1 regulates all phases of the cell cycle and triggers the cell response to DNA damage which blocks cell proliferation and promotes apoptosis; therefore, it stops malignant transformation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_7_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29559847\", \"text\": \"The phosphorylation of H2AX (gamma-H2AX) is thought to recruit MRE11-RND51-NSB1 (MRN) directly to DNA-DSBs, and the gamma, H2AX, and MRN complex can recruit other DNA damage signals, such as MDC1 and BRCA1 XREF_BIBR.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_noun_Hearst\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4417b0d4-9ffa-442d-bef1-52bc6f340523\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"MacroH2A1.2, in turn, facilitates the accumulation of the tumor suppressor and HR effector BRCA1 at replication forks to protect from RS induced DNA damage.","type":"Activation","INDRA statement":"Activation(BRCA1(), DNA_damage())","Belief score":"0.94","polarity":"positive","i":"Activation"}},{"id":19,"s":18,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30012171\", \"text\": \"Mechanistically, veliparib or SAHA alone reduced BRCA1 or UHRF1 protein levels, co-treatment with veliparib and SAHA synergistically reduced BRCA1 protein levels by targeting the UHRF1 and BRCA1 protein complex, the depletion of UHRF1 resulted in the degradation of BRCA1 protein, while the elevation of UHRF1 impaired co-treatment-reduced BRCA1 protein levels.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29259228\", \"text\": \"Considering that, at the metabolic level, the HCC70 cell line showed a phenotype similar to BRCA1 mutated BC cell lines, we examined whether its BRCA1 like metabolic phenotype was caused by BRCA1 promoter methylation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29440709\", \"text\": \"These data suggest that acetylation of BRCA1 on lysine 830 activates BRCA1 function at the intra-S checkpoint after DNA damage.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"949d8026-c599-4831-9e60-3d7029ea2e2b\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Mechanistically, veliparib or SAHA alone reduced BRCA1 or UHRF1 protein levels, co-treatment with veliparib and SAHA synergistically reduced BRCA1 protein levels by targeting the UHRF1 and BRCA1 protein complex, the depletion of UHRF1 resulted in the degradation of BRCA1 protein, while the elevation of UHRF1 impaired co-treatment-reduced BRCA1 protein levels.","type":"Activation","INDRA statement":"Activation(BRCA1(), BRCA1())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":271,"s":270,"t":155,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"SH2B3\", \"db_refs\": {\"UP\": \"Q9UQQ2\", \"HGNC\": \"29605\", \"TEXT\": \"Lnk\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCD2\", \"db_refs\": {\"UP\": \"Q9BXW9\", \"HGNC\": \"3585\", \"TEXT\": \"Fancd2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30254368\", \"text\": \"Lnk and Sh2b3 deficiency restores hematopoietic stem cell function and genome integrity in Fancd2 deficient Fanconi anemia.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30254368\", \"text\": \"Remarkably, we reveal here that Lnk (Sh2b3) deficiency restores HSC function in Fancd2\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"fd0009b7-a4e0-46fa-a1c4-8a6392788aa7\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Lnk and Sh2b3 deficiency restores hematopoietic stem cell function and genome integrity in Fancd2 deficient Fanconi anemia.","type":"Activation","INDRA statement":"Activation(SH2B3(), FANCD2())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":408,"s":142,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"CstF-50 and p97 formed complexes with BRCA1 and BARD1, Ub, and some BRCA1 and BARD1 substrates, such as RNA polymerase (RNAP) II and histones.\", \"annotations\": {\"found_by\": \"binding1forms\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Work from different groups has shown that the mRNA processing factor CstF-50 and the Ub escort factor p97 can interact with BRCA1 and BARD1.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"As CstF-50 binds to p97, helps BRCA1 and BARD1 to recognize substrates, and facilitates the attachment of Ub to substrates, we can not rule out the possibility that CstF-50 is a cofactor for BRCA1 and BARD1 Ub ligase functions at the chromatin.\", \"annotations\": {\"found_by\": \"binding6\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"75f4303d-a8d7-4a0d-8aa5-e03c0b30a5e1\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"CstF-50 and p97 formed complexes with BRCA1 and BARD1, Ub, and some BRCA1 and BARD1 substrates, such as RNA polymerase (RNAP) II and histones.","type":"Complex","INDRA statement":"Complex(CSTF1(), BRCA1())","Belief score":"0.92","polarity":"none","i":"Complex"}},{"id":143,"s":142,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"CstF-50 and p97 activate BRCA1 and BARD1 Ub ligase in vitro.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"Next, we tested whether CstF-50 and p97 can activate BRCA1 and BARD1 in trans-ubiquitination reactions using known BRCA1 and BARD1 substrates, such as RNAP II, H 2 A, and H 2 B.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"bb2e5fcf-6f85-4173-9be3-d8a2c0808362\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"CstF-50 and p97 activate BRCA1 and BARD1 Ub ligase in vitro.","type":"Activation","INDRA statement":"Activation(CSTF1(), BRCA1())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":365,"s":142,"t":172,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BARD1\", \"db_refs\": {\"UP\": \"Q99728\", \"HGNC\": \"952\", \"TEXT\": \"BARD1\"}}, {\"name\": \"CSTF1\", \"db_refs\": {\"UP\": \"Q05048\", \"HGNC\": \"2483\", \"TEXT\": \"CstF-50\"}}, {\"name\": \"GEMIN4\", \"db_refs\": {\"UP\": \"P57678\", \"HGNC\": \"15717\", \"TEXT\": \"p97\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29180510\", \"text\": \"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"section_type\": null}}], \"id\": \"d82907c2-f69e-43ca-9753-78f958992e78\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"The formation of the BRCA1, BARD1, CstF-50, and p97 complex allows not only the UV induced ubiquitination of RNAP IIO, which is an important event in DDR, but also monoubiquitination of H 2 A and H 2 B, which results in nucleosome remodeling by displacement of Ub-H 2 A and Ub-H 2 B from UV damaged chromatin and allows access of the repair machinery.","type":"Complex","INDRA statement":"Complex(BRCA1(), BARD1(), CSTF1(), GEMIN4())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":523,"s":522,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"RPA\", \"db_refs\": {\"TEXT\": \"RPA\", \"FPLX\": \"RPA\"}}, {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"RPA binds to RAD51, but this interaction is insufficient to displace RPA from ssDNA.\", \"annotations\": {\"found_by\": \"binding1b\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29176630\", \"text\": \"Later, this death was attributed to the incomplete unloading of recombination factors leading to persistent binding of Rad51 and RPA to the ssDNA surrounding the areas of repair even after the repair has been completed XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"The mere lack of Ku impacts the processing of arrested forks, leading to an extensive resection, a reduced recruitment of RPA and Rad51 and a slower fork-restart process.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"We have analysed the recruitment of RPA and Rad51 to the RTS1-RFB by ChIP-qPCR and found that both RPA and Rad51 were less recruited to arrested forks in pku70-d cells compared to wt.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"In this work, we investigated the resection step of DSB-free arrested forks, a critical step to expose ssDNA and subsequent recruitment of RPA and Rad51 to promote fork-restart 47.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"Third, the lack of Ku impacts several steps of HR mediated fork processing, independently of NHEJ, resulting in an extensive fork-resection, a reduced recruitment of RPA and Rad51 and a slower HR mediated fork-restart process.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"An important finding we made is that the mere lack of Ku slows down the process of HR mediated fork-restart, accompanied with a reduced recruitment of RPA and Rad51.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"f64eba6e-099f-47b6-9455-42eefca77e29\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"RPA binds to RAD51, but this interaction is insufficient to displace RPA from ssDNA.","type":"Complex","INDRA statement":"Complex(RPA(), RAD51())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":400,"s":394,"t":399,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"TOPBP1\", \"db_refs\": {\"UP\": \"Q92547\", \"HGNC\": \"17008\", \"TEXT\": \"TOPBP1\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BRIP1\", \"db_refs\": {\"UP\": \"Q9BX63\", \"HGNC\": \"20473\", \"TEXT\": \"BRIP1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Here, we identify EDC4, a known component of processing-bodies and regulator of mRNA decapping, as a member of the BRCA1, BRIP1, and TOPBP1 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"77dfcb0f-8be6-46c5-a27a-3c36161079c8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.","type":"Complex","INDRA statement":"Complex(TOPBP1(), BRCA1(), BRIP1())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":395,"s":394,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"TOPBP1\", \"db_refs\": {\"UP\": \"Q92547\", \"HGNC\": \"17008\", \"TEXT\": \"TOPBP1\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}, {\"name\": \"BRIP1\", \"db_refs\": {\"UP\": \"Q9BX63\", \"HGNC\": \"20473\", \"TEXT\": \"BRIP1\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Here, we identify EDC4, a known component of processing-bodies and regulator of mRNA decapping, as a member of the BRCA1, BRIP1, and TOPBP1 complex.\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"77dfcb0f-8be6-46c5-a27a-3c36161079c8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Given the association of EDC4 with the TOPBP1, BRCA1, and BRIP1 complex, we next assessed the involvement of EDC4 in HR mediated repair.","type":"Complex","INDRA statement":"Complex(TOPBP1(), BRCA1(), BRIP1())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":137,"s":136,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"COPS5\", \"db_refs\": {\"UP\": \"Q92905\", \"HGNC\": \"2240\", \"TEXT\": \"Jab1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30244171\", \"text\": \"Jab1 and Cops5 contributes to chemoresistance in breast cancer by regulating Rad51.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30244171\", \"text\": \"In the current study, we investigate the hypothesis that Jab1 positively regulates the DNA repair protein Rad51 and, in turn, the cellular response of breast cancer to chemotherapy with adriamycin and cisplatin.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1b_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30244171\", \"text\": \"Moreover, we discovered that Jab1 positively regulated Rad51 in p53 dependent manner and that overexpression of Rad51 conferred cellular resistance to adriamycin and cisplatin in Jab1 deficient cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1b_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"b90413e4-1de7-4d64-81ca-33807c9e8b77\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Jab1 and Cops5 contributes to chemoresistance in breast cancer by regulating Rad51.","type":"Activation","INDRA statement":"Activation(COPS5(), RAD51())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":480,"s":8,"t":479,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}, {\"name\": \"RNApo_II\", \"db_refs\": {\"FPLX\": \"RNApo_II\", \"TEXT\": \"RNAPII\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29386125\", \"text\": \"We show that the human tumor suppressor BRCA2 interacts with RNAPII to regulate PPP release, thereby preventing unscheduled RNA-DNA hybrids (R-loops) implicated in genomic instability and carcinogenesis.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29386125\", \"text\": \"Indeed, RNAPII immunoprecipitated from HeLa Kyoto cell extracts using the N20 antibody interacts with wild-type BRCA2 (XREF_FIG A).\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29386125\", \"text\": \"Conversely, immunoprecipitation of BRCA2 from EUFA423 B2 (XREF_FIG C, lanes 1-3) or EUFA423 (XREF_FIG C, lanes 4-6) cell extracts demonstrates that full-length BRCA2, as well as the cancer associated BRCA2 9000insA truncated mutant protein, interact with RNAPII detected by an antibody (601) against its CTD.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"259dd112-4aef-419a-902c-aa88a9b91a17\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"We show that the human tumor suppressor BRCA2 interacts with RNAPII to regulate PPP release, thereby preventing unscheduled RNA-DNA hybrids (R-loops) implicated in genomic instability and carcinogenesis.","type":"Complex","INDRA statement":"Complex(BRCA2(), RNApo_II())","Belief score":"0.92","polarity":"none","i":"Complex"}},{"id":468,"s":8,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}}, {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29545922\", \"text\": \"BRCA2 interacts with RAD51 and mediates its nuclear entry where it is then recruited to DNA break sites [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29545922\", \"text\": \"BRCA2 directly interacts with RAD51 upon DNA damage and mediates its translocation into the nucleus at the site of damage [XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29340034\", \"text\": \"One of the major cellular HR responses to DNA damage includes the nuclear recruitment of the BRCA2 and Rad51 complex [XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"binding_token_5\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29654063\", \"text\": \"Here, we report that a synthetic 16-mer peptide derived from the BRC4 repeat motif of BRCA2 is capable of blocking RAD51 binding to BRCA2.\", \"annotations\": {\"found_by\": \"binding_token_1\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"Moreover, human BRCA2 can bind at least six monomers of RAD51, via an array of eight evolutionarily conserved motifs (BRC repeats), each of ~ 35 residues.\", \"annotations\": {\"found_by\": \"binding_syntax_23_verb\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29654063\", \"text\": \"Therefore, blocking the interaction between BRCA2 and RAD51 could significantly improve the efficacy of conventional anti-cancer therapies.\", \"annotations\": {\"found_by\": \"binding11\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"179bde66-569c-4a7d-9641-7f4c75be18f5\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"BRCA2 interacts with RAD51 and mediates its nuclear entry where it is then recruited to DNA break sites [XREF_BIBR].","type":"Complex","INDRA statement":"Complex(BRCA2(), RAD51())","Belief score":"0.95","polarity":"none","i":"Complex"}},{"id":681,"s":8,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"Consistent with prior work using confocal microscopy and in vitro studies, BRCA2 depletion inhibited the focalization of RAD51 clusters adjacent to RPA at sites of DNA damage and suppressed RAD51 filament extension as compared to control cells at matched time, stars *** indicate a P-value -- P < 0.001 obtained with two sample two sided Wilcoxon rank sum test.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"Strikingly, deletion of the C-terminal BRCA2 region allows RAD51 localization at sites of DNA damage and initial assembly of RAD51, but prevents the elongation of filaments.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4fbc0bd3-660e-4ab3-8566-edd0063d32a8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Consistent with prior work using confocal microscopy and in vitro studies, BRCA2 depletion inhibited the focalization of RAD51 clusters adjacent to RPA at sites of DNA damage and suppressed RAD51 filament extension as compared to control cells at matched time, stars *** indicate a P-value -- P < 0.001 obtained with two sample two sided Wilcoxon rank sum test.","type":"Inhibition","INDRA statement":"Inhibition(BRCA2(), RAD51())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":674,"s":8,"t":222,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"PDS5A\", \"db_refs\": {\"UP\": \"Q29RF7\", \"HGNC\": \"29088\", \"TEXT\": \"Pds5\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"One possibility is that Brca2 sequesters the Pds5 needed for cohesion away from cohesin, and that Brca2 depletion allows re-localization of the residual Pds5 remaining after depletion back to cohesin.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"We therefore prefer the idea the effects on SA explains their opposing effects on sister chromatid cohesion over the alternative that Brca2 sequesters Pds5 from cohesin to reduce cohesion.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"Instead, Brca2 is more crucial, as Brca2 depletion significantly decreases Pds5 occupancy (XREF_SUPPLEMENTARY).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"Nipped-B and Brca2 depletion reduce Pds5 at all regulatory sequences except PREs, and thus have similar effects on Pds5 binding levels as depletion of Pds5.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"These experiments revealed that depletion of Pds5 or Wapl, but not Brca2, increases the distance that the domains of cohesin occupancy extend outward from origins.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_3_noun\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"f472f482-f121-4198-a320-fa946f660c68\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"One possibility is that Brca2 sequesters the Pds5 needed for cohesion away from cohesin, and that Brca2 depletion allows re-localization of the residual Pds5 remaining after depletion back to cohesin.","type":"Inhibition","INDRA statement":"Inhibition(BRCA2(), PDS5A())","Belief score":"0.95","polarity":"negative","i":"Inhibition"}},{"id":667,"s":8,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29203787\", \"text\": \"Of note, the triple deleted cells did not generate RAD51 foci formation in response to 10Gy irradiation, suggesting that absent PTEN expression did not alter the defective HR induced by Brca2 loss.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29511213\", \"text\": \"Control cells with intact HR repair pathway exhibited efficient functional GFP expression, while, as expected, BRCA1 and BRCA2 depletion by RNAi strongly abolished HR mediated repair.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29464354\", \"text\": \"A deficiency in BRCA1 or BRCA2 within a cell is believed to impair HR repair, termed homologous recombination deficiency (HRD), and place a greater reliance upon alternative DNA repair pathways to repair DSBs, such as non homologous end joining (NHEJ) and microhomology mediated end joining (MMEJ) [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"b88c7f15-935b-4f54-b4c0-653c7bedf73d\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Of note, the triple deleted cells did not generate RAD51 foci formation in response to 10Gy irradiation, suggesting that absent PTEN expression did not alter the defective HR induced by Brca2 loss.","type":"Inhibition","INDRA statement":"Inhibition(BRCA2(), HR())","Belief score":"0.92","polarity":"negative","i":"Inhibition"}},{"id":121,"s":8,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29187880\", \"text\": \"Investigations revealed that both BRCA1 and BRCA2 proteins are active in HR; BRCA1 is a signal mediator, and BRCA2 initiates repair by recruiting Rad51 to DSB XREF_BIBR.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29590107\", \"text\": \"Therefore, instead of RAD52, BRCA2 is thought to mediate RAD51 dependent HR in human cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"Intriguingly, a recent study using dSTORM [52] suggests that BRCA2 may be discretely positioned near the ends of extended RAD51 assemblies, consistent with BRCA2 mediated RAD51 deposition as we propose here.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ce6bfa8b-80d2-4a44-a74f-269b16b11b8b\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Investigations revealed that both BRCA1 and BRCA2 proteins are active in HR; BRCA1 is a signal mediator, and BRCA2 initiates repair by recruiting Rad51 to DSB XREF_BIBR.","type":"Activation","INDRA statement":"Activation(BRCA2(), RAD51())","Belief score":"0.92","polarity":"positive","i":"Activation"}},{"id":112,"s":8,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29590107\", \"text\": \"Therefore, instead of RAD52, BRCA2 is thought to mediate RAD51 dependent HR in human cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29458771\", \"text\": \"The human tumor suppressor BRCA2 is a mediator of HR as it actively facilitates the DNA transactions of the recombination proteins RAD51 and DMC1 in a variety of ways : It stabilizes ssDNA-RAD51 and DMC1 nucleoprotein filaments.\", \"annotations\": {\"found_by\": \"Positive_activation_copula_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29170499\", \"text\": \"Therefore, the defect of BRCA2 causes the stalling of HR repair at the step of RAD51 loading, but sustains activation of Chk1 at unrepaired DSBs.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29533782\", \"text\": \"Poly (ADP-ribose) polymerase inhibitors (PARPi) are selectively active in cells with homologous recombination (HR) deficiency (HRD) caused by mutations in BRCA1, BRCA2, and other pathway members.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"a0e2bb4d-4c3e-4730-be9e-38c9740160a7\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Therefore, instead of RAD52, BRCA2 is thought to mediate RAD51 dependent HR in human cells.","type":"Activation","INDRA statement":"Activation(BRCA2(), HR())","Belief score":"0.98","polarity":"positive","i":"Activation"}},{"id":108,"s":8,"t":107,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"TEXT\": \"BRCA2\", \"UP\": \"P51587\", \"HGNC\": \"1101\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"CD274\", \"db_refs\": {\"UP\": \"Q9NZQ7\", \"HGNC\": \"17635\", \"TEXT\": \"PD-L1\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29170499\", \"text\": \"Using an siRNA library targeting DSB repair genes, we discover that BRCA2 depletion enhances Chk1 dependent PD-L1 upregulation after X-rays or PARP inhibition.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29170499\", \"text\": \"Depletion of BRCA2 enhances PD-L1 upregulation after DSBs.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"3466ecb2-02bc-415c-98e9-0055acc8c9ab\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Using an siRNA library targeting DSB repair genes, we discover that BRCA2 depletion enhances Chk1 dependent PD-L1 upregulation after X-rays or PARP inhibition.","type":"Activation","INDRA statement":"Activation(BRCA2(), CD274())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":568,"s":8,"t":567,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"SA\", \"db_refs\": {\"PUBCHEM\": \"7009579\", \"TEXT\": \"SA\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"This idea is further supported by the finding that Brca2 depletion suppresses both the loss of cohesion and the loss of SA at origins caused by Pds5 depletion.\", \"annotations\": {\"found_by\": \"decrease_amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29447171\", \"text\": \"Brca2 depletion significantly increases SA levels at all regulatory sequences as expected from the metaorigin analysis above (XREF_FIG, XREF_SUPPLEMENTARY).\", \"annotations\": {\"found_by\": \"amount_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"7d005160-e8e9-419b-9e01-fbb5efa70d95\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"This idea is further supported by the finding that Brca2 depletion suppresses both the loss of cohesion and the loss of SA at origins caused by Pds5 depletion.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(BRCA2(), SA())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":9,"s":7,"t":8,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"BABAM2\", \"db_refs\": {\"UP\": \"Q9NXR7\", \"HGNC\": \"1106\", \"TEXT\": \"BRE\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"BRCA2\", \"db_refs\": {\"UP\": \"P51587\", \"HGNC\": \"1101\", \"TEXT\": \"Brca2\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"Taken together, these data further support that BRE overexpression supports the viability of Brca2 KO/KO cells by suppressing DNA damage induced CDC25A degradation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"BRE overexpression supports growth of BRCA2 deficient cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"Bre overexpressing Brca2 KO/KO cells have DNA repair defects.\", \"annotations\": {\"found_by\": \"Positive_activation_token_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"We examined whether Bre overexpression could compensate for the loss of Brca2 and restore those functions in Brca2 KO/KO; MSCV-BRE ES cells XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"We next tested whether BRE overexpression can promote the growth of human BRCA2 deficient cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"BRE overexpression rescues Brca2 KO/KO mES cell 's lethality.\", \"annotations\": {\"found_by\": \"Positive_activation_token_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29416040\", \"text\": \"These results demonstrate that BRE overexpression promotes the growth of Brca2 deficient cells in vivo by regulating CDC25A.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"4ce847dc-b391-429c-9d9a-449b0071b581\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Taken together, these data further support that BRE overexpression supports the viability of Brca2 KO/KO cells by suppressing DNA damage induced CDC25A degradation.","type":"Activation","INDRA statement":"Activation(BABAM2(), BRCA2())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":498,"s":129,"t":497,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}}, {\"name\": \"HSPA\", \"db_refs\": {\"FPLX\": \"HSPA\", \"TEXT\": \"hsp70\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29399332\", \"text\": \"For example, wild-type FANCC interacts with hsp70 to suppress activation of eukaryotic translation initiation factor 2-alpha kinase 2 (PKR) in wild-type cells exposed to IFNgamma and double stranded RNA or IFN and TNF.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399332\", \"text\": \"For example, wild-type FANCC interacts with hsp70 to suppress activation of eukaryotic translation initiation factor 2-alpha kinase 2 (PKR) in wild-type cells exposed to IFNgamma and double stranded RNA or IFN and TNF.\", \"annotations\": {\"found_by\": \"binding13\"}, \"epistemics\": {\"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399332\", \"text\": \"The interaction involves the canonical substrate binding domain of HSP70, and loss of the FANCC and hsp70 interaction results in hyperactivation of PKR in FA cells XREF_BIBR, XREF_BIBR, XREF_BIBR.\", \"annotations\": {\"found_by\": \"binding7a\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"50a3745c-d05f-4c06-b7ce-172b50f7d586\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"For example, wild-type FANCC interacts with hsp70 to suppress activation of eukaryotic translation initiation factor 2-alpha kinase 2 (PKR) in wild-type cells exposed to IFNgamma and double stranded RNA or IFN and TNF.","type":"Complex","INDRA statement":"Complex(FANCC(), HSPA())","Belief score":"0.92","polarity":"none","i":"Complex"}},{"id":605,"s":129,"t":275,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"STAT3\", \"db_refs\": {\"TEXT\": \"Stat3\", \"UP\": \"P40763\", \"HGNC\": \"11364\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"5ce5ec5c-db5f-4b71-bb39-f2ec18cfe7ba\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(FANCC(), STAT3())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":601,"s":129,"t":202,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"IRF8\", \"db_refs\": {\"UP\": \"Q02556\", \"HGNC\": \"5358\", \"TEXT\": \"Icsbp\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In prior studies, we found that Icsbp activated FANCC and FANCF gene transcription during emergency granulopoiesis (encoding Fanconi C and F, respectively (FancC and FancF)).\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"6eb7cdff-454b-41ca-b705-a09937fd3fbe\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(FANCC(), IRF8())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":596,"s":129,"t":128,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"CEBPB\", \"db_refs\": {\"UP\": \"P17676\", \"HGNC\": \"1834\", \"TEXT\": \"C/ebpbeta\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_0\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that knockdown of FancC prevented Icsbp, Stat3, or C/ebpbeta overexpression from rescuing the reporter activity of the MMC treated plasmid (XREF_FIG A).\", \"annotations\": {\"found_by\": \"expression_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"e59597c9-4b6a-4026-9d74-8784eca55ffb\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(FANCC(), CEBPB())","Belief score":"0.92","polarity":"positive","i":"IncreaseAmount"}},{"id":245,"s":1,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"HR is initiated by the loading of the recombinase Rad51 onto ssDNA, with the assistance of mediators such as yeast Rad52 and mammalian BRCA2.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"These data suggest that loss or low levels of RAD51 may lead to activation of RAD51 independent HR in BAC cells.\", \"annotations\": {\"found_by\": \"Positive_activation_nested_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30042186\", \"text\": \"In most eukaryotes, meiotic HR is mediated by two recombinase systems : ubiquitous RAD51 and meiosis specific DMC1.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30042186\", \"text\": \"In the RAD51 mediated HR system, RAD51 and five RAD51 paralogues are essential for normal RAD51 function, but the role of RAD51 in human meiosis is unclear.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"This observation may be interpreted as the gradual completion of RAD51 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29309696\", \"text\": \"In conclusion, our work exemplifies the power of quantitative super-resolution microscopy in dissecting a biochemical reaction in the native cellular milieu with unprecedented spatial resolution, and provides new insight into the mechanisms underlying a key biological process, DSB repair by RAD51 mediated HR.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"RAD51 expression in cyclin A2 depleted MCF-7 cells partially rescued the HR defects.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29207607\", \"text\": \"Ectopic expression of RAD51 rescued HR defects in cyclin A2 depleted cells.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Elevated RAD51 can potentially increase and dysregulate HR activity, leading to harmful genomic rearrangements and loss of genomic integrity.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"We show that whereas moderate suppression of RAD51 reduces HR activity, strong suppression increases this activity to varying levels in different experiments.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"04875383-c2f7-4767-b043-e9612b8f19de\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"HR is initiated by the loading of the recombinase Rad51 onto ssDNA, with the assistance of mediators such as yeast Rad52 and mammalian BRCA2.","type":"Activation","INDRA statement":"Activation(RAD51(), HR())","Belief score":"0.95","polarity":"positive","i":"Activation"}},{"id":240,"s":1,"t":42,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"DNA_repair\", \"db_refs\": {\"TEXT\": \"DNA repair\", \"GO\": \"GO:0006281\", \"MESH\": \"D004260\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29458759\", \"text\": \"Human RAD51 promotes accurate DNA repair by homologous recombination and is involved in protection and repair of damaged DNA replication forks.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"30006631\", \"text\": \"LM7 provides one OS model for the study of PARPi sensitivity through a potential defect in RAD51 mediated DNA repair.\", \"annotations\": {\"found_by\": \"Positive_early_activation\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"ca51bf18-c321-4dcb-9cd6-1296ce6cef34\", \"supported_by\": [\"bca920fd-a626-4d62-9914-b63336fa34aa\"], \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Human RAD51 promotes accurate DNA repair by homologous recombination and is involved in protection and repair of damaged DNA replication forks.","type":"Activation","INDRA statement":"Activation(RAD51(), DNA_repair())","Belief score":"0.86","polarity":"positive","i":"Activation"}},{"id":721,"s":1,"t":57,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"HR\", \"db_refs\": {\"TEXT\": \"HR\", \"GO\": \"GO:0000725\", \"MESH\": \"D059767\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Stronger RAD51 suppression was also associated with mutagenic single strand annealing mediated HR.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"This study highlights an important point that targteing RAD51 alone may not inhibit HR and associated genomic instability but a combined inhibition of RAD51 and RAD51C may make BAC cells static.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29500400\", \"text\": \"Expectedly, depletion of the main HR player RAD51 dramatically reduced HR efficiency.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29590107\", \"text\": \"The depletion of RAD51 almost completely inhibited I-SceI-induced HR repair, as expected (XREF_FIG).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"The depletion of Akt1 or Rad51 alone significantly inhibited HR as shown by reduced GFP expression.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29399538\", \"text\": \"Contrary to our expectations, the stronger RAD51 suppression (by RS2 shRNA) did not inhibit but led to ~ 15% to> = 50% increase in HR activity in various experiments, indicating activation of RAD51 independent HR pathway.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29567272\", \"text\": \"In cultured cells, inhibition of BRD4 by siRNA or INCB054329 reduced expression and function of BRCA1 and RAD51, reduced HR reporter activity, and sensitized the cells to olaparib induced growth inhibition, DNA damage induction and apoptosis.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"71879da3-ca52-461b-9116-8367259d7060\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Stronger RAD51 suppression was also associated with mutagenic single strand annealing mediated HR.","type":"Inhibition","INDRA statement":"Inhibition(RAD51(), HR())","Belief score":"0.95","polarity":"negative","i":"Inhibition"}},{"id":716,"s":1,"t":26,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"DNA_damage\", \"db_refs\": {\"MESH\": \"D004249\", \"TEXT\": \"DNA damage\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"30272025\", \"text\": \"Loss of RAD51, which causes DNA damage and cell death, is also detected in animal models and human patients with pulmonary arterial hypertension.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_5_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29216366\", \"text\": \"Our results showed that enforced expression of miR-193a-3p mimics inhibited the expression of both lnc-RI and RAD51, and consequently enhanced DNA damage as indicated by increased gamma-H2AX expression.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"1bb518fa-03bd-4097-a95a-3b73ea30ac8e\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Loss of RAD51, which causes DNA damage and cell death, is also detected in animal models and human patients with pulmonary arterial hypertension.","type":"Inhibition","INDRA statement":"Inhibition(RAD51(), DNA_damage())","Belief score":"0.86","polarity":"negative","i":"Inhibition"}},{"id":433,"s":1,"t":18,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}}, {\"name\": \"BRCA1\", \"db_refs\": {\"TEXT\": \"BRCA1\", \"UP\": \"P38398\", \"HGNC\": \"1100\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29440569\", \"text\": \"When HPV positive cells are treated with hydroxyurea, this recruitment of RAD51 and BRCA1 to viral genomes is greatly enhanced with little recruitment to damaged cellular DNAs and with retention of the ability of viral genomes to amplify.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29440569\", \"text\": \"Given the preferential recruitment of RAD51 and BRCA1 to viral genes, we next investigated the effect of adding the DNA damaging agent hydroxyurea (HU), which specifically induces replication fork collapse by depleting nucleotide pools, to cells that stably maintain HPV episomes.\", \"annotations\": {\"found_by\": \"binding_of_and\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"33441799-6ac8-4f2e-822a-6cf8fd2b7406\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"When HPV positive cells are treated with hydroxyurea, this recruitment of RAD51 and BRCA1 to viral genomes is greatly enhanced with little recruitment to damaged cellular DNAs and with retention of the ability of viral genomes to amplify.","type":"Complex","INDRA statement":"Complex(RAD51(), BRCA1())","Belief score":"0.86","polarity":"none","i":"Complex"}},{"id":519,"s":1,"t":518,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Complex\", \"members\": [{\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"RAD51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}}, {\"name\": \"MCM\", \"db_refs\": {\"TEXT\": \"MCM\", \"FPLX\": \"MCM\"}}], \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29534671\", \"text\": \"Interaction between RAD51 and MCM Complex Is Essential for RAD51 Foci Forming in Colon Cancer HCT116 Cells.\", \"annotations\": {\"found_by\": \"binding_complex_A_B\"}, \"epistemics\": {\"direct\": true, \"section_type\": null}}], \"id\": \"a29e708d-f34f-49f0-9ee9-5d9663e1d314\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000526\"}","Text":"Interaction between RAD51 and MCM Complex Is Essential for RAD51 Foci Forming in Colon Cancer HCT116 Cells.","type":"Complex","INDRA statement":"Complex(RAD51(), MCM())","Belief score":"0.99","polarity":"none","i":"Complex"}},{"id":261,"s":1,"t":216,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"invasion\", \"db_refs\": {\"TEXT\": \"invasion\", \"MESH\": \"D009361\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29215009\", \"text\": \"The Rad51 filament then promotes homology search and strand invasion with an intact homologous DNA template.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29590107\", \"text\": \"Both yeast and human RAD52 exhibit ssDNA annealing activity [XREF_BIBR, XREF_BIBR], which may be required in the steps following strand invasion mediated by RAD51 [XREF_BIBR, XREF_BIBR], as well as in the RAD51 independent single-strand annealing (SSA) pathway [XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_2_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29216366\", \"text\": \"RAD51, which catalyzes DNA strand invasion and leads to the formation of a physical structure known as a 'D-loop ' between the invading DNA substrate and its homologous DNA sequences, is a critical component of the HR pathway.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_5_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29145865\", \"text\": \"RAD51 then promotes the strand invasion required to complete HR repair and replication fork restart [XREF_BIBR - XREF_BIBR].\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"92a59b60-0940-4ba7-a510-838ced7085d8\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"The Rad51 filament then promotes homology search and strand invasion with an intact homologous DNA template.","type":"Activation","INDRA statement":"Activation(RAD51(), invasion())","Belief score":"0.94","polarity":"positive","i":"Activation"}},{"id":130,"s":128,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"CEBPB\", \"db_refs\": {\"UP\": \"P17676\", \"HGNC\": \"1834\", \"TEXT\": \"C/ebpbeta\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3 or C/ebpbeta rescues DNA repair in a FancC dependent manner.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3 and C/ebpbeta activate separate FANCC promoter cis elements.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"We also found that knockdown of either Stat3 or C/ebpbeta significantly decreased FANCC promoter activity (p < 0.0001, n = 6), but only in IL1beta treated transfectants.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"1b3303e7-5c9e-40b1-892e-72d8d0dcff98\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"We found that Stat3, C/ebpbeta, and Icsbp each activate different FANCC promoter cis elements.","type":"Activation","INDRA statement":"Activation(CEBPB(), FANCC())","Belief score":"0.94","polarity":"positive","i":"Activation"}},{"id":583,"s":128,"t":129,"v":{"supportType":"literature","INDRA json":"{\"type\": \"IncreaseAmount\", \"subj\": {\"name\": \"CEBPB\", \"db_refs\": {\"UP\": \"P17676\", \"HGNC\": \"1834\", \"TEXT\": \"C/ebpbeta\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"FANCC\", \"db_refs\": {\"UP\": \"Q00597\", \"HGNC\": \"3584\", \"TEXT\": \"FANCC\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000011\"}, \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29382715\", \"text\": \"Stat3, C/ebpbeta, and Icsbp may activate FANCC transcription at different times during emergency granulopoiesis.\", \"annotations\": {\"found_by\": \"transcription_1\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"de5ca36e-bdd7-44e5-9ded-ab3f3984bb31\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000183\"}","Text":"In this study, we observed that Stat3 and C/ebpbeta activate FANCC transcription and contribute to DNA repair.","type":"IncreaseAmount","INDRA statement":"IncreaseAmount(CEBPB(), FANCC())","Belief score":"0.86","polarity":"positive","i":"IncreaseAmount"}},{"id":639,"s":0,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Inhibition\", \"subj\": {\"name\": \"AKT1\", \"db_refs\": {\"TEXT\": \"Akt1\", \"UP\": \"P31749\", \"HGNC\": \"391\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000020\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000642\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Importantly, Akt1 depletion significantly reduced the amount of Rad51 protein in the nuclear fraction following irradiation (XREF_FIG B).\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Lack of a significant difference in HR repair between the cells with single knockdown of Rad51 and those with Akt1 and Rad51 double knockdown implies that Akt1 reduces HR repair in a Rad51 dependent manner.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Akt1 has been reported to impair the nuclear localization and foci formation of BRCA1 and Rad51 as well as HR repair in normal tissue and breast cancer cells [XREF_BIBR, XREF_BIBR, XREF_BIBR].\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"In A549 cells, Akt1-KD subtly, yet significantly reduced Rad51 foci number in comparison to con-siRNA transfected cells at 8 h post-irradiation.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Moreover, Akt1 depletion significantly decreased the number of Rad51 foci in the cells at 8 and 24 h post-irradiation.\", \"annotations\": {\"found_by\": \"Negative_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"d6b07710-3cc4-454f-b5a3-2ee751e0a088\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Importantly, Akt1 depletion significantly reduced the amount of Rad51 protein in the nuclear fraction following irradiation (XREF_FIG B).","type":"Inhibition","INDRA statement":"Inhibition(AKT1(), RAD51())","Belief score":"0.95","polarity":"negative","i":"Inhibition"}},{"id":2,"s":0,"t":1,"v":{"supportType":"literature","INDRA json":"{\"type\": \"Activation\", \"subj\": {\"name\": \"AKT1\", \"db_refs\": {\"TEXT\": \"Akt1\", \"UP\": \"P31749\", \"HGNC\": \"391\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000459\"}, \"obj\": {\"name\": \"RAD51\", \"db_refs\": {\"TEXT\": \"Rad51\", \"UP\": \"Q06609\", \"HGNC\": \"9817\"}, \"sbo\": \"http://identifiers.org/sbo/SBO:0000643\"}, \"obj_activity\": \"activity\", \"evidence\": [{\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Akt1 Stimulates Homologous Recombination Repair of DNA Double-Strand Breaks in a Rad51 Dependent Manner.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"We demonstrated that Akt1 stimulates HR mediated DSB repair in a Rad51 dependent manner.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}, {\"source_api\": \"reach\", \"pmid\": \"29156644\", \"text\": \"Interestingly, we also observed that Akt1-KD significantly increases the number of radiation induced Rad51 foci in MCF-7 cells at 12 h after irradiation.\", \"annotations\": {\"found_by\": \"Positive_activation_syntax_1_verb\"}, \"epistemics\": {\"direct\": false, \"section_type\": null}}], \"id\": \"22330d85-0732-43b2-a7c2-2171f3f43f59\", \"sbo\": \"http://identifiers.org/sbo/SBO:0000182\"}","Text":"Akt1 Stimulates Homologous Recombination Repair of DNA Double-Strand Breaks in a Rad51 Dependent Manner.","type":"Activation","INDRA statement":"Activation(AKT1(), RAD51())","Belief score":"0.92","polarity":"positive","i":"Activation"}}]},
