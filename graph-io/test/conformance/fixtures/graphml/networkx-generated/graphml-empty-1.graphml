<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d3" for="node" attr.name="score" attr.type="double" />
  <key id="d2" for="node" attr.name="flag" attr.type="boolean" />
  <key id="d1" for="node" attr.name="tag" attr.type="string" />
  <key id="d0" for="node" attr.name="rank" attr.type="long" />
  <graph edgedefault="undirected">
    <node id="0">
      <data key="d0">1</data>
      <data key="d1">tab	here</data>
      <data key="d2">False</data>
    </node>
    <node id="1">
      <data key="d0">42</data>
      <data key="d1">a&amp;b</data>
    </node>
    <node id="2">
      <data key="d3">123456789.125</data>
      <data key="d1">say "hi"</data>
    </node>
  </graph>
</graphml>
