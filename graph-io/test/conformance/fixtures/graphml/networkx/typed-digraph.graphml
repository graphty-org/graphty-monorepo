<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd">
  <key id="d6" for="edge" attr.name="weight" attr.type="long" />
  <key id="d5" for="edge" attr.name="label" attr.type="string" />
  <key id="d4" for="edge" attr.name="weight" attr.type="double" />
  <key id="d3" for="node" attr.name="big" attr.type="long" />
  <key id="d2" for="node" attr.name="count" attr.type="long" />
  <key id="d1" for="node" attr.name="flag" attr.type="boolean" />
  <key id="d0" for="graph" attr.name="name" attr.type="string" />
  <graph edgedefault="directed">
    <node id="a" />
    <node id="b" />
    <node id="c" />
    <node id="d">
      <data key="d1">True</data>
      <data key="d2">7</data>
      <data key="d3">1099511627776</data>
    </node>
    <edge source="a" target="b">
      <data key="d4">2.5</data>
      <data key="d5">ab</data>
    </edge>
    <edge source="b" target="c">
      <data key="d6">-1</data>
    </edge>
    <data key="d0">digraph with types</data>
  </graph>
</graphml>
