tweenness","v":"10490.858730158627","d":"double"}]},{"networkAttributes":[{"n":"version","v":"1.0","d":"string"},{"n":"author","v":"Pierre Klemmer","d":"string"},{"n":"disease","v":"schizophrenia","d":"string"},{"n":"labels","v":"schizophrenia, psychosis, WikiPathways, AOP-Wiki, DisGeNET, ChEMBL, ChEBI, GO","d":"string"},{"n":"methods","v":"R, RCy3, SPARQL, Cytoscape","d":"string"},{"n":"organism","v":"Homo sapiens","d":"string"},{"n":"rights","v":"Attribution 4.0 International (CC BY 4.0)","d":"string"},{"n":"rightsHolder","v":"Pierre Klemmer","d":"string"},{"n":"name","v":"Schizophrenia risk gene subnetwork with AOP-Wiki, cluster, and pathway data extended with ChEBI compounds relating to toxin roles","d":"string"},{"n":"description","v":"Network of schizophrenia risk genes retrieved from WikiPathways, DisGeNET and a publication by Trubetskoy et al. (2022) in relation to schizophrenia. Genes extended with key events, adverse outcome pathways, and adverse outcomes from AOP-Wiki, as well as associated gene ontology function and pathways the genes come from if available. Also extended using CyTargetLinker's ChEMBL linkset filtered for available ChEBI ID and role. Filtered for chemicals with role &#34;toxin&#34;, &#34;genotoxin&#34;, or &#34;neurotoxin&#34;.<br/>","d":"string"}]},{"cyTableColumn":[{"applies_to":"node_table","n":"name","d":"string"},{"applies_to":"edge_table","n":"interaction","d":"string"},{"applies_to":"node_table","n":"shared name","d":"string"},{"applies_to":"node_table","n":"AOPid","d":"string"},{"applies_to":"node_table","n":"AOPtitle","d":"string"},{"applies_to":"node_table","n":"AOid","d":"string"},{"applies_to":"node_table","n":"AOtitle","d":"string"},{"applies_to":"node_table","n":"Ensembl","d":"string"},{"applies_to":"node_table","n":"HGNCsymbol","d":"string"},{"applies_to":"node_table","n":"KEid","d":"string"},{"applies_to":"node_table","n":"KEisMIEin","d":"string"},{"applies_to":"node_table","n":"KEtitle","d":"string"},{"applies_to":"node_