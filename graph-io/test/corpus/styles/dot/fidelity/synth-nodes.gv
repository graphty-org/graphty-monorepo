digraph synth_nodes {
  graph [rankdir=LR, splines=ortho, bgcolor="#f8f4e8", label="Synthetic node coverage", labelloc=t,
         fontsize=28, fontcolor="#333366", fontname="Helvetica", nodesep=0.25, ranksep=0.6];
  node [style=filled, fillcolor="#ffffff", fontname="Helvetica", fontsize=12];
  edge [color="#888888", arrowsize=0.6];
  s_box [shape=box, fillcolor="#e41a1c", label="box"];
  s_polygon [shape=polygon, fillcolor="#377eb8", label="polygon"];
  s_ellipse [shape=ellipse, fillcolor="#4daf4a", label="ellipse"];
  s_oval [shape=oval, fillcolor="#984ea3", label="oval"];
  s_circle [shape=circle, fillcolor="#ff7f00", label="circle"];
  s_point [shape=point, fillcolor="#ffff33", label="point", width=0.2];
  s_egg [shape=egg, fillcolor="#a65628", label="egg"];
  s_triangle [shape=triangle, fillcolor="#f781bf", label="triangle"];
  s_plaintext [shape=plaintext, fillcolor="#999999", label="plaintext"];
  s_plain [shape=plain, fillcolor="lightblue", label="plain"];
  s_diamond [shape=diamond, fillcolor="palegreen", label="diamond"];
  s_trapezium [shape=trapezium, fillcolor="gold", label="trapezium"];
  s_parallelogram [shape=parallelogram, fillcolor="salmon", label="parallelogram"];
  s_house [shape=house, fillcolor="orchid", label="house"];
  s_pentagon [shape=pentagon, fillcolor="khaki", label="pentagon"];
  s_hexagon [shape=hexagon, fillcolor="turquoise", label="hexagon"];
  s_septagon [shape=septagon, fillcolor="#e41a1c", label="septagon"];
  s_octagon [shape=octagon, fillcolor="#377eb8", label="octagon"];
  s_doublecircle [shape=doublecircle, fillcolor="#4daf4a", label="doublecircle"];
  s_doubleoctagon [shape=doubleoctagon, fillcolor="#984ea3", label="doubleoctagon"];
  s_tripleoctagon [shape=tripleoctagon, fillcolor="#ff7f00", label="tripleoctagon"];
  s_invtriangle [shape=invtriangle, fillcolor="#ffff33", label="invtriangle"];
  s_invtrapezium [shape=invtrapezium, fillcolor="#a65628", label="invtrapezium"];
  s_invhouse [shape=invhouse, fillcolor="#f781bf", label="invhouse"];
  s_Mdiamond [shape=Mdiamond, fillcolor="#999999", label="Mdiamond"];
  s_Msquare [shape=Msquare, fillcolor="lightblue", label="Msquare"];
  s_Mcircle [shape=Mcircle, fillcolor="palegreen", label="Mcircle"];
  s_rect [shape=rect, fillcolor="gold", label="rect"];
  s_rectangle [shape=rectangle, fillcolor="salmon", label="rectangle"];
  s_square [shape=square, fillcolor="orchid", label="square"];
  s_star [shape=star, fillcolor="khaki", label="star"];
  s_none [shape=none, fillcolor="turquoise", label="none"];
  s_underline [shape=underline, fillcolor="#e41a1c", label="underline"];
  s_cylinder [shape=cylinder, fillcolor="#377eb8", label="cylinder"];
  s_note [shape=note, fillcolor="#4daf4a", label="note"];
  s_tab [shape=tab, fillcolor="#984ea3", label="tab"];
  s_folder [shape=folder, fillcolor="#ff7f00", label="folder"];
  s_box3d [shape=box3d, fillcolor="#ffff33", label="box3d"];
  s_component [shape=component, fillcolor="#a65628", label="component"];
  s_promoter [shape=promoter, fillcolor="#f781bf", label="promoter"];
  s_cds [shape=cds, fillcolor="#999999", label="cds"];
  s_terminator [shape=terminator, fillcolor="lightblue", label="terminator"];
  s_utr [shape=utr, fillcolor="palegreen", label="utr"];
  s_primersite [shape=primersite, fillcolor="gold", label="primersite"];
  s_restrictionsite [shape=restrictionsite, fillcolor="salmon", label="restrictionsite"];
  s_fivepoverhang [shape=fivepoverhang, fillcolor="orchid", label="fivepoverhang"];
  s_threepoverhang [shape=threepoverhang, fillcolor="khaki", label="threepoverhang"];
  s_noverhang [shape=noverhang, fillcolor="turquoise", label="noverhang"];
  s_assembly [shape=assembly, fillcolor="#e41a1c", label="assembly"];
  s_signature [shape=signature, fillcolor="#377eb8", label="signature"];
  s_insulator [shape=insulator, fillcolor="#4daf4a", label="insulator"];
  s_ribosite [shape=ribosite, fillcolor="#984ea3", label="ribosite"];
  s_rnastab [shape=rnastab, fillcolor="#ff7f00", label="rnastab"];
  s_proteasesite [shape=proteasesite, fillcolor="#ffff33", label="proteasesite"];
  s_proteinstab [shape=proteinstab, fillcolor="#a65628", label="proteinstab"];
  s_rpromoter [shape=rpromoter, fillcolor="#f781bf", label="rpromoter"];
  s_rarrow [shape=rarrow, fillcolor="#999999", label="rarrow"];
  s_larrow [shape=larrow, fillcolor="lightblue", label="larrow"];
  s_lpromoter [shape=lpromoter, fillcolor="palegreen", label="lpromoter"];
  s_record [shape=record, fillcolor="gold", label="record", label="{<f0> left|<f1> mid\nline|<f2> right}"];
  s_Mrecord [shape=Mrecord, fillcolor="salmon", label="Mrecord", label="{<f0> left|<f1> mid\nline|<f2> right}"];
  n_dashed [style="dashed", fillcolor=none, color=blue, penwidth=2, label="dashed"];
  n_dotted [style="dotted", color="#cc0000", penwidth=2, label="dotted"];
  n_bold [style="bold,filled", fillcolor=lightyellow, label="bold"];
  n_rounded [shape=box, style="rounded,filled", fillcolor=lightcyan, label="rounded"];
  n_diagonals [shape=box, style="diagonals,filled", fillcolor=wheat, label="diagonals"];
  n_striped [shape=box, style=striped, fillcolor="red:green:blue", label="striped"];
  n_wedged [shape=ellipse, style=wedged, fillcolor="red;0.3:yellow;0.3:blue", label="wedged"];
  n_radial [style=radial, fillcolor="white:darkorange", label="radial"];
  n_lingrad [shape=box, fillcolor="yellow:purple", gradientangle=90, label="lingrad"];
  n_lingrad2 [shape=box, fillcolor="#00ff00:#0000ff", gradientangle=315, label="lingrad2"];
  n_invis [style=invis, label="invis"];
  n_unfilled [style="", color=darkgreen, label="unfilled"];
  n_pen0 [penwidth=0, fillcolor=pink, label="pen0"];
  n_pen5 [penwidth=5, color="#2222aa", fillcolor=white, label="pen5"];
  n_periph2 [shape=circle, peripheries=2, fillcolor=lightgrey, label="periph2"];
  n_periph3 [shape=box, peripheries=3, color=purple, fillcolor=white, label="periph3"];
  n_periph0 [shape=box, peripheries=0, fillcolor=lightsalmon, label="periph0"];
  n_alpha [fillcolor="#0000ff40", color="#ff000080", label="alpha"];
  n_hsv [fillcolor="0.650 0.700 0.700", fontcolor=white, label="hsv"];
  n_hsv2 [fillcolor="0.1,0.9,0.9", label="hsv2"];
  n_brewer [colorscheme=blues9, fillcolor=7, color=9, fontcolor=1, label="brewer"];
  n_brewer2 [fillcolor="/accent8/3", label="brewer2"];
  n_x11 [fillcolor=crimson, fontcolor=white, color=navy, label="x11"];
  n_svgname [colorscheme=svg, fillcolor=mediumvioletred, fontcolor=white, label="svgname"];
  n_fixed [shape=box, fixedsize=true, width=2.5, height=0.3, label="fixedsize 2.5 x 0.3 long label clipped"];
  n_big [width=2, height=1.5, fillcolor=lightblue, label="big"];
  n_tiny [width=0.1, height=0.1, fontsize=6, label="t"];
  n_regular [shape=hexagon, regular=true, fillcolor=gold, label="regular"];
  n_sides7 [shape=polygon, sides=7, skew=0.4, distortion=0.3, orientation=20, fillcolor=thistle, label="sides7"];
  n_font8 [fontsize=8, label="font8"];
  n_font36 [fontsize=36, fontcolor="#aa0000", label="font36"];
  n_fontserif [fontname="Times-Bold", fontsize=16, label="fontserif"];
  n_fontmono [fontname="Courier", fontcolor=blue, label="fontmono"];
  n_ltop [shape=box, height=1, labelloc=t, label="label top"];
  n_lbot [shape=box, height=1, labelloc=b, label="label bottom"];
  n_ljust [shape=box, width=2.5, label="left line\lright line\rcenter"];
  n_xlabel [xlabel="outside xlabel", label="has xlabel"];
  n_escN [label="\N in \G"];
  n_multi [label="line one\nline two\nline three"];
  n_empty [label=""];
  n_image [shape=box, image="icon.png", label="image", imagescale=true, labelloc=b];
  n_tooltip [tooltip="a tooltip", URL="https://graphviz.org", label="URL+tooltip"];
  n_html1 [shape=none, fillcolor=none, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" BGCOLOR="lightyellow"><TR><TD BGCOLOR="#4477aa"><FONT COLOR="white"><B>Header</B></FONT></TD></TR><TR><TD PORT="p1" ALIGN="LEFT">row <I>one</I></TD></TR><TR><TD>row two</TD></TR></TABLE>>];
  n_html2 [shape=box, label=<<FONT POINT-SIZE="20" COLOR="red">big red</FONT><BR/><FONT FACE="Courier">mono</FONT> <U>u</U> <S>s</S> x<SUP>2</SUP>>];
  n_html3 [shape=plaintext, label=<<TABLE BORDER="2" COLOR="darkgreen" STYLE="rounded" BGCOLOR="#ddffdd:#88cc88" GRADIENTANGLE="90"><TR><TD>A</TD><TD BGCOLOR="pink">B</TD></TR><TR><TD COLSPAN="2">wide</TD></TR></TABLE>>];
  s_box -> s_polygon -> s_ellipse -> s_oval -> s_circle -> s_point -> s_egg -> s_triangle;
  s_plaintext -> s_plain -> s_diamond -> s_trapezium -> s_parallelogram -> s_house -> s_pentagon -> s_hexagon;
  s_septagon -> s_octagon -> s_doublecircle -> s_doubleoctagon -> s_tripleoctagon -> s_invtriangle -> s_invtrapezium -> s_invhouse;
  s_Mdiamond -> s_Msquare -> s_Mcircle -> s_rect -> s_rectangle -> s_square -> s_star -> s_none;
  s_underline -> s_cylinder -> s_note -> s_tab -> s_folder -> s_box3d -> s_component -> s_promoter;
  s_cds -> s_terminator -> s_utr -> s_primersite -> s_restrictionsite -> s_fivepoverhang -> s_threepoverhang -> s_noverhang;
  s_assembly -> s_signature -> s_insulator -> s_ribosite -> s_rnastab -> s_proteasesite -> s_proteinstab -> s_rpromoter;
  s_rarrow -> s_larrow -> s_lpromoter -> s_record -> s_Mrecord -> n_dashed -> n_dotted -> n_bold;
  n_rounded -> n_diagonals -> n_striped -> n_wedged -> n_radial -> n_lingrad -> n_lingrad2 -> n_invis;
  n_unfilled -> n_pen0 -> n_pen5 -> n_periph2 -> n_periph3 -> n_periph0 -> n_alpha -> n_hsv;
  n_hsv2 -> n_brewer -> n_brewer2 -> n_x11 -> n_svgname -> n_fixed -> n_big -> n_tiny;
  n_regular -> n_sides7 -> n_font8 -> n_font36 -> n_fontserif -> n_fontmono -> n_ltop -> n_lbot;
  n_ljust -> n_xlabel -> n_escN -> n_multi -> n_empty -> n_image -> n_tooltip -> n_html1;
  n_html2 -> n_html3;
  s_terminator -> s_doubleoctagon [constraint=false];
  s_insulator -> n_x11 [constraint=false];
  s_egg -> s_plain [constraint=false];
  n_html3 -> n_radial [constraint=false];
  s_parallelogram -> s_threepoverhang [constraint=false];
  n_pen5 -> s_triangle [constraint=false];
  n_rounded -> s_rect [constraint=false];
  s_circle -> s_trapezium [constraint=false];
  s_rpromoter -> s_proteasesite [constraint=false];
  s_plaintext -> s_star [constraint=false];
  s_trapezium -> n_lingrad2 [constraint=false];
  s_proteinstab -> s_triangle [constraint=false];
  n_html3 -> n_unfilled [constraint=false];
  s_hexagon -> s_rectangle [constraint=false];
  n_hsv2 -> n_pen5 [constraint=false];
  s_record:f0 -> s_Mrecord:f2;
  n_html1:p1 -> n_html2;
}
