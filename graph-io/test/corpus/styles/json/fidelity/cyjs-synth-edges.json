 "style": "node { label: data(id); width: 24; height: 24; background-color: #9ecae1; font-size: 9; }\nedge { width: 2; line-color: #555; curve-style: bezier; }\nedge.curve-bezier { curve-style: bezier; }\nedge.curve-unbundled-bezier { curve-style: unbundled-bezier; control-point-distances: 40 -40; control-point-weights: 0.25 0.75; }\nedge.curve-segments { curve-style: segments; segment-distances: 30 -30; segment-weights: 0.3 0.7; }\nedge.curve-taxi { curve-style: taxi; taxi-direction: downward; taxi-turn: 50%; }\nedge.curve-round-taxi { curve-style: round-taxi; taxi-direction: horizontal; taxi-radius: 10; }\nedge.curve-round-segments { curve-style: round-segments; segment-distances: 30; segment-weights: 0.5; segment-radius: 10; }\nedge.curve-straight { curve-style: straight; }\nedge.curve-straight-triangle { curve-style: straight-triangle; }\nedge.curve-haystack { curve-style: haystack; haystack-radius: 0.5; }\nedge.arrow-tee { target-arrow-shape: tee; source-arrow-shape: tee; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-triangle { target-arrow-shape: triangle; source-arrow-shape: triangle; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-triangle-tee { target-arrow-shape: triangle-tee; source-arrow-shape: triangle-tee; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-circle-triangle { target-arrow-shape: circle-triangle; source-arrow-shape: circle-triangle; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-triangle-cross { target-arrow-shape: triangle-cross; source-arrow-shape: triangle-cross; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-triangle-backcurve { target-arrow-shape: triangle-backcurve; source-arrow-shape: triangle-backcurve; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-vee { target-arrow-shape: vee; source-arrow-shape: vee; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-square { target-arrow-shape: square; source-arrow-shape: square; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-circle { target-arrow-shape: circle; source-arrow-shape: circle; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-diamond { target-arrow-shape: diamond; source-arrow-shape: diamond; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-chevron { target-arrow-shape: chevron; source-arrow-shape: chevron; target-arrow-color: red; source-arrow-color: blue; }\nedge.arrow-hollow { target-arrow-shape: triangle; target-arrow-fill: hollow; arrow-scale: 2; }\nedge.arrow-mid { mid-target-arrow-shape: triangle; mid-source-arrow-shape: circle; }\nedge.arrow-small { target-arrow-shape: vee; arrow-scale: 0.5; }\nedge.dashed { line-style: dashed; line-dash-pattern: 8 4; width: 3; }\nedge.dotted { line-style: dotted; width: 4; }\nedge.thick { width: 10; line-color: rgba(200,0,0,0.5); }\nedge.hsl { line-color: hsl(200,80%,40%); width: 3; }\nedge.opacity { opacity: 0.3; width: 6; line-color: black; }\nedge.line-opacity { line-opacity: 0.5; width: 6; }\nedge.gradient { line-fill: linear-gradient; line-gradient-stop-colors: cyan magenta; width: 5; }\nedge.label { label: data(lbl); font-size: 12; color: #c00; }\nedge.label-auto { label: data(lbl); edge-text-rotation: autorotate; text-background-color: #ff0; text-background-opacity: 1; }\nedge.label-ends { source-label: src; target-label: tgt; source-text-offset: 20; target-text-offset: 20; }\nedge.label-margin { label: data(lbl); text-margin-y: -10; text-outline-width: 2; text-outline-color: #fff; }\nedge.hidden { visibility: hidden; }\nedge.none { display: none; }\nedge.z { z-index: 99; width: 8; line-color: orange; }\nedge.mapped-w { width: mapData(w, 0, 10, 1, 12); line-color: mapData(w, 0, 10, green, purple); }\nedge.loop { loop-direction: -45deg; loop-sweep: 30deg; line-color: #2ca02c; }\nedge.loop2 { loop-direction: 90deg; line-color: #d62728; }\nedge.par { control-point-step-size: 20; target-arrow-shape: triangle; }\n:parent { background-opacity: 0.2; padding: 15; label: data(label); text-valign: top; border-width: 2; }\nnode.grp0 { background-color: #1f77b4; shape: round-rectangle; border-style: dashed; }\nnode.grp1 { background-color: #ff7f0e; shape: barrel; }\nnode.grp2 { background-color: #2ca02c; border-color: #000; compound-sizing-wrt-labels: include; }\nnode.inner { background-color: #d62728; padding: 5; }\nedge.cross { line-color: purple; width: 3; target-arrow-shape: triangle; }\nedge.between { line-color: gray; width: 6; line-style: dashed; }\nnode:childless[id ^= 'g1'] { shape: hexagon; }"
