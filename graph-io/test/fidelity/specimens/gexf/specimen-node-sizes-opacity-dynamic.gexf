<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:viz="http://gexf.net/1.3/viz" version="1.3">
  <meta lastmodifieddate="2026-10-18">
    <creator>graphty gexf-gephi specimen generator</creator>
    <description>A dynamic GEXF (mode=dynamic, timeformat=double): nodes and edges with time intervals, and viz values listed several times with their own intervals.</description>
  </meta>
  <graph mode="dynamic" timeformat="double" defaultedgetype="undirected">
    <nodes>
      <node id="anchor-nw">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="20" y="880"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-ne">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1180" y="880"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-sw">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="20" y="20"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-se">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1180" y="20"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="default">
        <viz:position x="110" y="464"/>
      </node>
      <node id="cap-default" label="spells=none">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="110" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="color-timed-in-order">
        <viz:color r="255" g="0" b="0" start="1" end="3"/>
        <viz:color r="0" g="0" b="255" start="3" end="5"/>
        <viz:position x="250" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-color-timed-in-order" label="colors=red 1-3, blue 3-5">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="250" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="color-timed-last-earlier">
        <viz:color r="0" g="0" b="255" start="3" end="5"/>
        <viz:color r="255" g="0" b="0" start="1" end="3"/>
        <viz:position x="390" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-color-timed-last-earlier" label="colors=blue 3-5, red 1-3">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="390" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="size-timed">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="530" y="464"/>
        <viz:size value="6" start="1" end="2"/>
        <viz:size value="18" start="2" end="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-size-timed" label="sizes=6 1-2, 18 2-3">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="530" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="position-timed">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="670" y="524" start="1" end="2"/>
        <viz:position x="670" y="464" start="2" end="3"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-position-timed" label="positions=60px up 1-2, here 2-3">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="670" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="node-interval" start="1" end="2">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="810" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-node-interval" label="start-end=1-2">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="810" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="node-spells">
        <spells>
          <spell start="1" end="2"/>
          <spell start="4" end="5"/>
        </spells>
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="950" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-node-spells" label="spells=1-2, 4-5">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="950" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="edge-interval-s">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1052" y="464"/>
        <viz:size value="4"/>
        <viz:shape value="disc"/>
      </node>
      <node id="edge-interval-t">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1128" y="464"/>
        <viz:size value="4"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-edge-interval" label="edge start-end=1-2">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="1090" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
    </nodes>
    <edges>
      <edge id="edge-interval" source="edge-interval-s" target="edge-interval-t" weight="1.5" start="1" end="2">
        <viz:color r="80" g="80" b="80"/>
        <viz:thickness value="1.5"/>
        <viz:shape value="solid"/>
      </edge>
    </edges>
  </graph>
</gexf>
