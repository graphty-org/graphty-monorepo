        <viz:position x="1128" y="464"/>
        <viz:size value="4"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-edge-timestamps" label="edge timestamps=[2]">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="1090" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
    </nodes>
    <edges>
      <edge id="edge-timestamps" source="edge-timestamps-s" target="edge-timestamps-t" weight="1.5" timestamps="[2]">
        <viz:color r="80" g="80" b="80"/>
        <viz:thickness value="1.5"/>
        <viz:shape value="solid"/>
      </edge>
    </edges>
  </graph>
</gexf>
