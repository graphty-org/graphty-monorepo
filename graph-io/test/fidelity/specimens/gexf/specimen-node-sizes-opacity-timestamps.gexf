<?xml version="1.0" encoding="UTF-8"?>
<gexf xmlns="http://gexf.net/1.3" xmlns:viz="http://gexf.net/1.3/viz" version="1.3">
  <meta lastmodifieddate="2026-10-18">
    <creator>graphty gexf-gephi specimen generator</creator>
    <description>A dynamic GEXF with timerepresentation=timestamp (timeformat=double): nodes and edges with timestamp / timestamps, a timestamped spell, and viz values listed several times with their own timestamps.</description>
  </meta>
  <graph mode="dynamic" timeformat="double" timerepresentation="timestamp" defaultedgetype="undirected">
    <nodes>
      <node id="anchor-nw">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="20" y="880"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-ne">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1180" y="880"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-sw">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="20" y="20"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="anchor-se">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="1180" y="20"/>
        <viz:size value="3"/>
        <viz:shape value="disc"/>
      </node>
      <node id="default">
        <viz:position x="110" y="464"/>
      </node>
      <node id="cap-default" label="timestamps=none">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="110" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="node-timestamp" timestamp="2">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="250" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-node-timestamp" label="timestamp=2">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="250" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="node-timestamps" timestamps="[1,3]">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="390" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-node-timestamps" label="timestamps=[1,3]">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="390" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="node-spell-timestamp">
        <spells>
          <spell timestamp="5"/>
        </spells>
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="530" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-node-spell-timestamp" label="spell timestamp=5">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="530" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="color-timestamped">
        <viz:color r="255" g="0" b="0" timestamp="1"/>
        <viz:color r="0" g="0" b="255" timestamp="4"/>
        <viz:position x="670" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-color-timestamped" label="colors=red @1, blue @4">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="670" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="color-timestamped-last-earlier">
        <viz:color r="0" g="0" b="255" timestamp="4"/>
        <viz:color r="255" g="0" b="0" timestamp="1"/>
        <viz:position x="810" y="464"/>
        <viz:size value="18"/>
        <viz:shape value="disc"/>
      </node>
      <node id="cap-color-timestamped-last-earlier" label="colors=blue @4, red @1">
        <viz:color r="255" g="255" b="255"/>
        <viz:position x="810" y="424"/>
        <viz:size value="14"/>
        <viz:shape value="disc"/>
      </node>
      <node id="size-timestamped">
        <viz:color r="200" g="200" b="200"/>
        <viz:position x="950" y="464"/>
        <viz:size value="6" timestamp="1"/>
        <viz:size value="18" timestamp="2"/>
