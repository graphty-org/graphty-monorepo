<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:y="http://www.yworks.com/xml/graphml" xmlns:yed="http://www.yworks.com/xml/yed/3">
  <!--Authored for graph-io's file-positions tests: a group with two realizers (the second active), a GenericNode and a ShapeNode-->
  <key for="node" id="d6" yfiles.type="nodegraphics"/>
  <graph edgedefault="directed" id="G">
    <node id="shape">
      <data key="d6">
        <y:ShapeNode>
          <y:Geometry height="30.0" width="40.0" x="100.0" y="50.0"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="generic">
      <data key="d6">
        <y:GenericNode configuration="com.yworks.flowchart.process">
          <y:Geometry height="20.0" width="60.0" x="-30.0" y="200.0"/>
        </y:GenericNode>
      </data>
    </node>
    <node id="group" yfiles.foldertype="group">
      <data key="d6">
        <y:ProxyAutoBoundsNode>
          <y:Realizers active="1">
            <y:GroupNode>
              <y:Geometry height="50.0" width="50.0" x="0.0" y="0.0"/>
              <y:State closed="true"/>
            </y:GroupNode>
            <y:GroupNode>
              <y:Geometry height="120.0" width="160.0" x="200.0" y="20.0"/>
              <y:State closed="false"/>
            </y:GroupNode>
          </y:Realizers>
        </y:ProxyAutoBoundsNode>
      </data>
      <graph edgedefault="directed" id="group:">
        <node id="group::inner">
          <data key="d6">
            <y:ShapeNode>
              <y:Geometry height="30.0" width="30.0" x="230.0" y="70.0"/>
            </y:ShapeNode>
          </data>
        </node>
      </graph>
    </node>
    <edge id="e0" source="shape" target="generic"/>
  </graph>
</graphml>
