{
    "name": "@graphty/graph-samples",
    "version": "0.1.1",
    "private": false,
    "description": "Seeded, reproducible graph generators and classic sample datasets as typed arrays for the @graphty/graph-format snapshot",
    "author": "Adam Powers <apowers@ato.ms>",
    "type": "module",
    "main": "dist/graph-samples.js",
    "types": "dist/graph-samples.d.ts",
    "typesVersions": {
        "*": {
            "generators": [
                "dist/generators.d.ts"
            ],
            "datasets/*": [
                "dist/datasets/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "types": "./dist/graph-samples.d.ts",
            "import": "./dist/graph-samples.js",
            "default": "./dist/graph-samples.js"
        },
        "./generators": {
            "types": "./dist/generators.d.ts",
            "import": "./dist/generators.js",
            "default": "./dist/generators.js"
        },
        "./datasets/*": {
            "types": "./dist/datasets/*.d.ts",
            "import": "./dist/datasets/*.js",
            "default": "./dist/datasets/*.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist/",
        "!dist/*.tsbuildinfo",
        "src/",
        "README.md",
        "LICENSE",
        "NOTICE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:bundle": "node scripts/build-bundle.js",
        "build:all": "npm run build && npm run build:bundle",
        "lint": "eslint && tsc --noEmit -p tsconfig.json",
        "lint:fix": "eslint --fix",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "datasets:convert": "node scripts/convert-datasets.mjs",
        "datasets:hosted": "node scripts/build-hosted.mjs",
        "ready:commit": "npm run build:all && npm run lint && npm run test:run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "graph-samples"
    },
    "keywords": [
        "graph",
        "network",
        "generator",
        "random-graph",
        "erdos-renyi",
        "barabasi-albert",
        "watts-strogatz",
        "stochastic-block-model",
        "karate-club",
        "dataset",
        "graph-format"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/graph-samples#readme",
    "dependencies": {
        "@graphty/graph-format": "workspace:^"
    },
    "peerDependencies": {
        "@graphty/graph-format": "^1.0.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "typescript": "^5.9.3",
        "vite": "^7.0.5",
        "vitest": "^3.2.4"
    }
}
