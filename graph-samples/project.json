{
    "name": "graph-samples",
    "$schema": "../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "graph-samples/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/dist"],
            "options": {
                "command": "npm run build:all",
                "cwd": "graph-samples"
            },
            "dependsOn": ["^build"]
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run test:run",
                "cwd": "graph-samples"
            }
        },
        "test:ui": {
            "executor": "nx:run-commands",
            "options": {
                "command": "vitest --ui",
                "cwd": "graph-samples"
            }
        },
        "coverage": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run coverage",
                "cwd": "graph-samples"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run lint",
                "cwd": "graph-samples"
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npm run typecheck",
                "cwd": "graph-samples"
            }
        }
    }
}
