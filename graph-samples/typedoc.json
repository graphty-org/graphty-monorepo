{
    "$schema": "https://typedoc.org/schema.json",
    "entryPoints": ["./src/index.ts", "./src/generators/index.ts", "./src/datasets/*/index.ts"],
    "entryPointStrategy": "resolve",
    "tsconfig": "./tsconfig.build.json",
    "out": "./docs/api/generated",
    "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
    "readme": "none",
    "excludePrivate": true,
    "excludeProtected": true,
    "excludeInternal": true,
    "excludeExternals": true,
    "hideGenerator": true,
    "sanitizeComments": true,
    "sort": ["alphabetical"],
    "kindSortOrder": ["Class", "Interface", "TypeAlias", "Function", "Variable"],
    "validation": { "notExported": true, "invalidLink": true, "notDocumented": true },
    "externalPattern": ["**/node_modules/**", "**/graph-format/**"],
    "docsRoot": "./docs"
}
