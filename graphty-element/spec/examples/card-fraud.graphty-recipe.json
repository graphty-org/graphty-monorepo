{
    "$schema": "https://graphty.app/schema/documents/graphty-recipe/v2.json",
    "kind": "graphty-recipe",
    "version": 2,
    "id": "org.example-bank.card-testing-sweep",
    "name": "Card-testing sweep",
    "description": "Keeps the week's activity, ranks accounts, finds device rings and flags high-risk accounts.",
    "created": "2026-08-19T15:00:00.000Z",
    "modified": "2026-11-03T19:30:00.000Z",
    "generator": {
        "name": "graphty-element",
        "version": "3.40.0"
    },
    "dependencies": {
        "columns": [
            {
                "kind": "edge",
                "name": "time",
                "schema": {
                    "type": "string",
                    "format": "date-time",
                    "measurement": "time"
                }
            },
            {
                "kind": "edge",
                "name": "amount",
                "schema": {
                    "type": "number",
                    "measurement": "quantitative",
                    "unit": "USD"
                }
            }
        ],
        "types": ["account", "device"],
        "sources": ["accounts"]
    },
    "namespace": "card_testing",
    "commands": [
        {
            "op": "graph.filter",
            "on": "edges",
            "where": "data.time >= '2026-11-09'",
            "description": "Only this week's activity."
        },
        {
            "op": "algo.run",
            "algorithm": "pagerank",
            "as": "pagerank",
            "params": {
                "dampingFactor": 0.85
            },
            "style": false
        },
        {
            "op": "algo.run",
            "algorithm": "louvain",
            "as": "communities",
            "params": {
                "resolution": 1
            },
            "scope": {
                "types": ["account", "device"]
            },
            "seed": 1873,
            "style": false,
            "description": "Accounts that share devices fall into one group."
        },
        {
            "op": "set.define",
            "id": "set_01JCBPX7K2M4Q8R1T5V9W3Y6ZA",
            "name": "High-risk accounts",
            "reading": "induced",
            "where": {
                "kind": "all",
                "of": [
                    {
                        "kind": "source",
                        "sources": ["accounts"]
                    },
                    {
                        "kind": "expression",
                        "where": "results.pagerank.value > 0.2"
                    }
                ]
            }
        },
        {
            "op": "layout.set",
            "id": "force",
            "engine": "ngraph",
            "dimension": 3,
            "options": {
                "seed": 52211
            }
        }
    ]
}
