{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/common/v2.json",
    "title": "graphty documents version 2: shared definitions",
    "description": "Definitions the version 2 schemas share: the header, ids, element references, rule trees, style layers and join steps.",
    "$defs": {
        "timestamp": {
            "type": "string",
            "description": "A UTC instant as JavaScript's toISOString() writes it, ending Z.",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
        },
        "sha256": {
            "type": "string",
            "description": "sha256: followed by 64 lower-case hex digits.",
            "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reverseDomain": {
            "type": "string",
            "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)(\\.[a-z0-9]+(-[a-z0-9]+)*)+$"
        },
        "generator": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                }
            }
        },
        "extensions": {
            "type": "object",
            "description": "Data for other software, keyed by reverse-domain name. graphty and graphty.* are reserved. Kept unread on re-save.",
            "propertyNames": {
                "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)(\\.[a-z0-9]+(-[a-z0-9]+)*)+$|^graphty$"
            }
        },
        "author": {
            "type": "object",
            "required": ["name"],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "uri": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "unevaluatedProperties": false
        },
        "header": {
            "type": "object",
            "description": "The fields every section begins with (spec/README.md, 'The section header'). The top level of a section is open: unknown members are kept on re-save.",
            "required": ["kind", "version", "generator"],
            "properties": {
                "$schema": {
                    "type": "string",
                    "format": "uri"
                },
                "kind": {
                    "type": "string"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1
                },
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                },
                "name": {
                    "type": "string",
                    "maxLength": 1024
                },
                "description": {
                    "type": "string",
                    "maxLength": 65536
                },
                "created": {
                    "$ref": "#/$defs/timestamp"
                },
                "modified": {
                    "$ref": "#/$defs/timestamp"
                },
                "generator": {
                    "$ref": "#/$defs/generator"
                },
                "authors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/author"
                    }
                },
                "license": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                },
                "keywords": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                    }
                },
                "language": {
                    "type": "string",
                    "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
                },
                "origin": {
                    "type": "object",
                    "required": ["from"],
                    "properties": {
                        "from": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/extensions"
                },
                "revision": false
            }
        },
        "extensionDependency": {
            "type": "object",
            "required": ["name", "version"],
            "properties": {
                "name": {
                    "$ref": "#/$defs/reverseDomain"
                },
                "version": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "unevaluatedProperties": false
        },
        "columnSchema": {
            "type": "object",
            "description": "A JSON Schema (draft 2020-12) fragment for one column, with graphty's keywords measurement (an open vocabulary: categorical, ordinal, quantitative, time) and unit.",
            "properties": {
                "measurement": {
                    "type": "string",
                    "minLength": 1
                },
                "unit": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "columnDependency": {
            "type": "object",
            "properties": {
                "kind": {
                    "enum": ["node", "edge"]
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "schema": {
                    "$ref": "#/$defs/columnSchema"
                }
            },
            "required": ["kind", "name", "schema"],
            "description": "A working column a reusable section needs, spelled as graphty-element's ColumnRef, and the schema the mapping step checks it against.",
            "unevaluatedProperties": false
        },
        "reusableDependencies": {
            "type": "object",
            "properties": {
                "columns": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/columnDependency"
                    }
                },
                "types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/typeName"
                    },
                    "uniqueItems": true
                },
                "sources": {
                    "type": "array",
                    "description": "The source role names the section names.",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/runName"
                    },
                    "uniqueItems": true
                },
                "extensions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/extensionDependency"
                    }
                }
            }
        },
        "boundDependencies": {
            "type": "object",
            "properties": {
                "extensions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/extensionDependency"
                    }
                }
            }
        },
        "bindsToData": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                }
            },
            "required": ["data"],
            "description": "The data section id this section was written on.",
            "unevaluatedProperties": false
        },
        "typeName": {
            "type": "string",
            "description": "A node or edge type name. It never contains a colon.",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^:]+$"
        },
        "space": {
            "type": "string",
            "description": "An opaque id space, compared exactly after NFC normalization, never parsed. A type name, shared:<name> and source:<source id> are only the names a writer proposes.",
            "minLength": 1
        },
        "sourceId": {
            "type": "string",
            "description": "src_ plus a ULID, minted by graphty-element and never reused; the reader source's id is always reader.",
            "pattern": "^(src_[0-9A-HJKMNP-TV-Z]{26}|reader)$"
        },
        "namespace": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "not": {
                "pattern": "__|_$"
            }
        },
        "runName": {
            "type": "string",
            "description": "A run's name within its recipe or namespace (the as of algo.run).",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$",
            "not": {
                "pattern": "__"
            }
        },
        "runId": {
            "type": "string",
            "description": "Any string of these characters, in graphty-element's own minted form: <namespace>__<as> for a recipe-made run, the element's own id for a hand-started one.",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "setId": {
            "type": "string",
            "description": "set_ plus a ULID; set_<namespace>.<ULID> once a recipe's set is applied under a namespace.",
            "pattern": "^set_([a-z][a-z0-9_]*\\.)?[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "columnRef": {
            "type": "object",
            "required": ["kind", "name"],
            "properties": {
                "kind": {
                    "enum": ["node", "edge"]
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "unevaluatedProperties": false
        },
        "nodeRef": {
            "type": "object",
            "description": "A node by record key. Closed: a reference with any other shape is kept and reported unbound.",
            "required": ["space", "key"],
            "properties": {
                "space": {
                    "$ref": "#/$defs/space"
                },
                "key": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "edgeRef": {
            "type": "object",
            "description": "An edge by record key: load names the source whose row made it, key its edge-id value, a minted ULID for a reader-added edge, or <copy id>#<row from 0> for a keyless row. Closed.",
            "required": ["load", "key"],
            "properties": {
                "load": {
                    "$ref": "#/$defs/sourceId"
                },
                "key": {
                    "type": "string"
                }
            },
            "unevaluatedProperties": false
        },
        "elementRef": {
            "type": "object",
            "description": "A node or an edge, tagged.",
            "oneOf": [
                {
                    "required": ["node"],
                    "properties": {
                        "node": {
                            "$ref": "#/$defs/nodeRef"
                        }
                    },
                    "not": {
                        "required": ["edge"]
                    }
                },
                {
                    "required": ["edge"],
                    "properties": {
                        "edge": {
                            "$ref": "#/$defs/edgeRef"
                        }
                    },
                    "not": {
                        "required": ["node"]
                    }
                }
            ]
        },
        "position": {
            "type": "object",
            "properties": {
                "x": {
                    "type": "number"
                },
                "y": {
                    "type": "number"
                },
                "z": {
                    "type": "number"
                }
            },
            "required": ["x", "y", "z"],
            "description": "A point in the scene frame (left-handed, y up, layout units). A 2D drawing writes z as 0.",
            "unevaluatedProperties": false
        },
        "number": {
            "description": "A number, or one plain JSON cannot carry: Infinity, -Infinity or NaN, read as a number only where the declared type is number.",
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "enum": ["Infinity", "-Infinity", "NaN"]
                }
            ]
        },
        "expression": {
            "type": "string",
            "description": "A predicate in graphty-element's expression language (a JMESPath subset with no functions) over {data, results}.",
            "minLength": 1,
            "maxLength": 1024
        },
        "path": {
            "type": "string",
            "description": "data.<column> or results.<run>.<field>.",
            "minLength": 1,
            "maxLength": 1024
        },
        "edgeReading": {
            "type": "string",
            "description": "Which edges come with a set's nodes: induced, listed, clipped, incident (an open vocabulary).",
            "minLength": 1
        },
        "reusableRuleTree": {
            "type": "object",
            "description": "A rule tree that names no element. all, any and not combine; every other kind is a leaf (an open vocabulary), passed to graphty-element's rule evaluator as written. No neighborhood seeds, listed nodes or item pinned to one run; source leaves name roles.",
            "required": ["kind"],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "enum": ["all", "any"]
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["of"],
                        "properties": {
                            "of": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/reusableRuleTree"
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "not"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["of"],
                        "properties": {
                            "of": {
                                "$ref": "#/$defs/reusableRuleTree"
                            }
                        }
                    }
                },
                {
                    "not": {
                        "properties": {
                            "kind": {
                                "enum": ["neighborhood", "item", "ids"]
                            }
                        },
                        "required": ["kind"]
                    }
                }
            ]
        },
        "boundRuleTree": {
            "type": "object",
            "description": "A rule tree in a dataset-bound section: element-naming leaves hold element references; source leaves name source ids.",
            "required": ["kind"],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "enum": ["all", "any"]
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["of"],
                        "properties": {
                            "of": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/boundRuleTree"
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "not"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["of"],
                        "properties": {
                            "of": {
                                "$ref": "#/$defs/boundRuleTree"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "neighborhood"
                            }
                        },
                        "required": ["kind"]
                    },
                    "then": {
                        "required": ["seeds", "depth"],
                        "properties": {
                            "seeds": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/$defs/nodeRef"
                                }
                            },
                            "depth": {
                                "type": "integer",
                                "minimum": 0
                            }
                        }
                    }
                }
            ]
        },
        "rgba": {
            "type": "object",
            "required": ["r", "g", "b", "a"],
            "properties": {
                "r": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "g": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "b": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 255
                },
                "a": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "unevaluatedProperties": false
        },
        "color": {
            "oneOf": [
                {
                    "type": "string",
                    "minLength": 1
                },
                {
                    "$ref": "#/$defs/rgba"
                }
            ]
        },
        "channelName": {
            "type": "string",
            "description": "A style channel (node.color) or a shader parameter address (node.shaders.<id>.<param>). An open vocabulary.",
            "pattern": "^(node|edge|graph)\\.[A-Za-z0-9_.-]+$"
        },
        "staticStyle": {
            "type": "object",
            "description": "Channel values. Channel names are an open vocabulary; a reader fails an unknown channel alone. Values naming built-ins (node.shape, edge.style, arrowheads) are names from spec/builtins.md.",
            "propertyNames": {
                "$ref": "#/$defs/channelName"
            },
            "properties": {
                "node.color": {
                    "$ref": "#/$defs/color"
                },
                "node.outline": {
                    "$ref": "#/$defs/color"
                },
                "node.glow": {
                    "$ref": "#/$defs/color"
                },
                "edge.color": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowHeadColor": {
                    "$ref": "#/$defs/color"
                },
                "edge.arrowTailColor": {
                    "$ref": "#/$defs/color"
                },
                "node.size": {
                    "type": "number",
                    "minimum": 0
                },
                "edge.width": {
                    "type": "number",
                    "minimum": 0
                },
                "node.opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "edge.opacity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "node.shape": {
                    "type": "string",
                    "minLength": 1
                },
                "edge.style": {
                    "type": "string",
                    "minLength": 1
                },
                "edge.arrowHead": {
                    "type": "string",
                    "minLength": 1
                },
                "edge.arrowTail": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "binding": {
            "oneOf": [
                {
                    "type": "object",
                    "required": ["value"],
                    "properties": {
                        "value": true
                    },
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "required": ["by"],
                    "properties": {
                        "by": {
                            "$ref": "#/$defs/path"
                        },
                        "scale": {
                            "type": "string",
                            "minLength": 1
                        },
                        "palette": {
                            "type": "string",
                            "minLength": 1
                        },
                        "domain": {
                            "oneOf": [
                                {
                                    "const": "auto"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "number"
                                    },
                                    "minItems": 2,
                                    "maxItems": 2
                                }
                            ]
                        },
                        "clamp": {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 100
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "range": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            },
                            "minItems": 2,
                            "maxItems": 2
                        },
                        "map": {
                            "type": "object",
                            "additionalProperties": {
                                "type": ["string", "number"]
                            }
                        },
                        "other": {
                            "type": "object",
                            "required": ["threshold", "value"],
                            "properties": {
                                "threshold": {
                                    "type": "number"
                                },
                                "value": {
                                    "type": ["string", "number"]
                                }
                            },
                            "additionalProperties": false
                        },
                        "overflow": {
                            "type": "string",
                            "minLength": 1
                        },
                        "missing": {
                            "oneOf": [
                                {
                                    "const": "skip"
                                },
                                {
                                    "type": "object",
                                    "required": ["value"],
                                    "properties": {
                                        "value": {
                                            "type": ["string", "number"]
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            ]
                        },
                        "reverse": {
                            "type": "boolean"
                        },
                        "midpoint": {
                            "type": "number"
                        },
                        "bins": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 256
                        },
                        "exponent": {
                            "type": "number",
                            "minimum": 0.01,
                            "maximum": 100
                        }
                    },
                    "additionalProperties": false
                }
            ],
            "description": "Closed: a member no binding has is reported and kept."
        },
        "encoding": {
            "type": "object",
            "propertyNames": {
                "$ref": "#/$defs/channelName"
            },
            "additionalProperties": {
                "$ref": "#/$defs/binding"
            }
        },
        "palette": {
            "type": "object",
            "required": ["id", "plainName", "kind", "colors", "capacity", "colorblindSafe"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                },
                "plainName": {
                    "type": "string",
                    "maxLength": 1024
                },
                "kind": {
                    "enum": ["sequential", "diverging", "categorical"]
                },
                "colors": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 256,
                    "items": {
                        "type": "string",
                        "maxLength": 64
                    }
                },
                "capacity": {
                    "type": ["integer", "null"],
                    "minimum": 1
                },
                "colorblindSafe": {
                    "type": "array",
                    "items": {
                        "enum": ["deuteranopia", "protanopia", "tritanopia"]
                    }
                }
            },
            "additionalProperties": false
        },
        "layerSource": {
            "type": "object",
            "required": ["by"],
            "properties": {
                "by": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "by": {
                                "const": "run"
                            }
                        }
                    },
                    "then": {
                        "required": ["runId", "algorithm"],
                        "properties": {
                            "runId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128
                            },
                            "algorithm": {
                                "type": "string",
                                "minLength": 1
                            },
                            "params": {
                                "type": "object"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "by": {
                                "const": "template"
                            }
                        }
                    },
                    "then": {
                        "required": ["templateId"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "by": {
                                "const": "plugin"
                            }
                        }
                    },
                    "then": {
                        "required": ["name"]
                    }
                }
            ]
        },
        "knownSelectorKinds": {
            "enum": ["everything", "has", "expression", "top", "member", "rule", "state", "hover", "type", "ids"]
        },
        "commonSelector": {
            "description": "The selector kinds both style and view accept. Each known kind is closed; an unknown kind (an open vocabulary) fails its layer alone.",
            "type": "object",
            "required": ["match"],
            "properties": {
                "match": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "oneOf": [
                {
                    "properties": {
                        "match": {
                            "const": "everything"
                        }
                    },
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "has"
                        },
                        "path": {
                            "$ref": "#/$defs/path"
                        }
                    },
                    "required": ["path"],
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "expression"
                        },
                        "where": {
                            "$ref": "#/$defs/expression"
                        }
                    },
                    "required": ["where"],
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "top"
                        },
                        "path": {
                            "$ref": "#/$defs/path"
                        },
                        "n": {
                            "type": "integer",
                            "minimum": 0
                        },
                        "ties": {
                            "enum": ["fewer", "all"]
                        }
                    },
                    "required": ["path", "n"],
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "state"
                        },
                        "state": {
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "required": ["state"],
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "hover"
                        },
                        "reach": {
                            "enum": ["node", "neighbors"]
                        },
                        "invert": {
                            "type": "boolean"
                        },
                        "orSelected": {
                            "type": "boolean"
                        }
                    },
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "const": "type"
                        },
                        "types": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                                "$ref": "#/$defs/typeName"
                            }
                        }
                    },
                    "required": ["types"],
                    "unevaluatedProperties": false
                },
                {
                    "properties": {
                        "match": {
                            "$ref": "#/$defs/knownSelectorKinds"
                        }
                    },
                    "not": {
                        "properties": {
                            "match": {
                                "enum": ["everything", "has", "expression", "top", "state", "hover", "type"]
                            }
                        }
                    },
                    "description": "member, rule and ids: the calling section's schema says which it accepts and how."
                },
                {
                    "properties": {
                        "match": {
                            "not": {
                                "$ref": "#/$defs/knownSelectorKinds"
                            }
                        }
                    },
                    "description": "A selector kind a later release adds."
                }
            ]
        },
        "layerBase": {
            "type": "object",
            "description": "A style layer. It has an id and no kind. Its top level is open; its selectors, bindings and carried palettes are closed.",
            "required": ["id", "name", "selector"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[^\\u0000-\\u001f]+$"
                },
                "name": {
                    "type": "string",
                    "maxLength": 1024
                },
                "target": {
                    "enum": ["node", "edge"]
                },
                "kind": false,
                "set": {
                    "$ref": "#/$defs/staticStyle"
                },
                "encode": {
                    "$ref": "#/$defs/encoding"
                },
                "source": {
                    "$ref": "#/$defs/layerSource"
                },
                "enabled": {
                    "type": "boolean"
                },
                "userData": {
                    "type": "object"
                }
            },
            "anyOf": [
                {
                    "required": ["set"]
                },
                {
                    "required": ["encode"]
                }
            ]
        },
        "assetFile": {
            "type": "object",
            "required": ["path", "mediaType", "byteLength", "data"],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "mediaType": {
                    "type": "string"
                },
                "byteLength": {
                    "type": "integer",
                    "minimum": 0
                },
                "data": {
                    "type": "string",
                    "contentEncoding": "base64"
                }
            },
            "additionalProperties": false
        },
        "asset": {
            "type": "object",
            "description": "A model or image a section's layers draw (assets.md), carried in full in the section that needs it.",
            "required": ["id", "sha256", "format", "main"],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^asset:[A-Za-z0-9._/-]+$",
                    "not": {
                        "pattern": "^asset:sample/"
                    }
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                },
                "format": {
                    "type": "string",
                    "minLength": 1
                },
                "main": {
                    "type": "string",
                    "minLength": 1
                },
                "source": {
                    "type": "string"
                },
                "stored": {
                    "const": "url"
                },
                "plainName": {
                    "type": "string",
                    "maxLength": 256
                },
                "skipped": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "files": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/assetFile"
                    }
                }
            },
            "oneOf": [
                {
                    "required": ["stored", "source"],
                    "not": {
                        "required": ["files"]
                    }
                },
                {
                    "required": ["files"],
                    "not": {
                        "required": ["stored"]
                    }
                }
            ],
            "additionalProperties": false
        },
        "joinStep": {
            "type": "object",
            "description": "A join step: { op, source, ...choices }, naming sources by id in the join history and by role in a recipe. Closed. op is an open vocabulary: an unknown op holds the data section, or stops a recipe's replay.",
            "required": ["op", "source"],
            "properties": {
                "op": {
                    "type": "string",
                    "pattern": "^join\\.[a-z][a-z0-9-]*$"
                },
                "source": {
                    "type": "string",
                    "minLength": 1
                },
                "edges": {
                    "type": "string",
                    "minLength": 1
                },
                "via": {
                    "type": "string",
                    "minLength": 1
                },
                "clash": true,
                "repeated": true,
                "lookup": true,
                "mapping": true,
                "aggregate": true,
                "unmatchedFrom": true,
                "unmatchedRows": true,
                "compare": true,
                "membership": true,
                "names": true
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "op": {
                                "const": "join.edge-values"
                            }
                        }
                    },
                    "then": {
                        "required": ["edges"]
                    }
                }
            ],
            "unevaluatedProperties": false
        },
        "ulid": {
            "type": "string",
            "description": "A ULID: 26 Crockford base-32 characters.",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "copyId": {
            "type": "string",
            "description": "A source's copy id: sha256: plus lower-case hex of the bytes (file, url and sample sources), or a ULID minted whenever the copy changes (network, derived and reader sources, and an embedded copy holding the reader's edits).",
            "pattern": "^(sha256:[0-9a-f]{64}|[0-9A-HJKMNP-TV-Z]{26})$"
        },
        "graphFilter": {
            "type": "object",
            "description": "The shape of the recipe's graph.filter command without its op: which table a predicate keeps rows of, and the predicate.",
            "properties": {
                "on": {
                    "enum": ["nodes", "edges"],
                    "default": "nodes"
                },
                "where": {
                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/expression"
                },
                "dropIsolated": {
                    "type": "boolean"
                }
            },
            "required": ["where"],
            "unevaluatedProperties": false
        }
    }
}
