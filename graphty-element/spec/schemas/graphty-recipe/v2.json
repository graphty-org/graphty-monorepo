{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/graphty-recipe/v2.json",
    "title": "graphty recipe section, version 2",
    "description": "The replayable list of analysis steps for new data: join steps, filters, algorithm runs, rule sets and the layout. Reusable: names no element.",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/header"
        }
    ],
    "required": ["kind", "version", "generator", "commands"],
    "properties": {
        "kind": {
            "const": "graphty-recipe"
        },
        "version": {
            "const": 2
        },
        "dependencies": {
            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/reusableDependencies"
        },
        "namespace": {
            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/namespace"
        },
        "commands": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["op"],
                "properties": {
                    "op": {
                        "type": "string",
                        "minLength": 1
                    },
                    "narrows": {
                        "const": false
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "op": {
                                    "const": "graph.filter"
                                }
                            }
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "op": {
                                    "const": "graph.filter"
                                },
                                "where": {
                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/expression"
                                },
                                "on": {
                                    "enum": ["nodes", "edges"]
                                },
                                "dropIsolated": {
                                    "type": "boolean"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": ["op", "where"],
                            "unevaluatedProperties": false,
                            "allOf": [
                                {
                                    "$ref": "#/$defs/commandSlots"
                                }
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "op": {
                                    "const": "algo.run"
                                }
                            }
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "op": {
                                    "const": "algo.run"
                                },
                                "algorithm": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "as": {
                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/runName"
                                },
                                "params": {
                                    "type": "object",
                                    "description": "Every option the implementation declares with a default, at the value used (spec 9 rule 10). A reader applies its own default for an absent one."
                                },
                                "scope": {
                                    "oneOf": [
                                        {
                                            "type": "string",
                                            "minLength": 1,
                                            "not": {
                                                "enum": ["selection", "visible"]
                                            },
                                            "description": "graph, largest-component (an open vocabulary)."
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "where": {
                                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/expression"
                                                },
                                                "on": {
                                                    "enum": ["nodes", "edges"]
                                                }
                                            },
                                            "required": ["where"],
                                            "unevaluatedProperties": false,
                                            "allOf": [
                                                {
                                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/closedSlots"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "types": {
                                                    "type": "array",
                                                    "items": {
                                                        "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/typeName"
                                                    },
                                                    "minItems": 1
                                                }
                                            },
                                            "required": ["types"],
                                            "unevaluatedProperties": false,
                                            "allOf": [
                                                {
                                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/closedSlots"
                                                }
                                            ]
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "set": {
                                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/setId"
                                                }
                                            },
                                            "required": ["set"],
                                            "unevaluatedProperties": false,
                                            "allOf": [
                                                {
                                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/closedSlots"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                "seed": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 2147483647
                                },
                                "sample": {
                                    "type": "integer",
                                    "minimum": 1
                                },
                                "exact": {
                                    "type": "boolean"
                                },
                                "recordedCapSeconds": {
                                    "type": "number",
                                    "exclusiveMinimum": 0,
                                    "maximum": 3600
                                },
                                "recordedPrecision": {
                                    "enum": ["f32", "f64"]
                                },
                                "style": {
                                    "oneOf": [
                                        {
                                            "type": "boolean"
                                        },
                                        {
                                            "type": "object",
                                            "properties": {
                                                "size": {
                                                    "oneOf": [
                                                        {
                                                            "type": "boolean"
                                                        },
                                                        {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "number",
                                                                "minimum": 0
                                                            },
                                                            "minItems": 2,
                                                            "maxItems": 2
                                                        }
                                                    ]
                                                }
                                            }
                                        }
                                    ]
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": ["op", "algorithm", "as", "style"],
                            "unevaluatedProperties": false,
                            "allOf": [
                                {
                                    "$ref": "#/$defs/commandSlots"
                                }
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "op": {
                                    "const": "layout.set"
                                }
                            }
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "op": {
                                    "const": "layout.set"
                                },
                                "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "An arrangement in the layout registry, never the engine that draws it (spec 5 rule 9). A recipe says what to run, not what ran: it records no versions."
                                },
                                "dimension": {
                                    "enum": [2, 3]
                                },
                                "options": {
                                    "type": "object",
                                    "description": "The arrangement's options, by the layout registry's names: every one declared with a default, at the value used (spec 5 rule 9, 9 rule 10). A reader applies its own default for an absent one."
                                },
                                "drawnBy": {
                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/layoutDrawnBy"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": ["op", "id", "dimension"],
                            "unevaluatedProperties": false,
                            "allOf": [
                                {
                                    "$ref": "#/$defs/commandSlots"
                                }
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "op": {
                                    "const": "set.define"
                                }
                            }
                        },
                        "then": {
                            "type": "object",
                            "properties": {
                                "op": {
                                    "const": "set.define"
                                },
                                "id": {
                                    "type": "string",
                                    "pattern": "^set_[0-9A-HJKMNP-TV-Z]{26}$",
                                    "description": "The bare id, set_ plus a ULID."
                                },
                                "name": {
                                    "type": "string"
                                },
                                "where": {
                                    "oneOf": [
                                        {
                                            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/expression"
                                        },
                                        {
                                            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/reusableRuleTree"
                                        }
                                    ]
                                },
                                "reading": {
                                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/edgeReading"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": ["op", "id", "name", "where", "reading"],
                            "unevaluatedProperties": false,
                            "allOf": [
                                {
                                    "$ref": "#/$defs/commandSlots"
                                }
                            ]
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "op": {
                                    "pattern": "^join\\."
                                }
                            }
                        },
                        "then": {
                            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/joinStep"
                        }
                    }
                ],
                "description": "Dispatched on op. A known command is closed. op is an open vocabulary: an unknown op stops the replay there."
            }
        }
    },
    "$defs": {
        "commandSlots": {
            "description": "What every command may carry besides its own members: extensions and ignorable (closedSlots), and narrows, written only as false, which lets a reader that does not know the op skip the command and its readers and go on.",
            "allOf": [
                {
                    "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/closedSlots"
                }
            ],
            "properties": {
                "narrows": {
                    "const": false
                }
            }
        }
    }
}
