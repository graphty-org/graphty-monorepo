{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://graphty.app/schema/documents/graphty-settings/v1.json",
    "title": "graphty settings section, version 1",
    "description": "Project settings that belong to no other section, keyed by the dotted paths graphty-element's config.set accepts, and timeline playback. Reusable.",
    "type": "object",
    "allOf": [
        {
            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/header"
        }
    ],
    "required": ["kind", "version", "generator"],
    "properties": {
        "kind": {
            "const": "graphty-settings"
        },
        "version": {
            "const": 1
        },
        "dependencies": {
            "$ref": "https://graphty.app/schema/documents/common/v2.json#/$defs/reusableDependencies"
        },
        "settings": {
            "type": "object",
            "description": "Keyed by config.set path, written flat (layoutBehavior.preSteps). Open: a key a reader does not know is kept. No data.* key is written here.",
            "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$",
                "not": {
                    "pattern": "^data(\\.|$)"
                }
            },
            "properties": {
                "runPlacement": {
                    "type": "string",
                    "minLength": 1
                },
                "runAlgorithmsOnLoad": {
                    "type": "boolean"
                },
                "layoutTransition": {
                    "type": "object",
                    "required": ["transition"],
                    "properties": {
                        "transition": {
                            "type": "string",
                            "minLength": 1
                        },
                        "seconds": {
                            "type": "number",
                            "minimum": 0
                        }
                    }
                },
                "background": {
                    "type": "object"
                },
                "selectionStyle": {
                    "type": "object"
                },
                "pinnedStyle": {
                    "type": "object"
                },
                "viewRotation": false,
                "framing": false,
                "author": false,
                "name": false,
                "startingRows": false,
                "editableBase": false
            }
        },
        "playback": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "minLength": 1
                },
                "step": true,
                "missing": {
                    "type": "string",
                    "minLength": 1
                },
                "timeZone": {
                    "type": "string",
                    "minLength": 1
                },
                "ageFade": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "results": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
