{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true,
        "declarationMap": false,
        "sourceMap": false,
        "outDir": "./dist",
        "allowImportingTsExtensions": false,
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*.ts",
        "index.ts",
        "ai.ts",
        "catalog.ts",
        "commands.ts",
        "extend.ts",
        "format.ts",
        "react.ts",
        "schema.ts",
        "session.ts",
        "webgpu.ts"
    ],
    "exclude": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "test/**/*",
        "**/*.stories.ts",
        ".storybook/**/*",
        "src/debug/**/*",
        "coverage/**/*",
        "dist/**/*",
        "node_modules/**/*"
    ]
}
