{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "types": ["vite/client"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        // The guide's examples (docs/examples/) import the package by its published name, exactly
        // as a reader's code does; this points that name at the sources so they type-check here.
        "paths": {
            "@graphty/graphty-element/extend": ["./extend.ts"],
            "@graphty/graphty-element/logging": ["./logging.ts"]
        }
    },
    "include": ["**/*.ts", ".storybook/**/*.ts"],
    "exclude": ["tmp/**/*", "vitest.config.ts", "vite.config.ts"]
}
