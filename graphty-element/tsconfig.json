{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "experimentalDecorators": true,
        "useDefineForClassFields": false,
        "types": ["vite/client"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        // The docs' examples (docs/examples/) import the package by its published name, exactly as
        // a reader copies them; inside the package that name is its own source.
        "paths": {
            "@graphty/graphty-element/extend": ["./extend.ts"]
        }
    },
    "include": ["**/*.ts", ".storybook/**/*.ts"],
    "exclude": ["tmp/**/*", "vitest.config.ts", "vite.config.ts"]
}
