{
    // What a third party compiles against: the PUBLISHED declarations in dist/, not the sources.
    //
    // The package name is mapped onto dist/ and "types" is emptied, so nothing ambient leaks into
    // the program: the consumer files below must compile with only what the package publishes.
    //
    // skipLibCheck is on, as in a consumer's project, because Babylon.js 9's own declarations
    // (which every entry reaches, the Node-safe ones through their types) do not compile with it
    // off: on TypeScript 5 they name WebGPU types only TypeScript 6's lib.dom declares (adding
    // @webgpu/types conflicts with Babylon's augmentations of them), and on TypeScript 5 and 6
    // TAAJitterMaterialPlugin.getUniforms fails exactOptionalPropertyTypes. docs/guide/installation.md
    // says so to consumers. Until Babylon 9 they compiled: Babylon 8 declared the WebGPU types itself.

    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "skipLibCheck": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "types": [],
        // The JSX type tests are React 19 consumers.
        "jsx": "react-jsx",
        "paths": {
            "@graphty/graphty-element": ["./dist/index.d.ts"],
            "@graphty/graphty-element/*": ["./dist/*.d.ts"]
        }
    },
    // The styles-from-files guide's first example, the shader guide's examples and the node model
    // examples, compiled as a reader would compile them.
    "include": [
        "test/types/consumer/**/*.ts",
        "test/types/consumer/**/*.tsx",
        "docs/examples/file-styles/**/*.ts",
        "docs/examples/shaders/**/*.ts",
        "docs/examples/node-models/**/*.ts",
        "docs/examples/figures/**/*.ts"
    ],
    "exclude": ["node_modules", "coverage", "tmp"]
}
