{
    // What a third party compiles against: the PUBLISHED declarations in dist/, not the sources.
    //
    // The package name is mapped onto dist/ and "types" holds only @webgpu/types, so nothing else
    // ambient leaks into the program: the consumer files below must compile with only what the
    // package publishes, and the WebGPU types a consumer on TypeScript 5 needs for Babylon.js 9.
    //
    // skipLibCheck is off: it is the declarations themselves that are under test. Compile it with
    // scripts/typecheck-strict-consumer.mjs, which fails on every error but those inside Babylon.js's
    // and @webgpu/types' own declarations (Babylon 9's do not compile with skipLibCheck off; the
    // script says why).

    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "skipLibCheck": false,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "types": ["@webgpu/types"],
        // The JSX type tests are React 19 consumers.
        "jsx": "react-jsx",
        "paths": {
            "@graphty/graphty-element": ["./dist/index.d.ts"],
            "@graphty/graphty-element/*": ["./dist/*.d.ts"]
        }
    },
    // The styles-from-files guide's first example, the shader guide's examples and the node model
    // examples, compiled as a reader would compile them.
    "include": [
        "test/types/consumer/**/*.ts",
        "test/types/consumer/**/*.tsx",
        "docs/examples/file-styles/**/*.ts",
        "docs/examples/shaders/**/*.ts",
        "docs/examples/node-models/**/*.ts",
        "docs/examples/figures/**/*.ts"
    ],
    "exclude": ["node_modules", "coverage", "tmp"]
}
