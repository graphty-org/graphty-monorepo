{
    // What a third party compiles against: the PUBLISHED declarations in dist/, not the sources.
    //
    // The package name is mapped onto dist/ and "types" is emptied, so nothing ambient leaks into
    // the program. @webgpu/types is what that keeps out: if a GPUDevice, a GPUBuffer or any other
    // GPU type reached dist/webgpu.d.ts or dist/session.d.ts, the name would resolve to nothing
    // here and this compile would fail -- which is the point, because a consumer who has not
    // installed @webgpu/types would get exactly that error from their own build.
    //
    // skipLibCheck is off for the same reason: it is the declarations themselves that are under
    // test, and skipping their check is skipping the whole check.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "skipLibCheck": false,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "types": [],
        // The JSX type tests are React 19 consumers.
        "jsx": "react-jsx",
        "paths": {
            "@graphty/graphty-element": ["./dist/index.d.ts"],
            "@graphty/graphty-element/*": ["./dist/*.d.ts"]
        }
    },
    // The styles-from-files guide's first example, the shader guide's examples and the node model
    // examples, compiled as a reader would compile them.
    "include": [
        "test/types/consumer/**/*.ts",
        "test/types/consumer/**/*.tsx",
        "docs/examples/file-styles/**/*.ts",
        "docs/examples/shaders/**/*.ts",
        "docs/examples/node-models/**/*.ts"
    ],
    "exclude": ["node_modules", "coverage", "tmp"]
}
