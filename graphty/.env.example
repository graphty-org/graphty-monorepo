# Server Configuration
HOST=true
PORT=9000

# Sentry Configuration (get from sentry.io)
# See design/sentry-design.md for setup instructions
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN is only needed in CI for source map upload

# Dev server only: a remote log server (remote-logger/) that gets the page's console and load failures
VITE_REMOTE_LOG_URL=
