{
    "name": "@graphty/graphty",
    "version": "0.8.92",
    "description": "graphty, the graph visualization web app of graphty.app, as a built static site: open graph files, lay them out, run algorithms and style the result in the browser",
    "author": "Adam Powers <apowers@ato.ms>",
    "license": "MIT",
    "type": "module",
    "files": [
        "dist/",
        "!dist/**/*.map",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "dev": "vite --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "build": "tsc && NODE_OPTIONS=--max-old-space-size=8192 vite build",
        "preview": "vite preview --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "lint": "eslint --max-warnings 0 && tsc --noEmit && tsc --noEmit -p eslint-rules",
        "lint:fix": "eslint --fix",
        "lint:knip": "cd .. && ./tools/run-knip.sh --workspace graphty",
        "typecheck": "tsc --noEmit",
        "samples:write": "tsx scripts/write-sample-gml.ts",
        "storybook": "storybook dev -p ${PORT:?start it through servherd, which sets PORT} ${HOST:+--host $HOST} --no-open --https --ssl-cert ${HTTPS_CERT_PATH:?graphty Storybook needs HTTPS: set HTTPS_CERT_PATH, servherd passes httpsCert} --ssl-key ${HTTPS_KEY_PATH:?graphty Storybook needs HTTPS: set HTTPS_KEY_PATH, servherd passes httpsKey}",
        "build-storybook": "storybook build",
        "husky:prepush": "echo no prepush check",
        "ready:commit": "npm run build && npm run lint && npm run test:run"
    },
    "devDependencies": {
        "@babylonjs/core": "^8.36.1",
        "@graphty/compact-mantine": "workspace:*",
        "@graphty/graph-format": "workspace:*",
        "@graphty/graph-io": "workspace:*",
        "@graphty/graph-samples": "workspace:*",
        "@graphty/graphty-element": "workspace:*",
        "@graphty/webgpu-graph-algorithms": "workspace:*",
        "@mantine/core": "^8.1.3",
        "@mantine/hooks": "^8.1.3",
        "@mlc-ai/web-llm": "^0.2.85",
        "@sentry/cli": "^2.58.6",
        "@sentry/react": "^11.8.0",
        "@storybook/addon-docs": "^9.0.11",
        "@storybook/addon-vitest": "^9.0.11",
        "@storybook/react": "^9.0.11",
        "@storybook/react-vite": "^9.0.11",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/browser-playwright": "catalog:",
        "axe-core": "^4.13.0",
        "eslint": "^9.29.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "lit": "^3.3.1",
        "lucide-react": "^0.525.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "storybook": "^9.1.20",
        "tsx": "^4.20.3",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^7.3.7",
        "vitest": "catalog:"
    },
    "overrides": {
        "storybook": "$storybook"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "graphty"
    },
    "homepage": "https://graphty.app/",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "keywords": [
        "graph",
        "visualization",
        "react",
        "mantine",
        "graphty"
    ],
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
