{
    "name": "@graphty/graphty",
    "version": "0.8.52",
    "private": true,
    "description": "React application for graph visualization built with Mantine and graphty-element",
    "author": "Adam Powers <apowers@ato.ms>",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "build": "tsc && vite build",
        "preview": "vite preview --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "test": "vitest",
        "test:run": "vitest run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "lint": "eslint --max-warnings 0 && tsc --noEmit && tsc --noEmit -p eslint-rules",
        "lint:fix": "eslint --fix",
        "lint:knip": "cd .. && ./tools/run-knip.sh --workspace graphty",
        "typecheck": "tsc --noEmit",
        "storybook": "storybook dev -p ${PORT:?start it through servherd, which sets PORT} ${HOST:+--host $HOST} --no-open --https --ssl-cert ${HTTPS_CERT_PATH:?graphty Storybook needs HTTPS: set HTTPS_CERT_PATH, servherd passes httpsCert} --ssl-key ${HTTPS_KEY_PATH:?graphty Storybook needs HTTPS: set HTTPS_KEY_PATH, servherd passes httpsKey}",
        "build-storybook": "storybook build",
        "test:visual": "../tools/chromatic.sh graphty",
        "test:visual:debug": "../tools/chromatic.sh graphty --debug",
        "chromatic": "../tools/chromatic.sh graphty",
        "husky:prepush": "echo no prepush check",
        "ready:commit": "npm run build && npm run lint && npm run test:run"
    },
    "dependencies": {
        "@babylonjs/core": "^8.36.1",
        "@graphty/compact-mantine": "workspace:*",
        "@graphty/graphty-element": "workspace:*",
        "@graphty/webgpu-graph-algorithms": "workspace:*",
        "@mantine/core": "^8.1.3",
        "@mantine/hooks": "^8.1.3",
        "@redheadphone/react-json-grid": "^0.9.4",
        "@sentry/react": "^10.30.0",
        "lit": "^3.3.1",
        "lucide-react": "^0.525.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0"
    },
    "devDependencies": {
        "@sentry/vite-plugin": "^4.6.1",
        "@storybook/addon-docs": "^9.0.11",
        "@storybook/react": "^9.0.11",
        "@storybook/react-vite": "^9.0.11",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/browser-playwright": "catalog:",
        "axe-core": "^4.13.0",
        "eslint": "^9.29.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.16",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "jsdom": "^26.1.0",
        "storybook": "^9.1.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vite": "^7.0.0",
        "vitest": "catalog:"
    },
    "overrides": {
        "storybook": "$storybook"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "graphty"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/graphty#readme",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "keywords": [
        "graph",
        "visualization",
        "react",
        "mantine",
        "graphty"
    ],
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
