{
    "name": "@graphty/layout",
    "version": "2.2.4",
    "description": "graph layout algorithms based on networkx",
    "author": "Adam Powers <apowers@ato.ms>",
    "main": "dist/layout.js",
    "type": "module",
    "exports": {
        ".": {
            "import": "./dist/layout.js",
            "types": "./dist/layout.d.ts"
        }
    },
    "types": "dist/layout.d.ts",
    "files": [
        "dist/",
        "!dist/.storybook/",
        "!dist/vitest.config.*",
        "!dist/*.tsbuildinfo",
        "src/",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "coverage": "vitest run --coverage",
        "coverage:preview": "npx serve coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "lint": "eslint && tsc --noEmit",
        "lint:fix": "eslint --fix",
        "lint:knip": "cd .. && ./tools/run-knip.sh --workspace layout",
        "typecheck": "tsc --noEmit",
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
        "build:bundle": "node scripts/build-bundle.js",
        "build:all": "npm run build && npm run build:bundle",
        "build:gh-pages": "node scripts/build-gh-pages.js",
        "watch": "tsc --watch",
        "dev": "tsc --watch",
        "ready:commit": "npm run build && npm run lint && npm run test:run",
        "docs:api": "typedoc && node ../tools/sanitize-api-docs.js docs/api/generated",
        "docs:api:watch": "typedoc --watch",
        "docs:dev": "vitepress dev docs --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "docs:watch": "npm run docs:api && (npm run docs:api:watch & npm run docs:dev & wait)",
        "docs:build": "npm run docs:api && vitepress build docs",
        "docs:preview": "vitepress preview docs --port ${PORT:?start it through servherd, which sets PORT}",
        "storybook": "storybook dev -p ${PORT:?start it through servherd, which sets PORT} --host ${HOST:-localhost} ${HTTPS_CERT_PATH:+--https --ssl-cert $HTTPS_CERT_PATH --ssl-key $HTTPS_KEY_PATH} --no-open",
        "build-storybook": "storybook build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/graphty-org/graphty-monorepo.git",
        "directory": "layout"
    },
    "keywords": [
        "graph",
        "layout",
        "networkx",
        "network"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/graphty-org/graphty-monorepo/issues"
    },
    "homepage": "https://github.com/graphty-org/graphty-monorepo/tree/master/layout#readme",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    },
    "dependencies": {
        "@graphty/graph-format": "workspace:^"
    },
    "peerDependencies": {
        "@graphty/graph-format": "^1.0.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.0.0",
        "@graphty/graph-samples": "workspace:^",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@storybook/addon-docs": "^9.0.11",
        "@storybook/html-vite": "^9.0.11",
        "@storybook/test": "^8.6.14",
        "@types/three": "^0.182.0",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "chromatic": "^11.0.0",
        "eslint": "^9.29.0",
        "happy-dom": "^20.8.9",
        "semantic-release": "^24.2.7",
        "storybook": "^9.0.11",
        "three": "^0.182.0",
        "typedoc": "^0.28.15",
        "typedoc-plugin-markdown": "^4.9.0",
        "typedoc-vitepress-theme": "^1.1.2",
        "typescript": "^5.3.3",
        "vite": "^7.0.5",
        "vitepress": "^1.6.3",
        "vitest": "catalog:"
    }
}
