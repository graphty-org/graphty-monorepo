{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "defaultBase": "master",
    "release": {
        "projects": ["*"],
        "projectsRelationship": "independent",
        "releaseTagPattern": "{projectName}@{version}",
        "version": {
            "conventionalCommits": true,
            "adjustSemverBumpsForZeroMajorVersion": true,
            "fallbackCurrentVersionResolver": "disk",
            "updateDependents": "auto",
            "preserveLocalDependencyProtocols": true
        },
        "changelog": {
            "automaticFromRef": true,
            "projectChangelogs": {
                "createRelease": "github",
                "file": "{projectRoot}/CHANGELOG.md",
                "renderOptions": {
                    "authors": true,
                    "commitReferences": true,
                    "versionTitleDate": true
                },
                "renderer": "{workspaceRoot}/tools/changelog-renderer.cjs"
            }
        },
        "git": {
            "commit": true,
            "tag": true,
            "push": true,
            "commitMessage": "chore(release): publish {projectName} v{version} [skip ci]",
            "commitArgs": "--no-verify",
            "pushArgs": "origin refs/tags/*:refs/tags/*"
        }
    },
    "plugins": [
        {
            "plugin": "@nx/eslint/plugin",
            "options": {
                "targetName": "eslint:lint"
            }
        },
        {
            "plugin": "@nx/vite/plugin",
            "options": {
                "buildTargetName": "vite:build",
                "testTargetName": "vite:test",
                "serveTargetName": "serve",
                "devTargetName": "vite:dev",
                "previewTargetName": "vite:preview",
                "serveStaticTargetName": "serve-static",
                "typecheckTargetName": "vite:typecheck",
                "buildDepsTargetName": "build-deps",
                "watchDepsTargetName": "watch-deps"
            }
        },
        {
            "plugin": "@nx/storybook/plugin",
            "options": {
                "serveStorybookTargetName": "serve:storybook",
                "buildStorybookTargetName": "storybook:build",
                "testStorybookTargetName": "test-storybook",
                "staticStorybookTargetName": "static-storybook",
                "buildDepsTargetName": "storybook:build-deps",
                "watchDepsTargetName": "storybook:watch-deps"
            }
        }
    ],
    "pluginsConfig": {
        "@nx/js": {
            "projectsAffectedByDependencyUpdates": "auto"
        }
    },
    "parallel": 3,
    "cacheDirectory": ".nx/cache",
    "targetDefaults": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["buildSources", "^buildSources", { "runtime": "node --version" }],
            "outputs": ["{projectRoot}/dist"],
            "cache": true
        },
        "test": {
            "inputs": ["default", "^production", "{workspaceRoot}/vitest.shared.config.ts"],
            "cache": true
        },
        "build-storybook": {
            "dependsOn": ["^build"],
            "cache": true,
            "outputs": ["{projectRoot}/storybook-static"],
            "inputs": [
                "default",
                "^production",
                {
                    "input": "default",
                    "projects": [
                        "graphty-element",
                        "@graphty/remote-logger",
                        "algorithms",
                        "babylonjs-map",
                        "graph-format",
                        "graph-io",
                        "graph-samples",
                        "layout",
                        "visual-review",
                        "webgpu-graph-algorithms"
                    ]
                },
                "{workspaceRoot}/tools/storybook-brand-theme.*",
                "{workspaceRoot}/visual-review/capture/**/*",
                "{workspaceRoot}/docs/examples/**/*",
                "{workspaceRoot}/algorithms/stories/**/*",
                { "runtime": "node --version" }
            ]
        },
        "lint": {
            "inputs": [
                "default",
                "^production",
                "{workspaceRoot}/eslint.config.js",
                "{workspaceRoot}/tools/eslint-rules/**/*",
                "{workspaceRoot}/compact-mantine/eslint/**/*"
            ],
            "cache": true
        },
        "@nx/vitest:test": {
            "cache": true,
            "inputs": ["default", "^default"]
        }
    },
    "namedInputs": {
        "default": ["{projectRoot}/**/*", "sharedGlobals"],
        "production": [
            "default",
            "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
            "!{projectRoot}/tsconfig.spec.json",
            "!{projectRoot}/vitest.config.ts",
            "!{projectRoot}/eslint.config.js",
            "!{projectRoot}/**/*.md"
        ],
        "buildSources": [
            "production",
            "!{projectRoot}/test/**/*",
            "!{projectRoot}/tests/**/*",
            "!{projectRoot}/**/__tests__/**/*",
            "!{projectRoot}/stories/**/*",
            "!{projectRoot}/**/*.stories.*",
            "!{projectRoot}/benchmarks/**/*",
            "!{workspaceRoot}/eslint.config.js",
            "!{workspaceRoot}/vitest.shared.config.ts",
            "!{workspaceRoot}/vitest.browser-coverage-setup.ts",
            "{workspaceRoot}/vitest.ci-junit.d.mts"
        ],
        "sharedGlobals": [
            "{workspaceRoot}/tsconfig.base.json",
            "{workspaceRoot}/eslint.config.js",
            "{workspaceRoot}/vite.shared.config.ts",
            "{workspaceRoot}/vitest.shared.config.ts",
            "{workspaceRoot}/vitest.base.mjs",
            "{workspaceRoot}/vitest.ci-junit.mjs",
            "{workspaceRoot}/vitest.browser-coverage-setup.ts",
            "{workspaceRoot}/vitest.wait-guard-setup.ts",
            "{workspaceRoot}/tools/test-wait-guard.mjs",
            "{workspaceRoot}/vitest.map-tiles.mjs",
            "{workspaceRoot}/vitest.map-tiles-setup.ts",
            "{workspaceRoot}/pnpm-workspace.yaml",
            "{workspaceRoot}/.npmrc"
        ]
    },
    "generators": {
        "@nx/js:library": {
            "buildable": true,
            "publishable": true,
            "unitTestRunner": "vitest",
            "bundler": "vite",
            "compiler": "tsc",
            "testEnvironment": "node",
            "skipFormat": true,
            "strict": true
        }
    }
}
