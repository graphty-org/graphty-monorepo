{
    "name": "graphty-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Graphty monorepo - modular graph visualization ecosystem",
    "scripts": {
        "build": "pnpm exec nx run-many --target=build",
        "test": "pnpm exec nx run-many --target=test",
        "coverage": "pnpm -r run coverage && ./tools/merge-coverage.sh",
        "coverage:merge": "./tools/merge-coverage.sh",
        "coverage:merge:ci": "./tools/merge-coverage.sh --ci",
        "lint": "pnpm exec nx run-many --target=lint",
        "lint:knip": "knip",
        "typecheck": "pnpm exec nx run-many --target=typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepush": "NX_DAEMON=false pnpm exec nx affected -t build lint test --base=origin/master --head=HEAD --parallel=3",
        "prepush:fast": "./tools/prepush.sh",
        "prepare": "husky",
        "dev:algorithms": "pnpm --filter @graphty/algorithms run dev",
        "dev:layout": "pnpm --filter @graphty/layout run dev",
        "dev:graphty-element": "pnpm --filter @graphty/graphty-element run dev",
        "dev:graphty": "pnpm --filter @graphty/graphty run dev",
        "storybook:graphty-element": "pnpm --filter @graphty/graphty-element run storybook",
        "storybook:graphty": "pnpm --filter @graphty/graphty run storybook",
        "serve:algorithms": "pnpm --filter @graphty/algorithms run serve",
        "serve:layout": "pnpm --filter @graphty/layout run serve",
        "examples:algorithms": "pnpm --filter @graphty/algorithms run examples:html",
        "examples:layout": "pnpm --filter @graphty/layout run examples",
        "docs:api": "npm run docs:api:graphty-element && npm run docs:api:algorithms && npm run docs:api:layout && node tools/sanitize-api-docs.js",
        "docs:api:graphty-element": "cd graphty-element && typedoc --out ../docs/graphty-element/api/generated",
        "docs:api:algorithms": "cd algorithms && typedoc --out ../docs/algorithms/api/generated",
        "docs:api:layout": "cd layout && typedoc --out ../docs/layout/api/generated",
        "docs:content": "node tools/copy-docs-content.js",
        "docs:dev": "vitepress dev docs",
        "docs:watch": "npm run docs:content && npm run docs:api && vitepress dev docs",
        "docs:build": "npm run docs:content && npm run docs:api && vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "coverage:preview:algorithms": "npx serve algorithms/coverage -p 9051",
        "coverage:preview:layout": "npx serve layout/coverage -p 9052",
        "coverage:preview:graphty-element": "npx serve graphty-element/coverage -p 9053",
        "coverage:preview:graphty": "npx serve graphty/coverage -p 9054"
    },
    "engines": {
        "node": ">=18.19.0"
    },
    "packageManager": "pnpm@10.0.0",
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "pnpm": {
        "overrides": {
            "@babel/plugin-transform-modules-systemjs@>=7.12.0 <7.29.4": "^7.29.4",
            "@hono/node-server@<1.19.10": "^1.19.10",
            "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
            "@modelcontextprotocol/sdk@>=1.10.0 <1.26.0": "^1.26.0",
            "@vitest/browser@<3.2.7": "^3.2.7",
            "@vitest/browser@>=4.0.0 <4.1.10": "^4.1.10",
            "adm-zip@<0.6.0": "^0.6.0",
            "axios@>=1.0.0 <1.16.0": "^1.16.0",
            "brace-expansion@<1.1.18": "^1.1.18",
            "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
            "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
            "browserslist@<4.28.7": "^4.28.7",
            "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
            "fast-xml-parser@>=5.0.0 <5.5.6": "^5.5.6",
            "flatted@<3.4.2": "^3.4.2",
            "form-data@>=4.0.0 <4.0.6": "^4.0.6",
            "handlebars@>=4.0.0 <4.7.9": "^4.7.9",
            "happy-dom": "^20.8.9",
            "hono@<4.12.25": "^4.12.25",
            "http-proxy-middleware@>=3.0.4 <3.0.7": "^3.0.7",
            "ip-address@<10.3.1": "^10.3.1",
            "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
            "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
            "koa@>=3.0.0 <3.1.2": "^3.1.2",
            "linkify-it@<5.0.2": "^5.0.2",
            "lodash-es@>=4.0.0 <4.18.0": "^4.18.0",
            "lodash@>=4.0.0 <4.18.0": "^4.18.0",
            "minimatch@<3.1.4": "^3.1.4",
            "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
            "minimatch@>=5.0.0 <5.1.8": "^5.1.8",
            "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
            "nanoid@<3.3.18": "^3.3.18",
            "node-forge@<1.4.0": "^1.4.0",
            "nx@>=20.8.0 <22.7.7": "^22.7.7",
            "path-to-regexp@<0.1.13": "^0.1.13",
            "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
            "picomatch@<2.3.2": "^2.3.2",
            "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
            "postcss@<8.5.18": "^8.5.18",
            "preact": ">=10.28.2",
            "qs": ">=6.14.1",
            "rollup@<2.80.0": "^2.80.0",
            "rollup@>=4.0.0 <4.59.0": "^4.59.0",
            "serialize-javascript@<7.0.3": "^7.0.3",
            "smol-toml@<1.7.1": "^1.7.1",
            "storybook@>=8.1.0 <8.6.17": "^8.6.17",
            "storybook@>=8.7.0-alpha.0 <9.1.19": "^9.1.19",
            "svgo@>=1.0.0 <2.8.4": "^2.8.4",
            "svgo@>=3.0.0 <3.3.5": "^3.3.5",
            "tmp@<0.2.6": "^0.2.6",
            "undici@<6.27.0": "^6.27.0",
            "undici@>=7.0.0 <7.29.0": "^7.29.0",
            "vite@<6.4.3": "^6.4.3",
            "vite@>=7.0.0 <7.3.5": "^7.3.5",
            "vitest@<3.2.6": "^3.2.6",
            "ws@>=8.0.0 <8.21.0": "^8.21.0"
        }
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.0.0",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.29.0",
        "@nx/eslint": "22.3.3",
        "@nx/react": "^22.3.3",
        "@nx/storybook": "22.3.3",
        "@nx/vite": "22.3.3",
        "@nx/vitest": "22.3.3",
        "@nx/web": "22.3.3",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/node": "^20.19.9",
        "@vitest/browser": "^3.2.4",
        "@vitest/coverage-v8": "^3.2.4",
        "@vitest/ui": "^3.2.4",
        "chromatic": "^13.1.2",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eruda": "^3.4.3",
        "eslint": "^9.29.0",
        "eslint-plugin-jsdoc": "^50.6.17",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^15.12.0",
        "happy-dom": "^20.0.11",
        "husky": "^9.1.7",
        "jiti": "2.4.2",
        "knip": "^5.61.3",
        "lcov-result-merger": "^5.0.1",
        "nx": "22.3.3",
        "playwright": "^1.54.1",
        "prettier": "^3.4.2",
        "semantic-release": "^25.0.2",
        "storybook": "9.1.17",
        "tsx": "^4.20.3",
        "typedoc": "^0.28.15",
        "typedoc-plugin-markdown": "^4.9.0",
        "typedoc-vitepress-theme": "^1.1.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vite": "^7.0.0",
        "vitepress": "^1.6.3",
        "vitest": "^3.2.4"
    }
}
