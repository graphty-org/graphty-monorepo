{
    "name": "graphty-monorepo",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Graphty monorepo - modular graph visualization ecosystem",
    "scripts": {
        "build": "pnpm exec nx run-many --target=build",
        "test": "pnpm exec nx run-many --target=test",
        "coverage": "pnpm -r run coverage && ./tools/merge-coverage.sh",
        "coverage:merge": "./tools/merge-coverage.sh",
        "coverage:merge:ci": "./tools/merge-coverage.sh --ci",
        "lint": "pnpm exec nx run-many --target=lint",
        "lint:knip": "./tools/run-knip.sh",
        "lint:knip:prod": "./tools/run-knip.sh --production --strict --include dependencies,unlisted,unresolved",
        "check:published-deps": "node tools/check-published-deps.mjs",
        "check:bundle-size": "node tools/check-bundle-size.mjs",
        "check:api-report": "node tools/api-report.test.mjs && node tools/api-report.mjs graphty-element --check",
        "lint:eslint-root": "node tools/check-eslint-root-config.mjs",
        "check:legacy-use": "node tools/workspace-files.mjs --self-test && node tools/check-legacy-use.mjs --self-test && node tools/check-legacy-use.mjs",
        "check:declared-tools": "node tools/check-declared-build-tools.mjs --self-test && node tools/check-declared-build-tools.mjs",
        "check:data-source-migration": "node tools/check-data-source-migration.mjs --self-test && node tools/check-data-source-migration.mjs",
        "check:migration-counts": "node tools/count-migration-state.mjs --self-test",
        "check:release-hold": "node tools/release-hold.test.mjs && node tools/release-hold.mjs check",
        "test:sonar-gate": "node tools/sonar/sonar-gate.test.mjs",
        "test:ci-workflows": "node tools/ci-workflows.test.mjs",
        "typecheck": "pnpm exec nx run-many --target=typecheck",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "format:check:changed": "./tools/check-format-changed.sh",
        "prepush": "NX_DAEMON=false pnpm exec nx affected -t build lint test --base=origin/master --head=HEAD --parallel=3",
        "prepush:fast": "./tools/prepush.sh",
        "prepare": "husky",
        "dev:algorithms": "pnpm --filter @graphty/algorithms run dev",
        "dev:layout": "pnpm --filter @graphty/layout run dev",
        "dev:graphty-element": "pnpm --filter @graphty/graphty-element run dev",
        "dev:graphty": "pnpm --filter @graphty/graphty run dev",
        "dev:webgpu-graph-algorithms": "cd webgpu-graph-algorithms && pnpm exec vite demo --host --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "storybook:graphty-element": "pnpm --filter @graphty/graphty-element run storybook",
        "storybook:graphty": "pnpm --filter @graphty/graphty run storybook",
        "docs:api": "npm run docs:api:graphty-element && npm run docs:api:algorithms && npm run docs:api:layout && node tools/sanitize-api-docs.js",
        "docs:api:graphty-element": "cd graphty-element && node scripts/build-api-docs.mjs --out ../docs/graphty-element/api/generated --docsRoot ../docs",
        "docs:api:algorithms": "cd algorithms && typedoc --out ../docs/algorithms/api/generated --docsRoot ../docs",
        "docs:api:layout": "cd layout && typedoc --out ../docs/layout/api/generated --docsRoot ../docs",
        "docs:content": "node tools/copy-docs-content.js",
        "docs:dev": "vitepress dev docs --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "docs:watch": "npm run docs:content && npm run docs:api && vitepress dev docs --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "docs:build": "npm run docs:content && npm run docs:api && vitepress build docs",
        "docs:preview": "vitepress preview docs --port ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:algorithms": "npx serve algorithms/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:layout": "npx serve layout/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:graphty-element": "npx serve graphty-element/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:graphty": "npx serve graphty/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:graph-format": "npx serve graph-format/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:graph-io": "npx serve graph-io/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:webgpu-graph-algorithms": "npx serve webgpu-graph-algorithms/coverage -p ${PORT:?start it through servherd, which sets PORT}",
        "coverage:preview:graph-samples": "npx serve graph-samples/coverage -p ${PORT:?start it through servherd, which sets PORT}"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@10.34.5",
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.0.0",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.29.0",
        "@graphty/visual-review": "workspace:*",
        "@microsoft/api-extractor": "7.55.2",
        "@nx/eslint": "22.7.12",
        "@nx/react": "22.7.12",
        "@nx/storybook": "22.7.12",
        "@nx/vite": "22.7.12",
        "@nx/vitest": "22.7.12",
        "@nx/web": "22.7.12",
        "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@sonar/scan": "5.0.1",
        "@types/node": "^20.19.9",
        "@vitest/browser": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "@vitest/ui": "catalog:",
        "chromatic": "^18.9.5",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eruda": "^3.4.3",
        "eslint": "^9.29.0",
        "eslint-plugin-jsdoc": "^50.6.17",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^15.12.0",
        "happy-dom": "^20.8.9",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "knip": "^5.61.3",
        "lcov-result-merger": "^5.0.1",
        "nx": "22.7.12",
        "playwright": "^1.54.1",
        "pngjs": "^7.0.0",
        "prettier": "^3.4.2",
        "secretlint": "^13.0.6",
        "semantic-release": "^25.0.2",
        "semver": "^7.7.3",
        "storybook": "^9.1.20",
        "tsx": "^4.20.3",
        "typedoc": "^0.28.15",
        "typedoc-plugin-markdown": "^4.9.0",
        "typedoc-vitepress-theme": "^1.1.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.34.1",
        "vite": "^7.0.0",
        "vitepress": "^1.6.3",
        "vitest": "catalog:"
    },
    "pnpm": {
        "auditConfig": {
            "ignoreGhsas": [
                "GHSA-vfj7-8cjw-p6xm",
                "GHSA-86w9-cpqp-85rv"
            ]
        }
    }
}
