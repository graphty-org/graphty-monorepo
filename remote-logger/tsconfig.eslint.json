{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "composite": false,
        "noEmit": true,
        "rootDir": ".",
        "module": "ES2022",
        "paths": {
            "@graphty/remote-logger": ["./src/index.ts"],
            "@graphty/remote-logger/*": ["./src/*/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "docs/examples/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
