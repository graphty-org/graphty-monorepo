    },
    "visual-review": {
        "worktree": ".worktrees/visual-review-server-v3",
        "servers": ["visual-review-v3"],
        "test": "cd visual-review && npm run lint && npx vitest run"
    },
    "gate": {
        "worktree": ".worktrees/gate-live",
