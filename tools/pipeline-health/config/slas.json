            "sources": ["collector"],
            "alert": {
                "afterMs": 3600000,
                "priority": 0,
                "daytime": true,
                "facts": {
                    "release.since_slot_ms": [">", 25200000]
                },
                "title": "Full test runs stopped: none started for {ms:release.since_slot_ms}",
                "text": "No scheduled full test run has started for {ms:release.since_slot_ms} (one starts every 6 h), so master's newest commits have gone untested for {value}. Nothing reaches nightly or npm next until one runs. The release scheduler, which starts them, has stopped.",
                "action": "Make a new private key for the graphty-release-scheduler GitHub App at https://github.com/organizations/graphty-org/settings/apps/graphty-release-scheduler and give the .pem file to any Claude session; it installs the key in the scheduler.",
                "resolved": {
                    "title": "Full test runs are starting again",
                    "text": "A scheduled full test run has started again.",
                    "clearAfterMs": 900000
                }
            }
        },
