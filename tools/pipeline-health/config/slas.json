{
    "$comment": "SLA members of design/ci/health-dashboard.md section 4. Times in ms, shares as fractions. ok is the target (green), fail the red threshold; yellow lies between. Window: 1h, 1h+6h (red needs the 6 h value past fail too), now, slow (never sets state), info (not judged yet). alert: when and how a member pages the owner (design section 13); a member without it never pages.",
    "categories": [
        {
            "id": "master",
            "label": "Master"
        },
        {
            "id": "pull_requests",
            "label": "Pull requests"
        },
        {
            "id": "ci",
            "label": "CI"
        },
        {
            "id": "flaky",
            "label": "Flaky tests"
        },
        {
            "id": "releases",
            "label": "Releases"
        },
        {
            "id": "costs",
            "label": "Costs"
        },
        {
            "id": "data_sources",
            "label": "Data sources"
        }
    ],
    "sources": {
        "collector": {
            "label": "Collector: GitHub runs",
            "yellowAfterMs": 900000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "collector-parts": {
            "label": "Collector: GitHub pull requests, runners, issues, jobs",
            "yellowAfterMs": 900000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "ci-results": {
            "label": "CI test results and timings",
            "yellowAfterMs": 7200000,
            "activity": "source.ci_results_per_run",
            "thin": {
                "metric": "source.ci_results_per_run",
                "minActivity": 3
            }
        },
        "release": {
            "label": "Release records (from release.yml jobs)",
            "yellowAfterMs": 25200000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "npm": {
            "label": "npm publishes",
            "yellowAfterMs": 10800000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "stress": {
            "label": "Weekly stress run (from GitHub)",
            "yellowAfterMs": 691200000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "hosts": {
            "label": "Host matrix",
            "yellowAfterMs": 108000000,
            "notSetUp": "the collector's GitHub App is not installed yet (owner decision, design section 16)"
        },
        "deploy": {
            "label": "Health stack redeploy (CodeBuild, started by the collector)",
            "notSetUp": "the collector needs the GitHub App to read master's tools/pipeline-health"
        },
        "coverage": {
            "label": "Coverage published (Coveralls, master)",
            "yellowAfterMs": 86400000
        },
        "billing": {
            "label": "Billing (Cost Explorer, Cloudflare, Sentry)",
            "yellowAfterMs": 129600000
        },
        "benchmarks": {
            "label": "Benchmark results (CI's benchmark jobs)",
            "yellowAfterMs": 172800000,
            "idle": "writes when a full run's Performance Benchmarks job or the T4 lane posts its numbers"
        },
        "flaky-feed": {
            "label": "Feed of CI's flaky detections",
            "idle": "writes only when a CI shard's retry proves a test flaky (tools/test-quarantine.mjs)"
        },
        "local": {
            "label": "Local writer (test ledger, push log)",
            "idle": "the local gate retired on 2026-10-25"
        },
        "channels": {
            "label": "Release channels",
            "notSetUp": "channel not built yet, #3418"
        },
        "cloudflare-token": {
            "label": "Cloudflare read-only token",
            "notSetUp": "read-only Cloudflare token not created (owner decision, design section 16)"
        },
        "sentry-token": {
            "label": "Sentry read-only token",
            "notSetUp": "read-only Sentry token not created (owner decision, design section 16)"
        },
        "story-slices": {
            "label": "Rolling screenshot captures (results store)",
            "yellowAfterMs": 3600000,
            "notSetUp": "the results store's URL and token are not in SSM yet (owner step, design/visual-testing/early-capture.md)"
        }
    },
    "runnerLimits": {
        "linux_windows": 500,
        "macos": 50
    },
    "prBudgetsMin": {
        "pr": 20,
        "pr-wide": 35
    },
    "dailyRowLimit": 1000000,
    "members": [
        {
            "id": "master.red_now",
            "category": "master",
            "label": "Red now",
            "window": "now",
            "measure": {
                "type": "last",
                "metric": "master.red_span_ms"
            },
            "ok": ["<=", 0],
            "fail": [">=", 900000],
            "also": [
                {
                    "metric": "master.red_builds",
                    "fail": [">=", 2]
                }
            ],
            "sources": ["collector"],
            "alert": {
                "afterMs": 10800000,
                "priority": 1,
                "notWhileFailing": ["ci.runners_not_assigned"],
                "title": "Master broken for {value} and no agent has fixed it",
                "text": "Agents normally fix or revert a red master within an hour; this one has been red for {value}. Until it is fixed, canary deploys and full test runs are blocked.",
                "action": "Restart /loop 30m /pipeline-round in a Claude session in graphty-monorepo (start one if none is running).",
                "resolved": {
                    "title": "Master is green again",
                    "text": "Master was broken for about {lasted}.",
                    "clearAfterMs": 900000
                },
                "link": {
                    "url": "https://github.com/graphty-org/graphty-monorepo/actions/workflows/ci.yml?query=branch%3Amaster",
                    "title": "Open master's failing builds"
                }
            }
        },
        {
            "id": "master.green_time",
            "category": "master",
            "label": "Green time",
            "window": "1h",
            "measure": {
                "type": "share",
                "metric": "master.red_ms",
                "complement": true
            },
            "ok": [">=", 0.9166],
            "fail": ["<", 0.75],
            "sources": ["collector"],
            "headline": true
        },
        {
            "id": "master.red_same_check",
            "category": "master",
            "label": "Red on the same check",
            "window": "now",
            "measure": {
                "type": "last",
                "metric": "pr.max_failing_same_check"
            },
            "ok": ["<=", 1],
            "fail": [">=", 3],
            "sources": ["collector"]
        },
        {
            "id": "master.last_full_run",
            "category": "master",
            "label": "Last full-run verdict",
            "window": "now",
            "measure": {
                "type": "last",
                "metric": "master.full_run_failed"
            },
            "ok": ["<=", 0],
            "fail": [">=", 1],
            "sources": ["collector", "release"]
        },
        {
            "id": "master.untested_age",
            "category": "master",
            "label": "Untested master age",
            "window": "now",
            "measure": {
                "type": "last",
                "metric": "master.untested_age_ms"
            },
            "ok": ["<=", 28800000],
            "fail": [">", 46800000],
            "also": [
                {
                    "metric": "release.since_slot_ms"
                }
            ],
            "sources": ["collector"],
            "alert": {
                "afterMs": 0,
                "priority": 0,
                "daytime": true,
                "floorMs": 86400000,
                "facts": {
                    "release.since_slot_ms": [">=", 46800000]
                },
                "title": "No full test run in {ms:release.since_slot_ms}: release scheduler may be down",
                "text": "The release scheduler starts a full test run every 6 h; none has started in {ms:release.since_slot_ms}, so nightly and npm next are frozen and master has gone untested for {value}.",
                "action": "Ask any Claude session to find out why the release scheduler stopped. If its Cloudflare Worker or GitHub App credential has lapsed, make the new one the session names and give it to the session to store."
            }
        },
