<?xml version="1.0" encoding="UTF-8"?>
<!--
  The "Graphty way" SonarQube quality profile: "Sonar way" for each language listed here, minus the
  rules deactivated below. It inherits from "Sonar way", so rules SonarQube adds to "Sonar way" in
  later releases reach it automatically.

  This file is the source of truth. `node tools/sonar-baseline.mjs --setup` and the baseline loop
  (`--watch`) restore it to the server: they create the profile for each language, set its parent,
  deactivate exactly the rules listed and reactivate any other rule deactivated on the server.
  Change a rule here, in a pull request, never on the server.

  Every rule with open issues gets one decision (design/sonarqube/design.md, "Rule decisions"). A
  rule whose decision is still open is deactivated here until it has one.
-->
<graphty-way name="Graphty way" parent="Sonar way">
    <language key="ts">
        <!-- Test has no assertion (5,977 issues). The tests assert through Vitest's chai-style
             assert.* and through helpers the rule does not follow; the sampled tests all assert. -->
        <deactivate rule="typescript:S2699" />
        <!-- Optional property declared with `| undefined` (624). graph-format, graph-io,
             webgpu-graph-algorithms and graphty-element typecheck their published types under
             exactOptionalPropertyTypes, where `prop?: T | undefined` and `prop?: T` differ; the
             `| undefined` is deliberate, and "fixing" it breaks strict consumers who pass undefined. -->
        <deactivate rule="typescript:S4782" />
        <!-- Negated condition with an else (71). Decided in stage 3: almost every site is a presence
             check (`x !== null ? use(x) : fallback`) that puts the present case first on purpose. -->
        <deactivate rule="typescript:S7735" />
        <!-- for...of over an index loop (34). Decided in stage 3: most hits are index loops over typed
             arrays in the kernels, where the index loop is the deliberate hot-path form; the rest is taste. -->
        <deactivate rule="typescript:S4138" />
        <!-- Catch parameter must be named error (6). Decided in stage 3: error is used where it reads best;
             the others say what was caught (cause, passed on as { cause }; reason, state, thrown),
             and where error is taken the rule asks for error_, which says less. -->
        <deactivate rule="typescript:S7718" />
        <!-- Unnecessary spread (21). Decided in stage 3: every site is `for (const x of [...collection])`,
             a copy taken on purpose because the loop adds to or deletes from the collection it walks. -->
        <deactivate rule="typescript:S7747" />
        <!-- The void operator (14). Decided in stage 3: every site is `void promise`, the mark ESLint's
             no-floating-promises (an error here) asks for on a call deliberately not awaited. -->
        <deactivate rule="typescript:S3735" />
        <!-- Test file with no test case (17). Decided in stage 3: the files register their cases through a
             shared harness or ESLint's RuleTester, which the rule does not follow; Vitest already fails a
             file that registers no test. -->
        <deactivate rule="typescript:S2187" />
        <!-- Regular expression too complex (9). Decided in stage 3: each site is the one regex for a token of a
             format's grammar, checked against that format's specification; S5852 (backtracking) stays on. -->
        <deactivate rule="typescript:S5843" />
        <!-- Deprecated API used (8). Decided in stage 3: ESLint's no-deprecated (an error here) already reports
             each use, and every remaining one carries a disable comment with its reason. -->
        <deactivate rule="typescript:S1874" />
        <!-- Boolean parameter selects the action (5). Decided in stage 3: the callers hold the flag as a boolean,
             and two sites are graph-format exports, where a split changes the public API. -->
        <deactivate rule="typescript:S2301" />
        <!-- Functions nested more than 4 deep (5). Decided in stage 3: callbacks inside callbacks in React and
             promise code; S3776 is the rule that asks for splitting. -->
        <deactivate rule="typescript:S2004" />
        <!-- useState not named [x, setX] (6). Decided in stage 3: the raw setter is named setXState where a
             wrapper that callers must use takes the plain setX name. -->
        <deactivate rule="typescript:S6754" />
        <!-- Prop type never used (3). Decided in stage 3: the rule misses props passed whole to a helper; the
             one unused prop is deprecated public API. TypeScript reports props a caller cannot pass. -->
        <deactivate rule="typescript:S6767" />
        <!-- export {} with no names (2). Decided in stage 3: it is how TypeScript marks a file with no exports
             as a module. -->
        <deactivate rule="typescript:S7787" />
        <!-- Trivial promise (3). Decided in stage 3: every site uses the executor so a throw becomes a
             rejection; Promise.resolve(work()) would throw synchronously instead. -->
        <deactivate rule="typescript:S4634" />
    </language>
    <language key="js">
        <!-- Negated condition with an else. Off, as for TypeScript above. -->
        <deactivate rule="javascript:S7735" />
        <!-- Catch parameter must be named error. Off, as for TypeScript above. -->
        <deactivate rule="javascript:S7718" />
        <!-- Unnecessary spread. Off, as for TypeScript above. -->
        <deactivate rule="javascript:S7747" />
        <!-- Test file with no test case. Off, as for TypeScript above. -->
        <deactivate rule="javascript:S2187" />
        <!-- Regular expression too complex. Off, as for TypeScript above. -->
        <deactivate rule="javascript:S5843" />
    </language>
</graphty-way>
