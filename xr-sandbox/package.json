{
    "name": "@graphty/xr-sandbox",
    "version": "0.0.0",
    "private": true,
    "description": "A playground for trying VR control techniques on a graph on Meta Quest 3 and Samsung Galaxy XR",
    "type": "module",
    "scripts": {
        "dev": "vite --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "build": "tsc --noEmit && vite build",
        "serve": "vite build && vite preview --port ${PORT:?start it through servherd, which sets PORT} --strictPort",
        "lint": "eslint && tsc --noEmit",
        "test": "vitest run",
        "dryrun": "node dryrun/run.mjs"
    },
    "dependencies": {
        "1eurofilter": "1.3.0",
        "@babylonjs/core": "8.56.2",
        "@babylonjs/gui": "8.56.2",
        "@graphty/algorithms": "workspace:*",
        "@graphty/graph-format": "workspace:*",
        "@graphty/graph-samples": "workspace:*",
        "@graphty/layout": "workspace:*",
        "@graphty/remote-logger": "workspace:*",
        "double-metaphone": "2.0.1",
        "fastest-levenshtein": "1.0.16",
        "iwer": "^2.5.0"
    },
    "devDependencies": {
        "eslint": "^9.29.0",
        "globals": "^15.12.0",
        "playwright": "^1.54.1",
        "typescript": "^5.9.3",
        "vite": "^7.0.0",
        "vitest": "catalog:"
    }
}
